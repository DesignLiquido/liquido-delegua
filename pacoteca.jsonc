{
  "nome": "liquido",
  "descricao": "Conjunto de ferramentas para desenvolvimento de aplicações para a internet 100% em português, escrito em Delégua.",
  "versao": "0.1.0",
  "realizacoes": ["node"],
  "pontoDeEntrada": "fontes/liquido.delegua",
  "dependencias": {
    "lmht": "^0.1.0",
    "foles": "^0.1.0"
  },
  "simbolos": [
    {
      "tipo": "funcao",
      "nome": "criarAplicacao",
      "tipoRetorno": "Aplicacao",
      "argumentos": [{ "nome": "diretorioBase", "tipo": "texto" }],
      "documentacao": "Cria a aplicação do projeto, lendo configuracao.delprops."
    },
    {
      "tipo": "funcao",
      "nome": "iniciarAplicacao",
      "tipoRetorno": "lógico",
      "argumentos": [{ "nome": "aplicacao", "tipo": "Aplicacao" }],
      "documentacao": "Converte os estilos FolEs e inicia o servidor HTTP (ou simula requisições/gera documentação, conforme LIQUIDO_SIMULAR e LIQUIDO_DOCUMENTAR)."
    },
    {
      "tipo": "funcao",
      "nome": "gerarAplicacao",
      "tipoRetorno": "texto",
      "argumentos": [
        { "nome": "diretorioBase", "tipo": "texto" },
        { "nome": "linguagem", "tipo": "texto" },
        { "nome": "importacaoLiquido", "tipo": "texto" }
      ],
      "documentacao": "Gera .liquido/aplicacao.delegua a partir de rotas/ e devolve o caminho gerado."
    },
    {
      "tipo": "funcao",
      "nome": "escreverEstilos",
      "tipoRetorno": "número",
      "argumentos": [
        { "nome": "diretorioBase", "tipo": "texto" },
        { "nome": "diretorioDestino", "tipo": "texto" }
      ],
      "documentacao": "Converte estilos/*.foles em CSS no diretório de destino."
    },
    {
      "tipo": "funcao",
      "nome": "codificarJwt",
      "tipoRetorno": "texto",
      "argumentos": [
        { "nome": "conteudo", "tipo": "dicionário" },
        { "nome": "chaveSecreta", "tipo": "texto" }
      ],
      "documentacao": "Gera um JSON Web Token assinado com HS256."
    },
    {
      "tipo": "funcao",
      "nome": "decodificarJwt",
      "tipoRetorno": "dicionário",
      "argumentos": [
        { "nome": "token", "tipo": "texto" },
        { "nome": "chaveSecreta", "tipo": "texto" }
      ],
      "documentacao": "Verifica um token HS256. Devolve { valido, conteudo, erro }."
    }
  ]
}
