// Tratamento de alvos de requisição HTTP: caminho, parâmetros de pesquisa e codificação.
importar tudo como rede de "rede"
importar { dividirPrimeira } de "../utilidades/texto.delegua"

funcao decodificar(componente: texto): texto {
    se (componente == nulo) { retorna "" }
    var decodificado: texto = rede.decodificarComponenteUrl("" + componente)
    se (decodificado == nulo) { retorna "" + componente }
    retorna decodificado
}

funcao codificar(componente: texto): texto {
    se (componente == nulo) { retorna "" }
    retorna rede.codificarComponenteUrl("" + componente)
}

// Separa "/caminho?a=1#x" em { "caminho": "/caminho", "consulta": "a=1" }.
funcao separarAlvo(alvo: texto): dicionário {
    var textoAlvo: texto = "" + alvo
    var posicaoFragmento: inteiro = textoAlvo.encontrar("#")
    se (posicaoFragmento >= 0) { textoAlvo = textoAlvo.subtexto(0, posicaoFragmento) }
    var posicaoConsulta: inteiro = textoAlvo.encontrar("?")
    se (posicaoConsulta < 0) {
        retorna { "caminho": textoAlvo, "consulta": "" }
    }
    retorna {
        "caminho": textoAlvo.subtexto(0, posicaoConsulta),
        "consulta": textoAlvo.subtexto(posicaoConsulta + 1, textoAlvo.tamanho())
    }
}

// Analisa "a=1&b=dois&b=tres" em um dicionário. Chaves repetidas viram vetores, como no Express.
funcao analisarConsulta(consulta: texto): dicionário {
    var resultado: dicionário = {}
    se (consulta == nulo ou consulta == "") { retorna resultado }
    var pares: texto[] = ("" + consulta).dividir("&")
    para (var indicePar: inteiro = 0; indicePar < pares.tamanho(); indicePar = indicePar + 1) {
        var par: texto = pares[indicePar]
        se (par == "") { continua }
        var partes: texto[] = dividirPrimeira(par, "=")
        var chave: texto = decodificar(partes[0])
        var valorPar: texto = ""
        se (partes.tamanho() > 1) { valorPar = decodificar(partes[1]) }
        se (resultado.contem(chave)) {
            var existente = resultado[chave]
            var tipoExistente: texto = tipo de existente
            se (tipoExistente == "vetor") {
                var listaExistente: vetor = existente
                listaExistente.adicionar(valorPar)
            } senao {
                var lista: texto[] = ["" + existente, valorPar]
                resultado[chave] = lista
            }
        } senao {
            resultado[chave] = valorPar
        }
    }
    retorna resultado
}

// Normaliza o caminho: decodifica, remove barras repetidas e a barra final (exceto na raiz).
funcao normalizarCaminho(caminho: texto): texto {
    var segmentos: texto[] = []
    para cada segmento em ("" + caminho).dividir("/") {
        se (segmento != "") { segmentos.adicionar(segmento) }
    }
    retorna "/" + segmentos.juntar("/")
}

// Segmentos decodificados de um caminho. Recusa segmentos "." e ".." (devolve nulo).
funcao segmentosCaminho(caminho: texto): texto[] {
    var segmentos: texto[] = []
    para cada segmento em ("" + caminho).dividir("/") {
        se (segmento == "") { continua }
        var decodificado: texto = decodificar(segmento)
        se (decodificado == "." ou decodificado == ".." ou decodificado.inclui("/") ou decodificado.inclui("\\")) {
            retorna nulo
        }
        segmentos.adicionar(decodificado)
    }
    retorna segmentos
}
