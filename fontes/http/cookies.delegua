// Leitura do cabeçalho Cookie e montagem de Set-Cookie.
importar tudo como url de "./url.delegua"
importar tudo como textos de "../utilidades/texto.delegua"

funcao analisarCookies(cabecalhoCookie) {
    var resultado = {}
    se (cabecalhoCookie == nulo ou cabecalhoCookie == "") { retorna resultado }
    para cada par em ("" + cabecalhoCookie).dividir(";") {
        var partes = textos.dividirPrimeira(par.aparar(), "=")
        se (partes.tamanho() < 2 ou partes[0] == "") { continua }
        var valorCookie = partes[1].aparar()
        se (textos.comecaCom(valorCookie, "\"") e textos.terminaCom(valorCookie, "\"") e valorCookie.tamanho() >= 2) {
            valorCookie = valorCookie.subtexto(1, valorCookie.tamanho() - 1)
        }
        se (nao resultado.contem(partes[0])) {
            resultado[partes[0]] = url.decodificar(valorCookie)
        }
    }
    retorna resultado
}

// Opções aceitas (nomes em português): caminho, dominio, idadeMaxima (segundos), expira (texto HTTP-date),
// seguro, somenteHttp, mesmoSitio ("Strict", "Lax", "None").
funcao montarSetCookie(nome, valorCookie, opcoes) {
    var partes = [nome + "=" + url.codificar(valorCookie)]
    var caminho = "/"
    se (opcoes != nulo e opcoes.contem("caminho")) { caminho = opcoes["caminho"] }
    partes.adicionar("Path=" + caminho)
    se (opcoes != nulo) {
        se (opcoes.contem("dominio")) { partes.adicionar("Domain=" + opcoes["dominio"]) }
        se (opcoes.contem("idadeMaxima")) { partes.adicionar("Max-Age=" + texto(opcoes["idadeMaxima"])) }
        se (opcoes.contem("expira")) { partes.adicionar("Expires=" + opcoes["expira"]) }
        se (opcoes.contem("somenteHttp") e opcoes["somenteHttp"]) { partes.adicionar("HttpOnly") }
        se (opcoes.contem("seguro") e opcoes["seguro"]) { partes.adicionar("Secure") }
        se (opcoes.contem("mesmoSitio")) { partes.adicionar("SameSite=" + opcoes["mesmoSitio"]) }
    }
    retorna partes.juntar("; ")
}
