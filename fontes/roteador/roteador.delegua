// Roteador: registra rotas por método e caminho (com parâmetros `:nome`) e resolve requisições.
importar { normalizarCaminho, segmentosCaminho } de "../http/url.delegua"

funcao obterMetodosRota(): dicionário {
    retorna {
        "rotaGet": "GET",
        "rotaPost": "POST",
        "rotaPut": "PUT",
        "rotaDelete": "DELETE",
        "rotaPatch": "PATCH",
        "rotaCopy": "COPY",
        "rotaHead": "HEAD",
        "rotaOptions": "OPTIONS",
        "rotaPurge": "PURGE",
        "rotaLock": "LOCK",
        "rotaUnlock": "UNLOCK",
        "rotaPropfind": "PROPFIND",
        "rotaLink": "LINK",
        "rotaUnlink": "UNLINK",
        "rotaView": "VIEW"
    }
}

funcao segmentosPadrao(caminhoRota: texto): texto[] {
    var segmentos: texto[] = []
    para cada segmento em ("" + caminhoRota).dividir("/") {
        se (segmento != "") { segmentos.adicionar(segmento) }
    }
    retorna segmentos
}

// Compara os segmentos de uma rota com os de um caminho.
// Devolve { "encontrou", "parametros", "estaticos" }; `estaticos` conta segmentos fixos
// e serve para preferir `/clientes/novo` a `/clientes/:id`.
funcao corresponder(segmentosRota: texto[], segmentosRecebidos: texto[]): dicionário {
    var parametros: dicionário = {}
    se (segmentosRota.tamanho() != segmentosRecebidos.tamanho()) {
        retorna { "encontrou": falso, "parametros": parametros, "estaticos": 0 }
    }
    var estaticos: inteiro = 0
    para (var i: inteiro = 0; i < segmentosRota.tamanho(); i = i + 1) {
        var esperado: texto = segmentosRota[i]
        var recebido: texto = segmentosRecebidos[i]
        se (esperado.tamanho() > 1 e esperado[0] == ":") {
            parametros[esperado.subtexto(1, esperado.tamanho())] = recebido
        } senao {
            se (esperado != recebido) {
                retorna { "encontrou": falso, "parametros": parametros, "estaticos": 0 }
            }
            estaticos = estaticos + 1
        }
    }
    retorna { "encontrou": verdadeiro, "parametros": parametros, "estaticos": estaticos }
}

classe Roteador {
    rotas: vetor

    construtor() {
        isto.rotas = []
    }

    // `funcoes`: middlewares seguidos do tratador final.
    // Devolve falso (e não registra) se o método já existe para o caminho.
    registrar(metodo: texto, caminho: texto, funcoes: vetor, arquivo: texto): lógico {
        var metodoNormalizado: texto = ("" + metodo).maiusculo()
        var caminhoNormalizado: texto = normalizarCaminho(caminho)
        para (var i: inteiro = 0; i < isto.rotas.tamanho(); i = i + 1) {
            var existente: dicionário = isto.rotas[i]
            se (existente["metodo"] == metodoNormalizado e existente["caminho"] == caminhoNormalizado) {
                retorna falso
            }
        }
        var segmentos: texto[] = segmentosPadrao(caminhoNormalizado)
        var rota: dicionário = {
            "metodo": metodoNormalizado,
            "caminho": caminhoNormalizado,
            "segmentos": segmentos,
            "funcoes": funcoes,
            "arquivo": arquivo
        }
        isto.rotas.adicionar(rota)
        retorna verdadeiro
    }

    // Resolve uma requisição. `situacao`: "encontrada", "metodoNaoPermitido", "naoEncontrada" ou "caminhoInvalido".
    resolver(metodo: texto, caminho: texto): dicionário {
        var metodoNormalizado: texto = ("" + metodo).maiusculo()
        var segCaminho: texto[] = segmentosCaminho(caminho)
        var semParametros: dicionário = {}
        var metodosVazios: texto[] = []
        se (segCaminho == nulo) {
            retorna { "situacao": "caminhoInvalido", "rota": nulo, "parametros": semParametros, "metodos": metodosVazios }
        }

        var melhor: dicionário = nulo
        var melhorParametros: dicionário = {}
        var melhorEstaticos: inteiro = -1
        var melhorGet: dicionário = nulo
        var melhorGetParametros: dicionário = {}
        var melhorGetEstaticos: inteiro = -1
        var metodosCaminho: texto[] = []

        para (var i: inteiro = 0; i < isto.rotas.tamanho(); i = i + 1) {
            var rota: dicionário = isto.rotas[i]
            var segmentosRota: texto[] = rota["segmentos"]
            var correspondencia: dicionário = corresponder(segmentosRota, segCaminho)
            se (nao correspondencia["encontrou"]) { continua }
            var metodoRota: texto = rota["metodo"]
            se (nao metodosCaminho.inclui(metodoRota)) { metodosCaminho.adicionar(metodoRota) }
            var estaticos: inteiro = correspondencia["estaticos"]
            se (metodoRota == metodoNormalizado e estaticos > melhorEstaticos) {
                melhor = rota
                melhorParametros = correspondencia["parametros"]
                melhorEstaticos = estaticos
            }
            se (metodoRota == "GET" e estaticos > melhorGetEstaticos) {
                melhorGet = rota
                melhorGetParametros = correspondencia["parametros"]
                melhorGetEstaticos = estaticos
            }
        }

        // HEAD usa a rota GET quando não há rota HEAD própria, como no Express.
        se (melhor == nulo e metodoNormalizado == "HEAD" e melhorGet != nulo) {
            melhor = melhorGet
            melhorParametros = melhorGetParametros
        }

        se (melhor != nulo) {
            retorna { "situacao": "encontrada", "rota": melhor, "parametros": melhorParametros, "metodos": metodosCaminho }
        }
        se (metodosCaminho.tamanho() > 0) {
            se (metodosCaminho.inclui("GET") e nao metodosCaminho.inclui("HEAD")) { metodosCaminho.adicionar("HEAD") }
            retorna { "situacao": "metodoNaoPermitido", "rota": nulo, "parametros": semParametros, "metodos": metodosCaminho }
        }
        retorna { "situacao": "naoEncontrada", "rota": nulo, "parametros": semParametros, "metodos": metodosVazios }
    }
}

funcao criarRoteador(): Roteador {
    retorna Roteador()
}

funcao metodoDeRegistro(nomeMetodoRota: texto): texto {
    var metodosRota: dicionário = obterMetodosRota()
    se (metodosRota.contem(nomeMetodoRota)) {
        var metodo: texto = metodosRota[nomeMetodoRota]
        retorna metodo
    }
    retorna ""
}
