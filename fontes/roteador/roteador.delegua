// Roteador: registra rotas por método e caminho (com parâmetros `:nome`) e resolve requisições.
importar tudo como url de "../http/url.delegua"

var metodosRota = {
    "rotaGet": "GET",
    "rotaPost": "POST",
    "rotaPut": "PUT",
    "rotaDelete": "DELETE",
    "rotaPatch": "PATCH",
    "rotaCopy": "COPY",
    "rotaHead": "HEAD",
    "rotaOptions": "OPTIONS",
    "rotaPurge": "PURGE",
    "rotaLock": "LOCK",
    "rotaUnlock": "UNLOCK",
    "rotaPropfind": "PROPFIND",
    "rotaLink": "LINK",
    "rotaUnlink": "UNLINK",
    "rotaView": "VIEW"
}

funcao segmentosPadrao(caminhoRota) {
    var segmentos = []
    para cada segmento em ("" + caminhoRota).dividir("/") {
        se (segmento != "") { segmentos.adicionar(segmento) }
    }
    retorna segmentos
}

// Compara os segmentos de uma rota com os de um caminho.
// Devolve { "encontrou", "parametros", "estaticos" }; `estaticos` conta segmentos fixos
// e serve para preferir `/clientes/novo` a `/clientes/:id`.
funcao corresponder(segmentosRota, segmentosCaminho) {
    var parametros = {}
    se (segmentosRota.tamanho() != segmentosCaminho.tamanho()) {
        retorna { "encontrou": falso, "parametros": parametros, "estaticos": 0 }
    }
    var estaticos = 0
    para (var i = 0; i < segmentosRota.tamanho(); i = i + 1) {
        var esperado = segmentosRota[i]
        var recebido = segmentosCaminho[i]
        se (esperado.tamanho() > 1 e esperado[0] == ":") {
            parametros[esperado.subtexto(1, esperado.tamanho())] = recebido
        } senao {
            se (esperado != recebido) {
                retorna { "encontrou": falso, "parametros": parametros, "estaticos": 0 }
            }
            estaticos = estaticos + 1
        }
    }
    retorna { "encontrou": verdadeiro, "parametros": parametros, "estaticos": estaticos }
}

classe Roteador {
    rotas: vetor

    construtor() {
        isto.rotas = []
    }

    // `funcoes`: middlewares seguidos do tratador final.
    // Devolve falso (e não registra) se o método já existe para o caminho.
    registrar(metodo, caminho, funcoes, arquivo) {
        var metodoNormalizado = ("" + metodo).maiusculo()
        var caminhoNormalizado = url.normalizarCaminho(caminho)
        para cada existente em isto.rotas {
            se (existente["metodo"] == metodoNormalizado e existente["caminho"] == caminhoNormalizado) {
                retorna falso
            }
        }
        var segmentos = segmentosPadrao(caminhoNormalizado)
        var rota = {
            "metodo": metodoNormalizado,
            "caminho": caminhoNormalizado,
            "segmentos": segmentos,
            "funcoes": funcoes,
            "arquivo": arquivo
        }
        isto.rotas.adicionar(rota)
        retorna verdadeiro
    }

    // Resolve uma requisição. `situacao`: "encontrada", "metodoNaoPermitido", "naoEncontrada" ou "caminhoInvalido".
    resolver(metodo, caminho) {
        var metodoNormalizado = ("" + metodo).maiusculo()
        var segmentosCaminho = url.segmentosCaminho(caminho)
        var semParametros = {}
        var metodosVazios = []
        se (segmentosCaminho == nulo) {
            retorna { "situacao": "caminhoInvalido", "rota": nulo, "parametros": semParametros, "metodos": metodosVazios }
        }

        var melhor = nulo
        var melhorParametros = {}
        var melhorEstaticos = -1
        var melhorGet = nulo
        var melhorGetParametros = {}
        var melhorGetEstaticos = -1
        var metodosCaminho = []

        para cada rota em isto.rotas {
            var correspondencia: dicionário = corresponder(rota["segmentos"], segmentosCaminho)
            se (nao correspondencia["encontrou"]) { continua }
            se (nao metodosCaminho.inclui(rota["metodo"])) { metodosCaminho.adicionar(rota["metodo"]) }
            var estaticos = correspondencia["estaticos"]
            se (rota["metodo"] == metodoNormalizado e estaticos > melhorEstaticos) {
                melhor = rota
                melhorParametros = correspondencia["parametros"]
                melhorEstaticos = estaticos
            }
            se (rota["metodo"] == "GET" e estaticos > melhorGetEstaticos) {
                melhorGet = rota
                melhorGetParametros = correspondencia["parametros"]
                melhorGetEstaticos = estaticos
            }
        }

        // HEAD usa a rota GET quando não há rota HEAD própria, como no Express.
        se (melhor == nulo e metodoNormalizado == "HEAD" e melhorGet != nulo) {
            melhor = melhorGet
            melhorParametros = melhorGetParametros
        }

        se (melhor != nulo) {
            retorna { "situacao": "encontrada", "rota": melhor, "parametros": melhorParametros, "metodos": metodosCaminho }
        }
        se (metodosCaminho.tamanho() > 0) {
            se (metodosCaminho.inclui("GET") e nao metodosCaminho.inclui("HEAD")) { metodosCaminho.adicionar("HEAD") }
            retorna { "situacao": "metodoNaoPermitido", "rota": nulo, "parametros": semParametros, "metodos": metodosCaminho }
        }
        retorna { "situacao": "naoEncontrada", "rota": nulo, "parametros": semParametros, "metodos": metodosVazios }
    }
}

funcao criarRoteador() {
    retorna Roteador()
}

funcao metodoDeRegistro(nomeMetodoRota) {
    se (metodosRota.contem(nomeMetodoRota)) { retorna metodosRota[nomeMetodoRota] }
    retorna nulo
}
