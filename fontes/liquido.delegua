// Ponto de entrada do pacote Pacoteca `liquido`.
//
// Uso típico: o comando `liquido` (fontes/ilc.delegua) gera `.liquido/aplicacao.delegua`
// a partir de `rotas/` e o executa. O programa gerado usa as funções abaixo.
importar tudo como arquivos de "arquivos"
importar tudo como processo de "processo"
importar tudo como nucleo de "./nucleo/aplicacao.delegua"
importar tudo como documentacaoOpenApi de "./documentacao/open_api.delegua"
importar tudo como gerador de "./gerador/gerador_aplicacao.delegua"
importar tudo como estilos de "./estilos/estilos.delegua"
importar tudo como jwtLiquido de "./autenticacao/jwt.delegua"
importar tudo como jsonLiquido de "./utilidades/json.delegua"

// Cria a aplicação para o diretório do projeto, lendo `configuracao.delprops`.
funcao criarAplicacao(diretorioBase) {
    retorna nucleo.criarAplicacao(diretorioBase)
}

// Atende as requisições descritas em um arquivo JSON, sem abrir porta, e escreve cada
// resposta como uma linha JSON { "status", "cabecalhos", "corpo" }.
// Formato do arquivo: [{ "metodo": "GET", "alvo": "/", "cabecalhos": {..}, "corpo": "" }, ..].
funcao simularRequisicoes(aplicacao, caminhoArquivo) {
    var conteudo = arquivos.lerTexto(caminhoArquivo)
    se (conteudo == nulo) {
        escreva("[Liquido] Não foi possível ler " + caminhoArquivo + ".")
        retorna falso
    }
    var analisado = jsonLiquido.analisar(conteudo)
    se (analisado["erro"] != "" ou nao jsonLiquido.ehVetor(analisado["resultado"])) {
        escreva("[Liquido] Arquivo de simulação inválido: esperado um vetor de requisições.")
        retorna falso
    }
    para cada entrada em analisado["resultado"] {
        var cabecalhos = {}
        se (entrada.contem("cabecalhos")) {
            var cabecalhosEntrada = entrada["cabecalhos"]
            para cada nome em cabecalhosEntrada.chaves() {
                cabecalhos[nome.minusculo()] = "" + cabecalhosEntrada[nome]
            }
        }
        var metodo = "GET"
        se (entrada.contem("metodo")) { metodo = ("" + entrada["metodo"]).maiusculo() }
        var alvo = "/"
        se (entrada.contem("alvo")) { alvo = entrada["alvo"] }
        var corpo = ""
        se (entrada.contem("corpo")) {
            var corpoEntrada = entrada["corpo"]
            var tipoCorpo = tipo de corpoEntrada
            se (tipoCorpo == "texto") { corpo = corpoEntrada } senao { corpo = jsonLiquido.serializar(corpoEntrada) }
        }
        var dados = { "metodo": metodo, "alvo": alvo, "versao": "HTTP/1.1", "cabecalhos": cabecalhos, "corpo": corpo }
        var respostaHttp = aplicacao.processar(dados)
        var saida = { "status": respostaHttp["status"], "cabecalhos": respostaHttp["cabecalhos"], "corpo": respostaHttp["corpo"] }
        escreva(jsonLiquido.serializar(saida))
    }
    retorna verdadeiro
}

// Prepara a aplicação (estilos FolEs) e inicia o servidor HTTP.
// Com a variável de ambiente LIQUIDO_SIMULAR (caminho de um arquivo JSON), apenas simula
// requisições; com LIQUIDO_DOCUMENTAR (caminho de saída), apenas grava o documento OpenAPI.
funcao iniciarAplicacao(aplicacao) {
    var arquivoDocumentacao = processo.variavelAmbiente("LIQUIDO_DOCUMENTAR")
    se (arquivoDocumentacao != nulo e arquivoDocumentacao != "") {
        var documento = documentacaoOpenApi.documentar(aplicacao)
        se (arquivos.escreverTexto(arquivoDocumentacao, jsonLiquido.serializar(documento))) {
            escreva("Documentação OpenAPI gravada em " + arquivoDocumentacao)
            retorna verdadeiro
        }
        escreva("[Liquido] Não foi possível gravar " + arquivoDocumentacao + ".")
        retorna falso
    }
    var arquivoSimulacao = processo.variavelAmbiente("LIQUIDO_SIMULAR")
    se (arquivoSimulacao != nulo e arquivoSimulacao != "") {
        retorna simularRequisicoes(aplicacao, arquivoSimulacao)
    }

    var liquido = aplicacao.configuracao["liquido"]
    se (liquido["arquetipo"] != "rest") {
        var resultado = estilos.escreverEstilos(aplicacao.diretorioBase, liquido["estilos"]["diretorioBase"])
        para cada erro em resultado["erros"] { escreva("[Liquido] " + erro) }
        para cada escrito em resultado["escritos"] { escreva("Salvo: " + escrito) }
    }
    se (liquido["dados"]["lincones"]["tecnologia"] != nulo) {
        escreva("[Liquido] Bancos de dados LinConEs ainda não são suportados pelo Líquido em Delégua; a configuração liquido.dados foi ignorada.")
    }
    retorna aplicacao.iniciar()
}

// Gera `.liquido/aplicacao.delegua` para o projeto. Devolve o caminho gerado, ou "" em caso de erro.
funcao gerarAplicacao(diretorioBase, linguagem, importacaoLiquido) {
    var resultado = gerador.gerarArquivo(diretorioBase, linguagem, importacaoLiquido)
    para cada aviso em resultado["avisos"] { escreva("[Liquido] " + aviso) }
    para cada erro em resultado["erros"] { escreva("[Liquido] " + erro) }
    retorna resultado["caminho"]
}

// Converte `estilos/*.foles` em CSS. Devolve a quantidade de arquivos escritos.
funcao escreverEstilos(diretorioBase, diretorioDestino) {
    var resultado = estilos.escreverEstilos(diretorioBase, diretorioDestino)
    para cada erro em resultado["erros"] { escreva("[Liquido] " + erro) }
    retorna resultado["escritos"].tamanho()
}

// Utilidades expostas às rotas.
funcao codificarJwt(conteudo, chaveSecreta) {
    retorna jwtLiquido.codificar(conteudo, chaveSecreta)
}

funcao decodificarJwt(token, chaveSecreta) {
    retorna jwtLiquido.decodificar(token, chaveSecreta)
}

funcao paraJson(valor) {
    retorna jsonLiquido.serializar(valor)
}

funcao deJson(textoJson) {
    retorna jsonLiquido.analisar(textoJson)
}
