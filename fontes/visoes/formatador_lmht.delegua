// Formatação de visões LMHT: resolve a visão da rota, aplica o leiaute (`base.lmht`),
// as parciais (`<parcial nome="..."/>`), o modelo com os valores da resposta,
// converte `<estilo>` de FolEs para CSS e, por fim, traduz LMHT para HTML.
importar tudo como arquivos de "arquivos"
importar tudo como lmht de "lmht"
importar tudo como foles de "foles"
importar tudo como textos de "../utilidades/texto.delegua"
importar tudo como modelos de "./modelos.delegua"

var nomeArquivoLeiaute = "base.lmht"

// Remove os segmentos `:parametro` do caminho da rota. "/clientes/:id/notas" -> "clientes/notas".
funcao caminhoSemParametros(caminhoRota) {
    var segmentos = []
    para cada segmento em ("" + caminhoRota).dividir("/") {
        se (segmento == "" ou segmento[0] == ":") { continua }
        segmentos.adicionar(segmento)
    }
    retorna segmentos.juntar("/")
}

funcao ultimaParteEhParametro(caminhoRota) {
    var segmentos = []
    para cada segmento em ("" + caminhoRota).dividir("/") {
        se (segmento != "") { segmentos.adicionar(segmento) }
    }
    se (segmentos.tamanho() == 0) { retorna falso }
    var ultimo = segmentos[segmentos.tamanho() - 1]
    retorna ultimo[0] == ":"
}

// Resolve o arquivo de visão para o caminho da rota, como no Líquido original:
// `/x` -> `visoes/x.lmht` ou `visoes/x/inicial.lmht`; `/x/:id` -> `visoes/x/detalhes.lmht`.
// Devolve { "visao": caminho ou nulo, "tentados": [..] }.
funcao resolverVisao(diretorioBase, caminhoRota) {
    var diretorioVisoes = arquivos.juntarCaminhos(diretorioBase, "visoes")
    var semParametros = caminhoSemParametros(caminhoRota)
    var diretorioOuArquivo = diretorioVisoes
    se (semParametros != "") { diretorioOuArquivo = arquivos.juntarCaminhos(diretorioVisoes, semParametros) }
    var tentados = []

    var visao = ""
    se (ultimaParteEhParametro(caminhoRota)) {
        visao = arquivos.juntarCaminhos(diretorioOuArquivo, "detalhes.lmht")
    } senao se (semParametros == "") {
        visao = arquivos.juntarCaminhos(diretorioVisoes, "inicial.lmht")
    } senao {
        visao = diretorioOuArquivo + ".lmht"
    }
    tentados.adicionar(visao)

    se (arquivos.eArquivo(visao)) {
        retorna { "visao": visao, "tentados": tentados }
    }
    var inicial = arquivos.juntarCaminhos(diretorioOuArquivo, "inicial.lmht")
    se (nao tentados.inclui(inicial)) { tentados.adicionar(inicial) }
    se (arquivos.eArquivo(inicial)) {
        retorna { "visao": inicial, "tentados": tentados }
    }
    retorna { "visao": nulo, "tentados": tentados }
}

// Procura `base.lmht` no diretório da visão e nos diretórios acima, até `visoes/`.
funcao resolverLeiaute(diretorioBase, caminhoVisao) {
    var diretorioVisoes = arquivos.caminhoAbsoluto(arquivos.juntarCaminhos(diretorioBase, "visoes"))
    var visaoAbsoluta = arquivos.caminhoAbsoluto(caminhoVisao)
    var diretorioAtual = arquivos.diretorioPai(visaoAbsoluta)
    var limite = 64
    enquanto (limite > 0 e textos.comecaCom(diretorioAtual, diretorioVisoes)) {
        limite = limite - 1
        var candidato = arquivos.juntarCaminhos(diretorioAtual, nomeArquivoLeiaute)
        se (candidato != visaoAbsoluta e arquivos.eArquivo(candidato)) {
            retorna candidato
        }
        se (diretorioAtual == diretorioVisoes) { sustar }
        diretorioAtual = arquivos.diretorioPai(diretorioAtual)
    }
    retorna nulo
}

// Conteúdo interno da primeira marcação `<nome>...</nome>`, aceitando atributos na abertura.
// Devolve { "encontrado", "inicio", "fim", "interno" } (inicio/fim delimitam a marcação inteira).
funcao localizarMarcacao(conteudo, nome) {
    var textoConteudo = "" + conteudo
    var procurar = 0
    enquanto (procurar < textoConteudo.tamanho()) {
        var abertura = textos.encontrarAPartir(textoConteudo, "<" + nome, procurar)
        se (abertura < 0) { sustar }
        var depoisNome = abertura + nome.tamanho() + 1
        se (depoisNome >= textoConteudo.tamanho()) { sustar }
        var seguinte = textoConteudo[depoisNome]
        se (seguinte == ">" ou textos.ehEspaco(seguinte)) {
            var fimAbertura = textos.encontrarAPartir(textoConteudo, ">", depoisNome)
            se (fimAbertura < 0) { sustar }
            var fechamento = textos.encontrarAPartir(textoConteudo, "</" + nome + ">", fimAbertura + 1)
            se (fechamento < 0) { sustar }
            retorna {
                "encontrado": verdadeiro,
                "inicio": abertura,
                "fim": fechamento + nome.tamanho() + 3,
                "inicioInterno": fimAbertura + 1,
                "fimInterno": fechamento,
                "interno": textoConteudo.subtexto(fimAbertura + 1, fechamento)
            }
        }
        procurar = depoisNome
    }
    retorna { "encontrado": falso, "inicio": -1, "fim": -1, "inicioInterno": -1, "fimInterno": -1, "interno": "" }
}

funcao localizarCabeca(conteudo) {
    var cabeca: dicionário = localizarMarcacao(conteudo, "cabeca")
    se (cabeca["encontrado"]) { retorna cabeca }
    retorna localizarMarcacao(conteudo, "cabeça")
}

// Posição e tamanho do marcador `<conteudo/>` (aceita espaços antes de `/>`), ou inicio -1.
funcao localizarMarcadorConteudo(conteudo) {
    var procurar = 0
    enquanto (procurar < conteudo.tamanho()) {
        var abertura = textos.encontrarAPartir(conteudo, "<conteudo", procurar)
        se (abertura < 0) { sustar }
        var posicao = abertura + 9
        enquanto (posicao < conteudo.tamanho() e textos.ehEspaco(conteudo[posicao])) { posicao = posicao + 1 }
        se (conteudo.subtexto(posicao, posicao + 2) == "/>") {
            retorna { "inicio": abertura, "fim": posicao + 2 }
        }
        procurar = abertura + 9
    }
    retorna { "inicio": -1, "fim": -1 }
}

// Insere o corpo da página no `<conteudo/>` do leiaute e acrescenta a cabeça da página à do leiaute.
// Devolve { "resultado", "erro" }.
funcao comporComLeiaute(textoLeiaute, textoPagina, caminhoLeiaute) {
    var marcador: dicionário = localizarMarcadorConteudo(textoLeiaute)
    se (marcador["inicio"] < 0) {
        retorna {
            "resultado": "",
            "erro": "O arquivo de leiaute '" + caminhoLeiaute + "' não contém o marcador '<conteudo/>' onde o conteúdo da visão deveria ser inserido."
        }
    }
    var corpoPagina: dicionário = localizarMarcacao(textoPagina, "corpo")
    var internoCorpo = corpoPagina["interno"]
    var composto = textoLeiaute.subtexto(0, marcador["inicio"]) + internoCorpo + textoLeiaute.subtexto(marcador["fim"], textoLeiaute.tamanho())

    var cabecaPagina: dicionário = localizarCabeca(textoPagina)
    se (cabecaPagina["encontrado"] e cabecaPagina["interno"].aparar() != "") {
        var cabecaLeiaute: dicionário = localizarCabeca(composto)
        se (cabecaLeiaute["encontrado"]) {
            composto = composto.subtexto(0, cabecaLeiaute["fimInterno"]) + cabecaPagina["interno"] + composto.subtexto(cabecaLeiaute["fimInterno"], composto.tamanho())
        } senao {
            var posicaoLmht = composto.encontrar("<lmht>")
            se (posicaoLmht >= 0) {
                composto = composto.subtexto(0, posicaoLmht + 6) + "<cabeca>" + cabecaPagina["interno"] + "</cabeca>" + composto.subtexto(posicaoLmht + 6, composto.tamanho())
            }
        }
    }
    retorna { "resultado": composto, "erro": "" }
}

// Substitui `<parcial nome="x"/>` (ou `<parcial nome="x"></parcial>`) pelo conteúdo de `visoes/parciais/x.lmht`.
funcao aplicarParciais(diretorioBase, conteudo) {
    var resultado = ""
    var restante = "" + conteudo
    var diretorioParciais = arquivos.juntarCaminhos(arquivos.juntarCaminhos(diretorioBase, "visoes"), "parciais")
    var limite = 1000
    enquanto (limite > 0) {
        limite = limite - 1
        var abertura = restante.encontrar("<parcial")
        se (abertura < 0) { sustar }
        var fimAbertura = textos.encontrarAPartir(restante, ">", abertura)
        se (fimAbertura < 0) {
            retorna { "resultado": "", "erro": "Estrutura parcial não terminada." }
        }
        var marcacao = restante.subtexto(abertura, fimAbertura + 1)
        var fimTotal = fimAbertura + 1
        se (nao textos.terminaCom(marcacao, "/>")) {
            var fechamento = textos.encontrarAPartir(restante, "</parcial>", fimAbertura)
            se (fechamento < 0) {
                retorna { "resultado": "", "erro": "Estrutura parcial sem fechamento." }
            }
            fimTotal = fechamento + 10
        }
        var posicaoNome = marcacao.encontrar("nome=\"")
        se (posicaoNome < 0) {
            retorna { "resultado": "", "erro": "Na estrutura parcial, o atributo 'nome' não foi informado." }
        }
        var fimNome = textos.encontrarAPartir(marcacao, "\"", posicaoNome + 6)
        var nome = marcacao.subtexto(posicaoNome + 6, fimNome)
        se (nao arquivos.eDiretorio(diretorioParciais)) {
            retorna { "resultado": "", "erro": "O diretório 'visoes/parciais' não foi encontrado." }
        }
        var conteudoParcial = arquivos.lerTexto(arquivos.juntarCaminhos(diretorioParciais, nome + ".lmht"))
        se (conteudoParcial == nulo) {
            retorna { "resultado": "", "erro": "O arquivo '" + nome + ".lmht' não foi encontrado." }
        }
        resultado = resultado + restante.subtexto(0, abertura) + conteudoParcial
        restante = restante.subtexto(fimTotal, restante.tamanho())
    }
    retorna { "resultado": resultado + restante, "erro": "" }
}

// Converte o conteúdo de cada `<estilo>` de FolEs para CSS, trocando a estrutura por `<style>`,
// como no Líquido original (o tradutor LMHT mantém `<estilo>` como está dentro de `<cabeca>`).
funcao aplicar_folEs(conteudo) {
    var resultado = ""
    var restante = "" + conteudo
    var limite = 1000
    enquanto (limite > 0) {
        limite = limite - 1
        var estilo: dicionário = localizarMarcacao(restante, "estilo")
        se (nao estilo["encontrado"]) { sustar }
        var css = ""
        tente {
            css = foles.converter_texto_para_css(estilo["interno"])
        } pegue (erro) {
            escreva("[Liquido] Erro ao processar estilo no LMHT: " + erro.mensagem + ". O estilo será ignorado, mas a página continuará sendo renderizada.")
        }
        resultado = resultado + restante.subtexto(0, estilo["inicio"]) + "<style>\n" + css + "\n</style>"
        restante = restante.subtexto(estilo["fim"], restante.tamanho())
    }
    retorna resultado + restante
}

// Formata a visão da rota. Devolve { "resultado": html, "erro": "" }.
funcao formatar(diretorioBase, caminhoRota, valores) {
    var resolucao: dicionário = resolverVisao(diretorioBase, caminhoRota)
    se (resolucao["visao"] == nulo) {
        retorna {
            "resultado": "",
            "erro": "Visão correspondente à rota " + caminhoRota + " não existe. Caminhos tentados: " + resolucao["tentados"].juntar("; ") + "; "
        }
    }
    var textoBase = arquivos.lerTexto(resolucao["visao"])
    se (textoBase == nulo) {
        retorna { "resultado": "", "erro": "Não foi possível ler a visão " + resolucao["visao"] + "." }
    }
    textoBase = textos.substituirTodos(textoBase, "\r\n", "\n")

    var caminhoLeiaute = resolverLeiaute(diretorioBase, resolucao["visao"])
    se (caminhoLeiaute != nulo) {
        var textoLeiaute = arquivos.lerTexto(caminhoLeiaute)
        var composicao: dicionário = comporComLeiaute(textos.substituirTodos(textoLeiaute, "\r\n", "\n"), textoBase, caminhoLeiaute)
        se (composicao["erro"] != "") { retorna composicao }
        textoBase = composicao["resultado"]
    }

    var parciais: dicionário = aplicarParciais(diretorioBase, textoBase)
    se (parciais["erro"] != "") { retorna parciais }
    textoBase = parciais["resultado"]

    var renderizado = modelos.renderizar(textoBase, valores)
    se (renderizado["erro"] != "") {
        retorna { "resultado": "", "erro": "Erro no modelo da visão " + resolucao["visao"] + ": " + renderizado["erro"] }
    }
    textoBase = aplicar_folEs(renderizado["resultado"])

    retorna { "resultado": lmht.converter_lmht_para_html(textoBase), "erro": "" }
}
