// Formatação de visões LMHT: resolve a visão da rota, aplica o leiaute (`base.lmht`),
// as parciais (`<parcial nome="..."/>`), o modelo com os valores da resposta,
// converte `<estilo>` de FolEs para CSS e, por fim, traduz LMHT para HTML.
importar tudo como arquivos de "arquivos"
importar { converter_lmht_para_html } de "lmht"
importar { converter_texto_para_css } de "foles"
importar { comecaCom, ehEspaco, encontrarAPartir, substituirTodos, terminaCom } de "../utilidades/texto.delegua"
importar { renderizar } de "./modelos.delegua"

funcao obterNomeArquivoLeiaute(): texto {
    retorna "base.lmht"
}

// Remove os segmentos `:parametro` do caminho da rota. "/clientes/:id/notas" -> "clientes/notas".
funcao caminhoSemParametros(caminhoRota: texto): texto {
    var segmentos: texto[] = []
    para cada segmento em ("" + caminhoRota).dividir("/") {
        se (segmento == "" ou segmento[0] == ":") { continua }
        segmentos.adicionar(segmento)
    }
    retorna segmentos.juntar("/")
}

funcao ultimaParteEhParametro(caminhoRota: texto): lógico {
    var segmentos: texto[] = []
    para cada segmento em ("" + caminhoRota).dividir("/") {
        se (segmento != "") { segmentos.adicionar(segmento) }
    }
    se (segmentos.tamanho() == 0) { retorna falso }
    var ultimo: texto = segmentos[segmentos.tamanho() - 1]
    retorna ultimo[0] == ":"
}

// Resolve o arquivo de visão para o caminho da rota, como no Líquido original:
// `/x` -> `visoes/x.lmht` ou `visoes/x/inicial.lmht`; `/x/:id` -> `visoes/x/detalhes.lmht`.
// Devolve { "visao": caminho ou nulo, "tentados": [..] }.
funcao resolverVisao(diretorioBase: texto, caminhoRota: texto): dicionário {
    var diretorioVisoes: texto = arquivos.juntarCaminhos(diretorioBase, "visoes")
    var semParametros: texto = caminhoSemParametros(caminhoRota)
    var diretorioOuArquivo: texto = diretorioVisoes
    se (semParametros != "") { diretorioOuArquivo = arquivos.juntarCaminhos(diretorioVisoes, semParametros) }
    var tentados: texto[] = []

    var visao: texto = ""
    se (ultimaParteEhParametro(caminhoRota)) {
        visao = arquivos.juntarCaminhos(diretorioOuArquivo, "detalhes.lmht")
    } senao se (semParametros == "") {
        visao = arquivos.juntarCaminhos(diretorioVisoes, "inicial.lmht")
    } senao {
        visao = diretorioOuArquivo + ".lmht"
    }
    tentados.adicionar(visao)

    se (arquivos.eArquivo(visao)) {
        retorna { "visao": visao, "tentados": tentados }
    }
    var inicial: texto = arquivos.juntarCaminhos(diretorioOuArquivo, "inicial.lmht")
    se (nao tentados.inclui(inicial)) { tentados.adicionar(inicial) }
    se (arquivos.eArquivo(inicial)) {
        retorna { "visao": inicial, "tentados": tentados }
    }
    retorna { "visao": nulo, "tentados": tentados }
}

// Procura `base.lmht` no diretório da visão e nos diretórios acima, até `visoes/`.
funcao resolverLeiaute(diretorioBase: texto, caminhoVisao: texto): texto {
    var diretorioVisoes: texto = arquivos.caminhoAbsoluto(arquivos.juntarCaminhos(diretorioBase, "visoes"))
    var visaoAbsoluta: texto = arquivos.caminhoAbsoluto(caminhoVisao)
    var diretorioAtual: texto = arquivos.diretorioPai(visaoAbsoluta)
    var nomeArquivoLeiaute: texto = obterNomeArquivoLeiaute()
    var limite: inteiro = 64
    enquanto (limite > 0 e comecaCom(diretorioAtual, diretorioVisoes)) {
        limite = limite - 1
        var candidato: texto = arquivos.juntarCaminhos(diretorioAtual, nomeArquivoLeiaute)
        se (candidato != visaoAbsoluta e arquivos.eArquivo(candidato)) {
            retorna candidato
        }
        se (diretorioAtual == diretorioVisoes) { sustar }
        diretorioAtual = arquivos.diretorioPai(diretorioAtual)
    }
    retorna nulo
}

// Conteúdo interno da primeira marcação `<nome>...</nome>`, aceitando atributos na abertura.
// Devolve { "encontrado", "inicio", "fim", "interno" } (inicio/fim delimitam a marcação inteira).
funcao localizarMarcacao(conteudo: texto, nome: texto): dicionário {
    var textoConteudo: texto = "" + conteudo
    var procurar: inteiro = 0
    enquanto (procurar < textoConteudo.tamanho()) {
        var abertura: inteiro = encontrarAPartir(textoConteudo, "<" + nome, procurar)
        se (abertura < 0) { sustar }
        var depoisNome: inteiro = abertura + nome.tamanho() + 1
        se (depoisNome >= textoConteudo.tamanho()) { sustar }
        var seguinte: texto = textoConteudo[depoisNome]
        se (seguinte == ">" ou ehEspaco(seguinte)) {
            var fimAbertura: inteiro = encontrarAPartir(textoConteudo, ">", depoisNome)
            se (fimAbertura < 0) { sustar }
            var fechamento: inteiro = encontrarAPartir(textoConteudo, "</" + nome + ">", fimAbertura + 1)
            se (fechamento < 0) { sustar }
            retorna {
                "encontrado": verdadeiro,
                "inicio": abertura,
                "fim": fechamento + nome.tamanho() + 3,
                "inicioInterno": fimAbertura + 1,
                "fimInterno": fechamento,
                "interno": textoConteudo.subtexto(fimAbertura + 1, fechamento)
            }
        }
        procurar = depoisNome
    }
    retorna { "encontrado": falso, "inicio": -1, "fim": -1, "inicioInterno": -1, "fimInterno": -1, "interno": "" }
}

funcao localizarCabeca(conteudo: texto): dicionário {
    var cabeca: dicionário = localizarMarcacao(conteudo, "cabeca")
    se (cabeca["encontrado"]) { retorna cabeca }
    retorna localizarMarcacao(conteudo, "cabeça")
}

// Posição e tamanho do marcador `<conteudo/>` (aceita espaços antes de `/>`), ou inicio -1.
funcao localizarMarcadorConteudo(conteudo: texto): dicionário {
    var procurar: inteiro = 0
    enquanto (procurar < conteudo.tamanho()) {
        var abertura: inteiro = encontrarAPartir(conteudo, "<conteudo", procurar)
        se (abertura < 0) { sustar }
        var posicao: inteiro = abertura + 9
        enquanto (posicao < conteudo.tamanho() e ehEspaco(conteudo[posicao])) { posicao = posicao + 1 }
        se (conteudo.subtexto(posicao, posicao + 2) == "/>") {
            retorna { "inicio": abertura, "fim": posicao + 2 }
        }
        procurar = abertura + 9
    }
    retorna { "inicio": -1, "fim": -1 }
}

// Insere o corpo da página no `<conteudo/>` do leiaute e acrescenta a cabeça da página à do leiaute.
// Devolve { "resultado", "erro" }.
funcao comporComLeiaute(textoLeiaute: texto, textoPagina: texto, caminhoLeiaute: texto): dicionário {
    var marcador: dicionário = localizarMarcadorConteudo(textoLeiaute)
    var inicioMarcador: inteiro = marcador["inicio"]
    var fimMarcador: inteiro = marcador["fim"]
    se (inicioMarcador < 0) {
        retorna {
            "resultado": "",
            "erro": "O arquivo de leiaute '" + caminhoLeiaute + "' não contém o marcador '<conteudo/>' onde o conteúdo da visão deveria ser inserido."
        }
    }
    var corpoPagina: dicionário = localizarMarcacao(textoPagina, "corpo")
    var internoCorpo: texto = corpoPagina["interno"]
    var composto: texto = textoLeiaute.subtexto(0, inicioMarcador) + internoCorpo + textoLeiaute.subtexto(fimMarcador, textoLeiaute.tamanho())

    var cabecaPagina: dicionário = localizarCabeca(textoPagina)
    var internoCabecaPagina: texto = cabecaPagina["interno"]
    se (cabecaPagina["encontrado"] e internoCabecaPagina.aparar() != "") {
        var cabecaLeiaute: dicionário = localizarCabeca(composto)
        se (cabecaLeiaute["encontrado"]) {
            var fimInternoLeiaute: inteiro = cabecaLeiaute["fimInterno"]
            composto = composto.subtexto(0, fimInternoLeiaute) + internoCabecaPagina + composto.subtexto(fimInternoLeiaute, composto.tamanho())
        } senao {
            var posicaoLmht: inteiro = composto.encontrar("<lmht>")
            se (posicaoLmht >= 0) {
                composto = composto.subtexto(0, posicaoLmht + 6) + "<cabeca>" + internoCabecaPagina + "</cabeca>" + composto.subtexto(posicaoLmht + 6, composto.tamanho())
            }
        }
    }
    retorna { "resultado": composto, "erro": "" }
}

// Substitui `<parcial nome="x"/>` (ou `<parcial nome="x"></parcial>`) pelo conteúdo de `visoes/parciais/x.lmht`.
funcao aplicarParciais(diretorioBase: texto, conteudo: texto): dicionário {
    var resultado: texto = ""
    var restante: texto = "" + conteudo
    var diretorioParciais: texto = arquivos.juntarCaminhos(arquivos.juntarCaminhos(diretorioBase, "visoes"), "parciais")
    var limite: inteiro = 1000
    enquanto (limite > 0) {
        limite = limite - 1
        var abertura: inteiro = restante.encontrar("<parcial")
        se (abertura < 0) { sustar }
        var fimAbertura: inteiro = encontrarAPartir(restante, ">", abertura)
        se (fimAbertura < 0) {
            retorna { "resultado": "", "erro": "Estrutura parcial não terminada." }
        }
        var marcacao: texto = restante.subtexto(abertura, fimAbertura + 1)
        var fimTotal: inteiro = fimAbertura + 1
        se (nao terminaCom(marcacao, "/>")) {
            var fechamento: inteiro = encontrarAPartir(restante, "</parcial>", fimAbertura)
            se (fechamento < 0) {
                retorna { "resultado": "", "erro": "Estrutura parcial sem fechamento." }
            }
            fimTotal = fechamento + 10
        }
        var posicaoNome: inteiro = marcacao.encontrar("nome=\"")
        se (posicaoNome < 0) {
            retorna { "resultado": "", "erro": "Na estrutura parcial, o atributo 'nome' não foi informado." }
        }
        var fimNome: inteiro = encontrarAPartir(marcacao, "\"", posicaoNome + 6)
        var nome: texto = marcacao.subtexto(posicaoNome + 6, fimNome)
        se (nao arquivos.eDiretorio(diretorioParciais)) {
            retorna { "resultado": "", "erro": "O diretório 'visoes/parciais' não foi encontrado." }
        }
        var conteudoParcial: texto = arquivos.lerTexto(arquivos.juntarCaminhos(diretorioParciais, nome + ".lmht"))
        se (conteudoParcial == nulo) {
            retorna { "resultado": "", "erro": "O arquivo '" + nome + ".lmht' não foi encontrado." }
        }
        resultado = resultado + restante.subtexto(0, abertura) + conteudoParcial
        restante = restante.subtexto(fimTotal, restante.tamanho())
    }
    retorna { "resultado": resultado + restante, "erro": "" }
}

// Converte o conteúdo de cada `<estilo>` de FolEs para CSS, trocando a estrutura por `<style>`,
// como no Líquido original (o tradutor LMHT mantém `<estilo>` como está dentro de `<cabeca>`).
funcao aplicar_folEs(conteudo: texto): texto {
    var resultado: texto = ""
    var restante: texto = "" + conteudo
    var limite: inteiro = 1000
    enquanto (limite > 0) {
        limite = limite - 1
        var estilo: dicionário = localizarMarcacao(restante, "estilo")
        se (nao estilo["encontrado"]) { sustar }
        var css: texto = ""
        tente {
            css = converter_texto_para_css(estilo["interno"])
        } pegue (erro) {
            escreva("[Liquido] Erro ao processar estilo no LMHT: " + erro.mensagem + ". O estilo será ignorado, mas a página continuará sendo renderizada.")
        }
        var inicioEstilo: inteiro = estilo["inicio"]
        var fimEstilo: inteiro = estilo["fim"]
        resultado = resultado + restante.subtexto(0, inicioEstilo) + "<style>\n" + css + "\n</style>"
        restante = restante.subtexto(fimEstilo, restante.tamanho())
    }
    retorna resultado + restante
}

// Formata a visão da rota. Devolve { "resultado": html, "erro": "" }.
funcao formatar(diretorioBase: texto, caminhoRota: texto, valores: qualquer): dicionário {
    var resolucao: dicionário = resolverVisao(diretorioBase, caminhoRota)
    var caminhoVisao: texto = resolucao["visao"]
    se (caminhoVisao == nulo) {
        var tentados: texto[] = resolucao["tentados"]
        retorna {
            "resultado": "",
            "erro": "Visão correspondente à rota " + caminhoRota + " não existe. Caminhos tentados: " + tentados.juntar("; ") + "; "
        }
    }
    var textoBase: texto = arquivos.lerTexto(caminhoVisao)
    se (textoBase == nulo) {
        retorna { "resultado": "", "erro": "Não foi possível ler a visão " + caminhoVisao + "." }
    }
    textoBase = substituirTodos(textoBase, "\r\n", "\n")

    var caminhoLeiaute: texto = resolverLeiaute(diretorioBase, caminhoVisao)
    se (caminhoLeiaute != nulo) {
        var textoLeiaute: texto = arquivos.lerTexto(caminhoLeiaute)
        var composicao: dicionário = comporComLeiaute(substituirTodos(textoLeiaute, "\r\n", "\n"), textoBase, caminhoLeiaute)
        se (composicao["erro"] != "") { retorna composicao }
        textoBase = composicao["resultado"]
    }

    var parciais: dicionário = aplicarParciais(diretorioBase, textoBase)
    se (parciais["erro"] != "") { retorna parciais }
    textoBase = parciais["resultado"]

    var renderizado: dicionário = renderizar(textoBase, valores)
    se (renderizado["erro"] != "") {
        retorna { "resultado": "", "erro": "Erro no modelo da visão " + caminhoVisao + ": " + renderizado["erro"] }
    }
    textoBase = aplicar_folEs(renderizado["resultado"])

    retorna { "resultado": converter_lmht_para_html(textoBase), "erro": "" }
}
