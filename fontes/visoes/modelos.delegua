// Motor de modelos para visões, compatível com o subconjunto de Handlebars usado pelo Líquido.
//
// Suporta:
// - `{{caminho.da.variavel}}` (com escape de HTML) e `{{{caminho}}}` (sem escape);
// - `{{this}}`/`{{isto}}`, `{{@index}}`/`{{@indice}}`, `{{@key}}`/`{{@chave}}`,
//   `{{@first}}`/`{{@primeiro}}`, `{{@last}}`/`{{@ultimo}}` e `{{../variavel}}`;
// - blocos `{{#each}}`/`{{#cada}}`, `{{#if}}`/`{{#se}}`, `{{#unless}}`/`{{#senao}}`, `{{#with}}`/`{{#com}}`,
//   com `{{else}}`/`{{senão}}`;
// - comentários `{{! ... }}` e `{{!-- ... --}}`.
//
// Como no resto do Líquido, funções recursivas usam laços por índice e a tabela `adiante`
// para chamar funções declaradas mais adiante no módulo.
importar tudo como textos de "../utilidades/texto.delegua"
importar tudo como json_liquido de "../utilidades/json.delegua"

var adiante = {}

var nomes_cada = ["each", "cada"]
var nomes_se = ["if", "se"]
var nomes_exceto = ["unless", "senao", "senão", "exceto"]
var nomes_com = ["with", "com"]
var nomes_senao = ["else", "senao", "senão"]

// ── Análise léxica: divide o modelo em textos e marcações ──

funcao separar_marcacoes(modelo) {
    var texto_modelo = "" + modelo
    var partes = []
    var posicao = 0
    enquanto (posicao < texto_modelo.tamanho()) {
        var abertura = textos.encontrar_a_partir(texto_modelo, "{{", posicao)
        se (abertura < 0) {
            var parte_final = { "tipo_parte": "texto", "conteudo": texto_modelo.subtexto(posicao, texto_modelo.tamanho()) }
            partes.adicionar(parte_final)
            sustar
        }
        se (abertura > posicao) {
            var parte_texto = { "tipo_parte": "texto", "conteudo": texto_modelo.subtexto(posicao, abertura) }
            partes.adicionar(parte_texto)
        }
        var triplo = texto_modelo.subtexto(abertura, abertura + 3) == "{{{"
        var fim_marcacao = "}}"
        var inicio_conteudo = abertura + 2
        se (triplo) {
            fim_marcacao = "}}}"
            inicio_conteudo = abertura + 3
        }
        se (texto_modelo.subtexto(abertura, abertura + 5) == "{{!--") {
            fim_marcacao = "--}}"
        }
        var fechamento = textos.encontrar_a_partir(texto_modelo, fim_marcacao, inicio_conteudo)
        se (fechamento < 0) {
            // Marcação sem fechamento: mantém o restante como texto.
            var parte_resto = { "tipo_parte": "texto", "conteudo": texto_modelo.subtexto(abertura, texto_modelo.tamanho()) }
            partes.adicionar(parte_resto)
            sustar
        }
        var conteudo = texto_modelo.subtexto(inicio_conteudo, fechamento).aparar()
        posicao = fechamento + fim_marcacao.tamanho()
        se (conteudo.tamanho() > 0 e conteudo[0] == "!") { continua }
        se (triplo) {
            var parte_bruta = { "tipo_parte": "bruto", "conteudo": conteudo }
            partes.adicionar(parte_bruta)
        } senao se (conteudo.tamanho() > 0 e conteudo[0] == "#") {
            var corpo_abertura = conteudo.subtexto(1, conteudo.tamanho()).aparar()
            var espaco = corpo_abertura.encontrar(" ")
            var nome_bloco = corpo_abertura
            var argumento = ""
            se (espaco > 0) {
                nome_bloco = corpo_abertura.subtexto(0, espaco)
                argumento = corpo_abertura.subtexto(espaco + 1, corpo_abertura.tamanho()).aparar()
            }
            var parte_abertura = { "tipo_parte": "abertura", "conteudo": nome_bloco, "argumento": argumento }
            partes.adicionar(parte_abertura)
        } senao se (conteudo.tamanho() > 0 e conteudo[0] == "/") {
            var parte_fechamento = { "tipo_parte": "fechamento", "conteudo": conteudo.subtexto(1, conteudo.tamanho()).aparar() }
            partes.adicionar(parte_fechamento)
        } senao se (nomes_senao.inclui(conteudo) ou conteudo == "^") {
            var parte_senao = { "tipo_parte": "senao", "conteudo": conteudo }
            partes.adicionar(parte_senao)
        } senao {
            var parte_variavel = { "tipo_parte": "variavel", "conteudo": conteudo }
            partes.adicionar(parte_variavel)
        }
    }
    retorna partes
}

// ── Análise sintática: monta a árvore de nós ──
// Estado: { "partes", "posicao", "erro" }. Cada nó: { "tipo_no", "conteudo", "argumento", "filhos", "alternativa" }.

funcao analisar_nos(estado, nome_bloco_aberto) {
    var nos = []
    var partes = estado["partes"]
    enquanto (estado["posicao"] < partes.tamanho() e estado["erro"] == "") {
        var parte = partes[estado["posicao"]]
        var tipo_parte = parte["tipo_parte"]
        se (tipo_parte == "fechamento" ou tipo_parte == "senao") {
            se (nome_bloco_aberto == "") {
                estado["erro"] = "Marcação '{{" + parte["conteudo"] + "}}' sem bloco aberto."
            }
            retorna nos
        }
        estado["posicao"] = estado["posicao"] + 1
        se (tipo_parte == "abertura") {
            var filhos: vetor = adiante["analisar_nos"](estado, parte["conteudo"])
            var alternativa = []
            se (estado["erro"] == "" e estado["posicao"] < partes.tamanho() e partes[estado["posicao"]]["tipo_parte"] == "senao") {
                estado["posicao"] = estado["posicao"] + 1
                alternativa = adiante["analisar_nos"](estado, parte["conteudo"])
            }
            se (estado["erro"] != "") { retorna nos }
            se (estado["posicao"] >= partes.tamanho()) {
                estado["erro"] = "Bloco '{{#" + parte["conteudo"] + "}}' não foi fechado."
                retorna nos
            }
            var fechamento = partes[estado["posicao"]]
            se (fechamento["conteudo"] != parte["conteudo"]) {
                estado["erro"] = "Bloco '{{#" + parte["conteudo"] + "}}' fechado com '{{/" + fechamento["conteudo"] + "}}'."
                retorna nos
            }
            estado["posicao"] = estado["posicao"] + 1
            var no_bloco = {
                "tipo_no": "bloco",
                "conteudo": parte["conteudo"],
                "argumento": parte["argumento"],
                "filhos": filhos,
                "alternativa": alternativa
            }
            nos.adicionar(no_bloco)
        } senao {
            var sem_filhos = []
            var no_simples = {
                "tipo_no": tipo_parte,
                "conteudo": parte["conteudo"],
                "argumento": "",
                "filhos": sem_filhos,
                "alternativa": sem_filhos
            }
            nos.adicionar(no_simples)
        }
    }
    se (nome_bloco_aberto != "" e estado["erro"] == "" e estado["posicao"] >= partes.tamanho()) {
        estado["erro"] = "Bloco '{{#" + nome_bloco_aberto + "}}' não foi fechado."
    }
    retorna nos
}
adiante["analisar_nos"] = analisar_nos

// ── Resolução de valores ──
// Um contexto é { "dados", "pai", "indice", "chave", "primeiro", "ultimo" }; `pai` é nulo na raiz.

funcao criar_contexto(dados, pai) {
    retorna { "dados": dados, "pai": pai, "indice": nulo, "chave": nulo, "primeiro": nulo, "ultimo": nulo }
}

funcao eh_dicionario(valor) {
    se (valor == nulo) { retorna falso }
    var tipo_valor = tipo de valor
    retorna tipo_valor == "dicionário"
}

funcao eh_vetor(valor) {
    se (valor == nulo) { retorna falso }
    var tipo_valor = tipo de valor
    retorna tipo_valor == "vetor" ou ("" + tipo_valor).terminaCom("[]")
}

// Resolve `caminho` no contexto e grava em estado_valor["encontrado"]/["resultado"].
funcao resolver_caminho(contexto, caminho, estado_valor) {
    estado_valor["encontrado"] = falso
    estado_valor["resultado"] = nulo
    var atual = contexto
    var restante = caminho.aparar()
    enquanto (textos.comeca_com(restante, "../")) {
        se (atual["pai"] != nulo) { atual = atual["pai"] }
        restante = restante.subtexto(3, restante.tamanho())
    }
    se (restante == "@index" ou restante == "@indice" ou restante == "@índice") {
        estado_valor["encontrado"] = atual["indice"] != nulo
        estado_valor["resultado"] = atual["indice"]
        retorna
    }
    se (restante == "@key" ou restante == "@chave") {
        estado_valor["encontrado"] = atual["chave"] != nulo
        estado_valor["resultado"] = atual["chave"]
        retorna
    }
    se (restante == "@first" ou restante == "@primeiro") {
        estado_valor["encontrado"] = verdadeiro
        estado_valor["resultado"] = atual["primeiro"] == verdadeiro
        retorna
    }
    se (restante == "@last" ou restante == "@ultimo" ou restante == "@último") {
        estado_valor["encontrado"] = verdadeiro
        estado_valor["resultado"] = atual["ultimo"] == verdadeiro
        retorna
    }
    var dados = atual["dados"]
    se (restante == "this" ou restante == "isto" ou restante == ".") {
        estado_valor["encontrado"] = verdadeiro
        estado_valor["resultado"] = dados
        retorna
    }
    se (textos.comeca_com(restante, "this.")) { restante = restante.subtexto(5, restante.tamanho()) }
    senao se (textos.comeca_com(restante, "isto.")) { restante = restante.subtexto(5, restante.tamanho()) }

    var segmentos = restante.dividir(".")
    var valor_atual = dados
    para (var i = 0; i < segmentos.tamanho(); i = i + 1) {
        var segmento = segmentos[i]
        se (eh_dicionario(valor_atual) e valor_atual.contem(segmento)) {
            valor_atual = valor_atual[segmento]
        } senao se (eh_vetor(valor_atual) e segmento != "" e textos.eh_digito(segmento[0])) {
            var posicao_vetor = inteiro(segmento)
            se (posicao_vetor >= valor_atual.tamanho()) { retorna }
            valor_atual = valor_atual[posicao_vetor]
        } senao se (segmento == "length" ou segmento == "tamanho") {
            se (eh_vetor(valor_atual)) {
                valor_atual = valor_atual.tamanho()
            } senao se (eh_dicionario(valor_atual)) {
                valor_atual = valor_atual.chaves().tamanho()
            } senao {
                retorna
            }
        } senao {
            retorna
        }
    }
    estado_valor["encontrado"] = verdadeiro
    estado_valor["resultado"] = valor_atual
}

funcao valor_no_contexto(contexto, caminho) {
    var estado_valor = { "encontrado": falso, "resultado": nulo }
    var atual = contexto
    resolver_caminho(atual, caminho, estado_valor)
    // Como no Handlebars, variáveis simples não encontradas são procuradas nos contextos acima.
    enquanto (nao estado_valor["encontrado"] e atual["pai"] != nulo e nao caminho.inclui("../") e nao textos.comeca_com(caminho, "@")) {
        atual = atual["pai"]
        resolver_caminho(atual, caminho, estado_valor)
    }
    var lista = [estado_valor["resultado"]]
    retorna lista
}

funcao eh_verdadeiro(valor) {
    se (valor == nulo) { retorna falso }
    var tipo_valor = tipo de valor
    se (tipo_valor == "lógico") { retorna valor }
    se (tipo_valor == "texto") { retorna valor != "" }
    se (tipo_valor == "número") { retorna valor != 0 }
    se (eh_vetor(valor)) { retorna valor.tamanho() > 0 }
    retorna verdadeiro
}

funcao como_texto(valor) {
    se (valor == nulo) { retorna "" }
    var tipo_valor = tipo de valor
    se (tipo_valor == "texto") { retorna valor }
    se (tipo_valor == "lógico") {
        se (valor) { retorna "true" }
        retorna "false"
    }
    se (eh_vetor(valor)) {
        var partes = []
        para (var i = 0; i < valor.tamanho(); i = i + 1) {
            partes.adicionar(como_texto(valor[i]))
        }
        retorna partes.juntar(",")
    }
    se (eh_dicionario(valor)) { retorna "[object Object]" }
    retorna texto(valor)
}

// ── Renderização ──

funcao renderizar_nos(nos, contexto) {
    var saida = ""
    para (var i = 0; i < nos.tamanho(); i = i + 1) {
        var no = nos[i]
        var tipo_no = no["tipo_no"]
        se (tipo_no == "texto") {
            saida = saida + no["conteudo"]
        } senao se (tipo_no == "variavel") {
            var resolvido: vetor = valor_no_contexto(contexto, no["conteudo"])
            saida = saida + textos.escapar_html(como_texto(resolvido[0]))
        } senao se (tipo_no == "bruto") {
            var resolvido_bruto: vetor = valor_no_contexto(contexto, no["conteudo"])
            saida = saida + como_texto(resolvido_bruto[0])
        } senao se (tipo_no == "bloco") {
            saida = saida + adiante["renderizar_bloco"](no, contexto)
        }
    }
    retorna saida
}

funcao renderizar_bloco(no, contexto) {
    var nome = no["conteudo"]
    var argumento_resolvido: vetor = valor_no_contexto(contexto, no["argumento"])
    var alvo = argumento_resolvido[0]

    se (nomes_se.inclui(nome)) {
        se (eh_verdadeiro(alvo)) { retorna renderizar_nos(no["filhos"], contexto) }
        retorna renderizar_nos(no["alternativa"], contexto)
    }
    se (nomes_exceto.inclui(nome)) {
        se (nao eh_verdadeiro(alvo)) { retorna renderizar_nos(no["filhos"], contexto) }
        retorna renderizar_nos(no["alternativa"], contexto)
    }
    se (nomes_com.inclui(nome)) {
        se (eh_verdadeiro(alvo)) {
            var contexto_com: dicionário = criar_contexto(alvo, contexto)
            retorna renderizar_nos(no["filhos"], contexto_com)
        }
        retorna renderizar_nos(no["alternativa"], contexto)
    }
    se (nomes_cada.inclui(nome)) {
        var saida = ""
        se (eh_vetor(alvo) e alvo.tamanho() > 0) {
            para (var i = 0; i < alvo.tamanho(); i = i + 1) {
                var contexto_item: dicionário = criar_contexto(alvo[i], contexto)
                contexto_item["indice"] = i
                contexto_item["primeiro"] = i == 0
                contexto_item["ultimo"] = i == alvo.tamanho() - 1
                saida = saida + renderizar_nos(no["filhos"], contexto_item)
            }
            retorna saida
        }
        se (eh_dicionario(alvo) e alvo.chaves().tamanho() > 0) {
            var chaves = alvo.chaves()
            para (var j = 0; j < chaves.tamanho(); j = j + 1) {
                var contexto_chave: dicionário = criar_contexto(alvo[chaves[j]], contexto)
                contexto_chave["indice"] = j
                contexto_chave["chave"] = chaves[j]
                contexto_chave["primeiro"] = j == 0
                contexto_chave["ultimo"] = j == chaves.tamanho() - 1
                saida = saida + renderizar_nos(no["filhos"], contexto_chave)
            }
            retorna saida
        }
        retorna renderizar_nos(no["alternativa"], contexto)
    }
    // Bloco desconhecido: trata como `se`.
    se (eh_verdadeiro(alvo)) { retorna renderizar_nos(no["filhos"], contexto) }
    retorna renderizar_nos(no["alternativa"], contexto)
}
adiante["renderizar_bloco"] = renderizar_bloco

// Renderiza o modelo com os dados. Devolve { "resultado": texto, "erro": "" }.
funcao renderizar(modelo, dados) {
    var partes: vetor = separar_marcacoes(modelo)
    var estado = { "partes": partes, "posicao": 0, "erro": "" }
    var nos: vetor = analisar_nos(estado, "")
    se (estado["erro"] != "") {
        retorna { "resultado": "", "erro": estado["erro"] }
    }
    var dados_raiz = dados
    se (dados_raiz == nulo) { dados_raiz = {} }
    var contexto: dicionário = criar_contexto(dados_raiz, nulo)
    retorna { "resultado": renderizar_nos(nos, contexto), "erro": "" }
}
