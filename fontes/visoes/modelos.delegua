// Motor de modelos para visões, compatível com o subconjunto de Handlebars usado pelo Líquido.
//
// Suporta:
// - `{{caminho.da.variavel}}` (com escape de HTML) e `{{{caminho}}}` (sem escape);
// - `{{this}}`/`{{isto}}`, `{{@index}}`/`{{@indice}}`, `{{@key}}`/`{{@chave}}`,
//   `{{@first}}`/`{{@primeiro}}`, `{{@last}}`/`{{@ultimo}}` e `{{../variavel}}`;
// - blocos `{{#each}}`/`{{#cada}}`, `{{#if}}`/`{{#se}}`, `{{#unless}}`/`{{#senao}}`, `{{#with}}`/`{{#com}}`,
//   com `{{else}}`/`{{senão}}`;
// - comentários `{{! ... }}` e `{{!-- ... --}}`.
//
// Como no resto do Líquido, funções recursivas usam laços por índice e a tabela `adiante`
// para chamar funções declaradas mais adiante no módulo.
importar tudo como textos de "../utilidades/texto.delegua"
importar tudo como jsonLiquido de "../utilidades/json.delegua"

var adiante = {}

var nomesCada = ["each", "cada"]
var nomesSe = ["if", "se"]
var nomesExceto = ["unless", "senao", "senão", "exceto"]
var nomesCom = ["with", "com"]
var nomesSenao = ["else", "senao", "senão"]

// ── Análise léxica: divide o modelo em textos e marcações ──

funcao separarMarcacoes(modelo) {
    var textoModelo = "" + modelo
    var partes = []
    var posicao = 0
    enquanto (posicao < textoModelo.tamanho()) {
        var abertura = textos.encontrarAPartir(textoModelo, "{{", posicao)
        se (abertura < 0) {
            var parteFinal = { "tipoParte": "texto", "conteudo": textoModelo.subtexto(posicao, textoModelo.tamanho()) }
            partes.adicionar(parteFinal)
            sustar
        }
        se (abertura > posicao) {
            var parteTexto = { "tipoParte": "texto", "conteudo": textoModelo.subtexto(posicao, abertura) }
            partes.adicionar(parteTexto)
        }
        var triplo = textoModelo.subtexto(abertura, abertura + 3) == "{{{"
        var fimMarcacao = "}}"
        var inicioConteudo = abertura + 2
        se (triplo) {
            fimMarcacao = "}}}"
            inicioConteudo = abertura + 3
        }
        se (textoModelo.subtexto(abertura, abertura + 5) == "{{!--") {
            fimMarcacao = "--}}"
        }
        var fechamento = textos.encontrarAPartir(textoModelo, fimMarcacao, inicioConteudo)
        se (fechamento < 0) {
            // Marcação sem fechamento: mantém o restante como texto.
            var parteResto = { "tipoParte": "texto", "conteudo": textoModelo.subtexto(abertura, textoModelo.tamanho()) }
            partes.adicionar(parteResto)
            sustar
        }
        var conteudo = textoModelo.subtexto(inicioConteudo, fechamento).aparar()
        posicao = fechamento + fimMarcacao.tamanho()
        se (conteudo.tamanho() > 0 e conteudo[0] == "!") { continua }
        se (triplo) {
            var parteBruta = { "tipoParte": "bruto", "conteudo": conteudo }
            partes.adicionar(parteBruta)
        } senao se (conteudo.tamanho() > 0 e conteudo[0] == "#") {
            var corpoAbertura = conteudo.subtexto(1, conteudo.tamanho()).aparar()
            var espaco = corpoAbertura.encontrar(" ")
            var nomeBloco = corpoAbertura
            var argumento = ""
            se (espaco > 0) {
                nomeBloco = corpoAbertura.subtexto(0, espaco)
                argumento = corpoAbertura.subtexto(espaco + 1, corpoAbertura.tamanho()).aparar()
            }
            var parteAbertura = { "tipoParte": "abertura", "conteudo": nomeBloco, "argumento": argumento }
            partes.adicionar(parteAbertura)
        } senao se (conteudo.tamanho() > 0 e conteudo[0] == "/") {
            var parteFechamento = { "tipoParte": "fechamento", "conteudo": conteudo.subtexto(1, conteudo.tamanho()).aparar() }
            partes.adicionar(parteFechamento)
        } senao se (nomesSenao.inclui(conteudo) ou conteudo == "^") {
            var parteSenao = { "tipoParte": "senao", "conteudo": conteudo }
            partes.adicionar(parteSenao)
        } senao {
            var parteVariavel = { "tipoParte": "variavel", "conteudo": conteudo }
            partes.adicionar(parteVariavel)
        }
    }
    retorna partes
}

// ── Análise sintática: monta a árvore de nós ──
// Estado: { "partes", "posicao", "erro" }. Cada nó: { "tipoNo", "conteudo", "argumento", "filhos", "alternativa" }.

funcao analisarNos(estado, nomeBlocoAberto) {
    var nos = []
    var partes = estado["partes"]
    enquanto (estado["posicao"] < partes.tamanho() e estado["erro"] == "") {
        var parte = partes[estado["posicao"]]
        var tipoParte = parte["tipoParte"]
        se (tipoParte == "fechamento" ou tipoParte == "senao") {
            se (nomeBlocoAberto == "") {
                estado["erro"] = "Marcação '{{" + parte["conteudo"] + "}}' sem bloco aberto."
            }
            retorna nos
        }
        estado["posicao"] = estado["posicao"] + 1
        se (tipoParte == "abertura") {
            var filhos: vetor = adiante["analisarNos"](estado, parte["conteudo"])
            var alternativa = []
            se (estado["erro"] == "" e estado["posicao"] < partes.tamanho() e partes[estado["posicao"]]["tipoParte"] == "senao") {
                estado["posicao"] = estado["posicao"] + 1
                alternativa = adiante["analisarNos"](estado, parte["conteudo"])
            }
            se (estado["erro"] != "") { retorna nos }
            se (estado["posicao"] >= partes.tamanho()) {
                estado["erro"] = "Bloco '{{#" + parte["conteudo"] + "}}' não foi fechado."
                retorna nos
            }
            var fechamento = partes[estado["posicao"]]
            se (fechamento["conteudo"] != parte["conteudo"]) {
                estado["erro"] = "Bloco '{{#" + parte["conteudo"] + "}}' fechado com '{{/" + fechamento["conteudo"] + "}}'."
                retorna nos
            }
            estado["posicao"] = estado["posicao"] + 1
            var noBloco = {
                "tipoNo": "bloco",
                "conteudo": parte["conteudo"],
                "argumento": parte["argumento"],
                "filhos": filhos,
                "alternativa": alternativa
            }
            nos.adicionar(noBloco)
        } senao {
            var semFilhos = []
            var noSimples = {
                "tipoNo": tipoParte,
                "conteudo": parte["conteudo"],
                "argumento": "",
                "filhos": semFilhos,
                "alternativa": semFilhos
            }
            nos.adicionar(noSimples)
        }
    }
    se (nomeBlocoAberto != "" e estado["erro"] == "" e estado["posicao"] >= partes.tamanho()) {
        estado["erro"] = "Bloco '{{#" + nomeBlocoAberto + "}}' não foi fechado."
    }
    retorna nos
}
adiante["analisarNos"] = analisarNos

// ── Resolução de valores ──
// Um contexto é { "dados", "pai", "indice", "chave", "primeiro", "ultimo" }; `pai` é nulo na raiz.

funcao criarContexto(dados, pai) {
    retorna { "dados": dados, "pai": pai, "indice": nulo, "chave": nulo, "primeiro": nulo, "ultimo": nulo }
}

funcao ehDicionario(valor) {
    se (valor == nulo) { retorna falso }
    var tipoValor = tipo de valor
    retorna tipoValor == "dicionário"
}

funcao ehVetor(valor) {
    se (valor == nulo) { retorna falso }
    var tipoValor = tipo de valor
    retorna tipoValor == "vetor" ou ("" + tipoValor).terminaCom("[]")
}

// Resolve `caminho` no contexto e grava em estadoValor["encontrado"]/["resultado"].
funcao resolverCaminho(contexto, caminho, estadoValor) {
    estadoValor["encontrado"] = falso
    estadoValor["resultado"] = nulo
    var atual = contexto
    var restante = caminho.aparar()
    enquanto (textos.comecaCom(restante, "../")) {
        se (atual["pai"] != nulo) { atual = atual["pai"] }
        restante = restante.subtexto(3, restante.tamanho())
    }
    se (restante == "@index" ou restante == "@indice" ou restante == "@índice") {
        estadoValor["encontrado"] = atual["indice"] != nulo
        estadoValor["resultado"] = atual["indice"]
        retorna
    }
    se (restante == "@key" ou restante == "@chave") {
        estadoValor["encontrado"] = atual["chave"] != nulo
        estadoValor["resultado"] = atual["chave"]
        retorna
    }
    se (restante == "@first" ou restante == "@primeiro") {
        estadoValor["encontrado"] = verdadeiro
        estadoValor["resultado"] = atual["primeiro"] == verdadeiro
        retorna
    }
    se (restante == "@last" ou restante == "@ultimo" ou restante == "@último") {
        estadoValor["encontrado"] = verdadeiro
        estadoValor["resultado"] = atual["ultimo"] == verdadeiro
        retorna
    }
    var dados = atual["dados"]
    se (restante == "this" ou restante == "isto" ou restante == ".") {
        estadoValor["encontrado"] = verdadeiro
        estadoValor["resultado"] = dados
        retorna
    }
    se (textos.comecaCom(restante, "this.")) { restante = restante.subtexto(5, restante.tamanho()) }
    senao se (textos.comecaCom(restante, "isto.")) { restante = restante.subtexto(5, restante.tamanho()) }

    var segmentos = restante.dividir(".")
    var valorAtual = dados
    para (var i = 0; i < segmentos.tamanho(); i = i + 1) {
        var segmento = segmentos[i]
        se (ehDicionario(valorAtual) e valorAtual.contem(segmento)) {
            valorAtual = valorAtual[segmento]
        } senao se (ehVetor(valorAtual) e segmento != "" e textos.ehDigito(segmento[0])) {
            var posicaoVetor = inteiro(segmento)
            se (posicaoVetor >= valorAtual.tamanho()) { retorna }
            valorAtual = valorAtual[posicaoVetor]
        } senao se (segmento == "length" ou segmento == "tamanho") {
            se (ehVetor(valorAtual)) {
                valorAtual = valorAtual.tamanho()
            } senao se (ehDicionario(valorAtual)) {
                valorAtual = valorAtual.chaves().tamanho()
            } senao {
                retorna
            }
        } senao {
            retorna
        }
    }
    estadoValor["encontrado"] = verdadeiro
    estadoValor["resultado"] = valorAtual
}

funcao valorNoContexto(contexto, caminho) {
    var estadoValor = { "encontrado": falso, "resultado": nulo }
    var atual = contexto
    resolverCaminho(atual, caminho, estadoValor)
    // Como no Handlebars, variáveis simples não encontradas são procuradas nos contextos acima.
    enquanto (nao estadoValor["encontrado"] e atual["pai"] != nulo e nao caminho.inclui("../") e nao textos.comecaCom(caminho, "@")) {
        atual = atual["pai"]
        resolverCaminho(atual, caminho, estadoValor)
    }
    var lista = [estadoValor["resultado"]]
    retorna lista
}

funcao ehVerdadeiro(valor) {
    se (valor == nulo) { retorna falso }
    var tipoValor = tipo de valor
    se (tipoValor == "lógico") { retorna valor }
    se (tipoValor == "texto") { retorna valor != "" }
    se (tipoValor == "número") { retorna valor != 0 }
    se (ehVetor(valor)) { retorna valor.tamanho() > 0 }
    retorna verdadeiro
}

funcao comoTexto(valor) {
    se (valor == nulo) { retorna "" }
    var tipoValor = tipo de valor
    se (tipoValor == "texto") { retorna valor }
    se (tipoValor == "lógico") {
        se (valor) { retorna "true" }
        retorna "false"
    }
    se (ehVetor(valor)) {
        var partes = []
        para (var i = 0; i < valor.tamanho(); i = i + 1) {
            partes.adicionar(comoTexto(valor[i]))
        }
        retorna partes.juntar(",")
    }
    se (ehDicionario(valor)) { retorna "[object Object]" }
    retorna texto(valor)
}

// ── Renderização ──

funcao renderizarNos(nos, contexto) {
    var saida = ""
    para (var i = 0; i < nos.tamanho(); i = i + 1) {
        var no = nos[i]
        var tipoNo = no["tipoNo"]
        se (tipoNo == "texto") {
            saida = saida + no["conteudo"]
        } senao se (tipoNo == "variavel") {
            var resolvido: vetor = valorNoContexto(contexto, no["conteudo"])
            saida = saida + textos.escaparHtml(comoTexto(resolvido[0]))
        } senao se (tipoNo == "bruto") {
            var resolvidoBruto: vetor = valorNoContexto(contexto, no["conteudo"])
            saida = saida + comoTexto(resolvidoBruto[0])
        } senao se (tipoNo == "bloco") {
            saida = saida + adiante["renderizarBloco"](no, contexto)
        }
    }
    retorna saida
}

funcao renderizarBloco(no, contexto) {
    var nome = no["conteudo"]
    var argumentoResolvido: vetor = valorNoContexto(contexto, no["argumento"])
    var alvo = argumentoResolvido[0]

    se (nomesSe.inclui(nome)) {
        se (ehVerdadeiro(alvo)) { retorna renderizarNos(no["filhos"], contexto) }
        retorna renderizarNos(no["alternativa"], contexto)
    }
    se (nomesExceto.inclui(nome)) {
        se (nao ehVerdadeiro(alvo)) { retorna renderizarNos(no["filhos"], contexto) }
        retorna renderizarNos(no["alternativa"], contexto)
    }
    se (nomesCom.inclui(nome)) {
        se (ehVerdadeiro(alvo)) {
            var contextoCom: dicionário = criarContexto(alvo, contexto)
            retorna renderizarNos(no["filhos"], contextoCom)
        }
        retorna renderizarNos(no["alternativa"], contexto)
    }
    se (nomesCada.inclui(nome)) {
        var saida = ""
        se (ehVetor(alvo) e alvo.tamanho() > 0) {
            para (var i = 0; i < alvo.tamanho(); i = i + 1) {
                var contextoItem: dicionário = criarContexto(alvo[i], contexto)
                contextoItem["indice"] = i
                contextoItem["primeiro"] = i == 0
                contextoItem["ultimo"] = i == alvo.tamanho() - 1
                saida = saida + renderizarNos(no["filhos"], contextoItem)
            }
            retorna saida
        }
        se (ehDicionario(alvo) e alvo.chaves().tamanho() > 0) {
            var chaves = alvo.chaves()
            para (var j = 0; j < chaves.tamanho(); j = j + 1) {
                var contextoChave: dicionário = criarContexto(alvo[chaves[j]], contexto)
                contextoChave["indice"] = j
                contextoChave["chave"] = chaves[j]
                contextoChave["primeiro"] = j == 0
                contextoChave["ultimo"] = j == chaves.tamanho() - 1
                saida = saida + renderizarNos(no["filhos"], contextoChave)
            }
            retorna saida
        }
        retorna renderizarNos(no["alternativa"], contexto)
    }
    // Bloco desconhecido: trata como `se`.
    se (ehVerdadeiro(alvo)) { retorna renderizarNos(no["filhos"], contexto) }
    retorna renderizarNos(no["alternativa"], contexto)
}
adiante["renderizarBloco"] = renderizarBloco

// Renderiza o modelo com os dados. Devolve { "resultado": texto, "erro": "" }.
funcao renderizar(modelo, dados) {
    var partes: vetor = separarMarcacoes(modelo)
    var estado = { "partes": partes, "posicao": 0, "erro": "" }
    var nos: vetor = analisarNos(estado, "")
    se (estado["erro"] != "") {
        retorna { "resultado": "", "erro": estado["erro"] }
    }
    var dadosRaiz = dados
    se (dadosRaiz == nulo) { dadosRaiz = {} }
    var contexto: dicionário = criarContexto(dadosRaiz, nulo)
    retorna { "resultado": renderizarNos(nos, contexto), "erro": "" }
}
