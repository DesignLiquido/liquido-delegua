// Motor de modelos para visões, compatível com o subconjunto de Handlebars usado pelo Líquido.
//
// Suporta:
// - `{{caminho.da.variavel}}` (com escape de HTML) e `{{{caminho}}}` (sem escape);
// - `{{this}}`/`{{isto}}`, `{{@index}}`/`{{@indice}}`, `{{@key}}`/`{{@chave}}`,
//   `{{@first}}`/`{{@primeiro}}`, `{{@last}}`/`{{@ultimo}}` e `{{../variavel}}`;
// - blocos `{{#each}}`/`{{#cada}}`, `{{#if}}`/`{{#se}}`, `{{#unless}}`/`{{#senao}}`, `{{#with}}`/`{{#com}}`,
//   com `{{else}}`/`{{senão}}`;
// - comentários `{{! ... }}` e `{{!-- ... --}}`.
importar { comecaCom, ehDigito, encontrarAPartir, escaparHtml } de "../utilidades/texto.delegua"
importar { ehDicionario, ehVetor } de "../utilidades/json.delegua"

funcao obterNomesCada(): texto[] { retorna ["each", "cada"] }
funcao obterNomesSe(): texto[] { retorna ["if", "se"] }
funcao obterNomesExceto(): texto[] { retorna ["unless", "senao", "senão", "exceto"] }
funcao obterNomesCom(): texto[] { retorna ["with", "com"] }
funcao obterNomesSenao(): texto[] { retorna ["else", "senao", "senão"] }

// ── Análise léxica: divide o modelo em textos e marcações ──

funcao separarMarcacoes(modelo: texto): vetor {
    var textoModelo: texto = "" + modelo
    var partes: vetor = []
    var nomesSenao: texto[] = obterNomesSenao()
    var posicao: inteiro = 0
    enquanto (posicao < textoModelo.tamanho()) {
        var abertura: inteiro = encontrarAPartir(textoModelo, "{{", posicao)
        se (abertura < 0) {
            var parteFinal: dicionário = { "tipoParte": "texto", "conteudo": textoModelo.subtexto(posicao, textoModelo.tamanho()) }
            partes.adicionar(parteFinal)
            sustar
        }
        se (abertura > posicao) {
            var parteTexto: dicionário = { "tipoParte": "texto", "conteudo": textoModelo.subtexto(posicao, abertura) }
            partes.adicionar(parteTexto)
        }
        var triplo: lógico = textoModelo.subtexto(abertura, abertura + 3) == "{{{"
        var fimMarcacao: texto = "}}"
        var inicioConteudo: inteiro = abertura + 2
        se (triplo) {
            fimMarcacao = "}}}"
            inicioConteudo = abertura + 3
        }
        se (textoModelo.subtexto(abertura, abertura + 5) == "{{!--") {
            fimMarcacao = "--}}"
        }
        var fechamento: inteiro = encontrarAPartir(textoModelo, fimMarcacao, inicioConteudo)
        se (fechamento < 0) {
            // Marcação sem fechamento: mantém o restante como texto.
            var parteResto: dicionário = { "tipoParte": "texto", "conteudo": textoModelo.subtexto(abertura, textoModelo.tamanho()) }
            partes.adicionar(parteResto)
            sustar
        }
        var conteudo: texto = textoModelo.subtexto(inicioConteudo, fechamento).aparar()
        posicao = fechamento + fimMarcacao.tamanho()
        se (conteudo.tamanho() > 0 e conteudo[0] == "!") { continua }
        se (triplo) {
            var parteBruta: dicionário = { "tipoParte": "bruto", "conteudo": conteudo }
            partes.adicionar(parteBruta)
        } senao se (conteudo.tamanho() > 0 e conteudo[0] == "#") {
            var corpoAbertura: texto = conteudo.subtexto(1, conteudo.tamanho()).aparar()
            var espaco: inteiro = corpoAbertura.encontrar(" ")
            var nomeBloco: texto = corpoAbertura
            var argumento: texto = ""
            se (espaco > 0) {
                nomeBloco = corpoAbertura.subtexto(0, espaco)
                argumento = corpoAbertura.subtexto(espaco + 1, corpoAbertura.tamanho()).aparar()
            }
            var parteAbertura: dicionário = { "tipoParte": "abertura", "conteudo": nomeBloco, "argumento": argumento }
            partes.adicionar(parteAbertura)
        } senao se (conteudo.tamanho() > 0 e conteudo[0] == "/") {
            var parteFechamento: dicionário = { "tipoParte": "fechamento", "conteudo": conteudo.subtexto(1, conteudo.tamanho()).aparar() }
            partes.adicionar(parteFechamento)
        } senao se (nomesSenao.inclui(conteudo) ou conteudo == "^") {
            var parteSenao: dicionário = { "tipoParte": "senao", "conteudo": conteudo }
            partes.adicionar(parteSenao)
        } senao {
            var parteVariavel: dicionário = { "tipoParte": "variavel", "conteudo": conteudo }
            partes.adicionar(parteVariavel)
        }
    }
    retorna partes
}

// ── Análise sintática: monta a árvore de nós ──
// Estado: { "partes", "posicao", "erro" }. Cada nó: { "tipoNo", "conteudo", "argumento", "filhos", "alternativa" }.

funcao analisarNos(estado: dicionário, nomeBlocoAberto: texto): vetor {
    var nos: vetor = []
    var partes: vetor = estado["partes"]
    enquanto (estado["posicao"] < partes.tamanho() e estado["erro"] == "") {
        var pos: inteiro = estado["posicao"]
        var parte: dicionário = partes[pos]
        var tipoParte: texto = parte["tipoParte"]
        var conteudoParte: texto = parte["conteudo"]
        se (tipoParte == "fechamento" ou tipoParte == "senao") {
            se (nomeBlocoAberto == "") {
                estado["erro"] = "Marcação '{{" + conteudoParte + "}}' sem bloco aberto."
            }
            retorna nos
        }
        estado["posicao"] = pos + 1
        se (tipoParte == "abertura") {
            var filhos: vetor = analisarNos(estado, conteudoParte)
            var alternativa: vetor = []
            var posAtual: inteiro = estado["posicao"]
            se (estado["erro"] == "" e posAtual < partes.tamanho()) {
                var proximaParte: dicionário = partes[posAtual]
                se (proximaParte["tipoParte"] == "senao") {
                    estado["posicao"] = posAtual + 1
                    alternativa = analisarNos(estado, conteudoParte)
                }
            }
            se (estado["erro"] != "") { retorna nos }
            var posFim: inteiro = estado["posicao"]
            se (posFim >= partes.tamanho()) {
                estado["erro"] = "Bloco '{{#" + conteudoParte + "}}' não foi fechado."
                retorna nos
            }
            var fechamento: dicionário = partes[posFim]
            var conteudoFechamento: texto = fechamento["conteudo"]
            se (conteudoFechamento != conteudoParte) {
                estado["erro"] = "Bloco '{{#" + conteudoParte + "}}' fechado com '{{/" + conteudoFechamento + "}}'."
                retorna nos
            }
            estado["posicao"] = posFim + 1
            var noBloco: dicionário = {
                "tipoNo": "bloco",
                "conteudo": conteudoParte,
                "argumento": parte["argumento"],
                "filhos": filhos,
                "alternativa": alternativa
            }
            nos.adicionar(noBloco)
        } senao {
            var semFilhos: vetor = []
            var noSimples: dicionário = {
                "tipoNo": tipoParte,
                "conteudo": conteudoParte,
                "argumento": "",
                "filhos": semFilhos,
                "alternativa": semFilhos
            }
            nos.adicionar(noSimples)
        }
    }
    var posResto: inteiro = estado["posicao"]
    se (nomeBlocoAberto != "" e estado["erro"] == "" e posResto >= partes.tamanho()) {
        estado["erro"] = "Bloco '{{#" + nomeBlocoAberto + "}}' não foi fechado."
    }
    retorna nos
}

// ── Resolução de valores ──
// Um contexto é { "dados", "pai", "indice", "chave", "primeiro", "ultimo" }; `pai` é nulo na raiz.

funcao criarContexto(dados: qualquer, pai: dicionário): dicionário {
    retorna { "dados": dados, "pai": pai, "indice": nulo, "chave": nulo, "primeiro": nulo, "ultimo": nulo }
}

// Resolve `caminho` no contexto e grava em estadoValor["encontrado"]/["resultado"].
funcao resolverCaminho(contexto: dicionário, caminho: texto, estadoValor: dicionário) {
    estadoValor["encontrado"] = falso
    estadoValor["resultado"] = nulo
    var atual: dicionário = contexto
    var restante: texto = caminho.aparar()
    enquanto (comecaCom(restante, "../")) {
        se (atual["pai"] != nulo) { atual = atual["pai"] }
        restante = restante.subtexto(3, restante.tamanho())
    }
    se (restante == "@index" ou restante == "@indice" ou restante == "@índice") {
        estadoValor["encontrado"] = atual["indice"] != nulo
        estadoValor["resultado"] = atual["indice"]
        retorna
    }
    se (restante == "@key" ou restante == "@chave") {
        estadoValor["encontrado"] = atual["chave"] != nulo
        estadoValor["resultado"] = atual["chave"]
        retorna
    }
    se (restante == "@first" ou restante == "@primeiro") {
        estadoValor["encontrado"] = verdadeiro
        estadoValor["resultado"] = atual["primeiro"] == verdadeiro
        retorna
    }
    se (restante == "@last" ou restante == "@ultimo" ou restante == "@último") {
        estadoValor["encontrado"] = verdadeiro
        estadoValor["resultado"] = atual["ultimo"] == verdadeiro
        retorna
    }
    var dados = atual["dados"]
    se (restante == "this" ou restante == "isto" ou restante == ".") {
        estadoValor["encontrado"] = verdadeiro
        estadoValor["resultado"] = dados
        retorna
    }
    se (comecaCom(restante, "this.")) { restante = restante.subtexto(5, restante.tamanho()) }
    senao se (comecaCom(restante, "isto.")) { restante = restante.subtexto(5, restante.tamanho()) }

    var segmentos: texto[] = restante.dividir(".")
    var valorAtual = dados
    para (var i: inteiro = 0; i < segmentos.tamanho(); i = i + 1) {
        var segmento: texto = segmentos[i]
        se (ehDicionario(valorAtual) e valorAtual.contem(segmento)) {
            valorAtual = valorAtual[segmento]
        } senao se (ehVetor(valorAtual) e segmento != "" e ehDigito(segmento[0])) {
            var posicaoVetor: inteiro = inteiro(segmento)
            var listaAtual: vetor = valorAtual
            se (posicaoVetor >= listaAtual.tamanho()) { retorna }
            valorAtual = listaAtual[posicaoVetor]
        } senao se (segmento == "length" ou segmento == "tamanho") {
            se (ehVetor(valorAtual)) {
                var vet: vetor = valorAtual
                valorAtual = vet.tamanho()
            } senao se (ehDicionario(valorAtual)) {
                var dic: dicionário = valorAtual
                valorAtual = dic.chaves().tamanho()
            } senao {
                retorna
            }
        } senao {
            retorna
        }
    }
    estadoValor["encontrado"] = verdadeiro
    estadoValor["resultado"] = valorAtual
}

funcao valorNoContexto(contexto: dicionário, caminho: texto): vetor {
    var estadoValor: dicionário = { "encontrado": falso, "resultado": nulo }
    var atual: dicionário = contexto
    resolverCaminho(atual, caminho, estadoValor)
    // Como no Handlebars, variáveis simples não encontradas são procuradas nos contextos acima.
    enquanto (nao estadoValor["encontrado"] e atual["pai"] != nulo e nao caminho.inclui("../") e nao comecaCom(caminho, "@")) {
        atual = atual["pai"]
        resolverCaminho(atual, caminho, estadoValor)
    }
    var lista: vetor = [estadoValor["resultado"]]
    retorna lista
}

funcao ehVerdadeiro(valor: qualquer): lógico {
    se (valor == nulo) { retorna falso }
    var tipoValor: texto = tipo de valor
    se (tipoValor == "lógico") { retorna valor }
    se (tipoValor == "texto") { retorna valor != "" }
    se (tipoValor == "número") { retorna valor != 0 }
    se (ehVetor(valor)) {
        var lista: vetor = valor
        retorna lista.tamanho() > 0
    }
    retorna verdadeiro
}

funcao comoTexto(valor: qualquer): texto {
    se (valor == nulo) { retorna "" }
    var tipoValor: texto = tipo de valor
    se (tipoValor == "texto") { retorna valor }
    se (tipoValor == "lógico") {
        se (valor) { retorna "true" }
        retorna "false"
    }
    se (ehVetor(valor)) {
        var lista: vetor = valor
        var partes: texto[] = []
        para (var i: inteiro = 0; i < lista.tamanho(); i = i + 1) {
            partes.adicionar(comoTexto(lista[i]))
        }
        retorna partes.juntar(",")
    }
    se (ehDicionario(valor)) { retorna "[object Object]" }
    retorna texto(valor)
}

// ── Renderização ──

funcao renderizarNos(nos: vetor, contexto: dicionário): texto {
    var saida: texto = ""
    para (var i: inteiro = 0; i < nos.tamanho(); i = i + 1) {
        var no: dicionário = nos[i]
        var tipoNo: texto = no["tipoNo"]
        se (tipoNo == "texto") {
            var textoNo: texto = no["conteudo"]
            saida = saida + textoNo
        } senao se (tipoNo == "variavel") {
            var resolvido: vetor = valorNoContexto(contexto, no["conteudo"])
            saida = saida + escaparHtml(comoTexto(resolvido[0]))
        } senao se (tipoNo == "bruto") {
            var resolvidoBruto: vetor = valorNoContexto(contexto, no["conteudo"])
            saida = saida + comoTexto(resolvidoBruto[0])
        } senao se (tipoNo == "bloco") {
            saida = saida + renderizarBloco(no, contexto)
        }
    }
    retorna saida
}

funcao renderizarBloco(no: dicionário, contexto: dicionário): texto {
    var nome: texto = no["conteudo"]
    var argumentoResolvido: vetor = valorNoContexto(contexto, no["argumento"])
    var alvo = argumentoResolvido[0]

    se (obterNomesSe().inclui(nome)) {
        se (ehVerdadeiro(alvo)) { retorna renderizarNos(no["filhos"], contexto) }
        retorna renderizarNos(no["alternativa"], contexto)
    }
    se (obterNomesExceto().inclui(nome)) {
        se (nao ehVerdadeiro(alvo)) { retorna renderizarNos(no["filhos"], contexto) }
        retorna renderizarNos(no["alternativa"], contexto)
    }
    se (obterNomesCom().inclui(nome)) {
        se (ehVerdadeiro(alvo)) {
            var contextoCom: dicionário = criarContexto(alvo, contexto)
            retorna renderizarNos(no["filhos"], contextoCom)
        }
        retorna renderizarNos(no["alternativa"], contexto)
    }
    se (obterNomesCada().inclui(nome)) {
        var saida: texto = ""
        se (ehVetor(alvo)) {
            var listaAlvo: vetor = alvo
            se (listaAlvo.tamanho() > 0) {
                para (var i: inteiro = 0; i < listaAlvo.tamanho(); i = i + 1) {
                    var contextoItem: dicionário = criarContexto(listaAlvo[i], contexto)
                    contextoItem["indice"] = i
                    contextoItem["primeiro"] = i == 0
                    contextoItem["ultimo"] = i == listaAlvo.tamanho() - 1
                    saida = saida + renderizarNos(no["filhos"], contextoItem)
                }
                retorna saida
            }
        }
        se (ehDicionario(alvo)) {
            var mapaAlvo: dicionário = alvo
            var chaves: texto[] = mapaAlvo.chaves()
            se (chaves.tamanho() > 0) {
                para (var j: inteiro = 0; j < chaves.tamanho(); j = j + 1) {
                    var chave: texto = chaves[j]
                    var contextoChave: dicionário = criarContexto(mapaAlvo[chave], contexto)
                    contextoChave["indice"] = j
                    contextoChave["chave"] = chave
                    contextoChave["primeiro"] = j == 0
                    contextoChave["ultimo"] = j == chaves.tamanho() - 1
                    saida = saida + renderizarNos(no["filhos"], contextoChave)
                }
                retorna saida
            }
        }
        retorna renderizarNos(no["alternativa"], contexto)
    }
    // Bloco desconhecido: trata como `se`.
    se (ehVerdadeiro(alvo)) { retorna renderizarNos(no["filhos"], contexto) }
    retorna renderizarNos(no["alternativa"], contexto)
}

// Renderiza o modelo com os dados. Devolve { "resultado": texto, "erro": "" }.
funcao renderizar(modelo: texto, dados: qualquer): dicionário {
    var partes: vetor = separarMarcacoes(modelo)
    var estado: dicionário = { "partes": partes, "posicao": 0, "erro": "" }
    var nos: vetor = analisarNos(estado, "")
    se (estado["erro"] != "") {
        retorna { "resultado": "", "erro": estado["erro"] }
    }
    var dadosRaiz = dados
    se (dadosRaiz == nulo) { dadosRaiz = {} }
    var contexto: dicionário = criarContexto(dadosRaiz, nulo)
    retorna { "resultado": renderizarNos(nos, contexto), "erro": "" }
}
