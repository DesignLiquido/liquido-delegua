// Documentação automática das rotas no formato OpenAPI 3.0 e página de visualização (ReDoc).
//
// As rotas vêm do roteador da aplicação. Descrições vêm dos decoradores `@rest.documentacao`
// e `@rest.resposta` escritos antes de cada `liquido.rotaX(...)`; o gerador do Líquido os lê
// dos arquivos de rota e os registra com `aplicacao.documentarRota`.
importar { escaparTextoJson } de "../utilidades/json.delegua"

// Nomes em português dos atributos dos decoradores → nomes OpenAPI.
funcao obterAtributosDocumentacao(): dicionário {
    retorna {
        "sumario": "summary",
        "sumário": "summary",
        "descricao": "description",
        "descrição": "description",
        "idOperacao": "operationId",
        "idOperação": "operationId",
        "etiquetas": "tags"
    }
}

funcao obterAtributosResposta(): dicionário {
    retorna {
        "descricao": "description",
        "descrição": "description",
        "formatos": "content"
    }
}

// "/clientes/:id" → "/clientes/{id}".
funcao caminhoOpenApi(caminho: texto): texto {
    var segmentos: texto[] = []
    para cada segmento em ("" + caminho).dividir("/") {
        se (segmento == "") { continua }
        se (segmento[0] == ":") {
            segmentos.adicionar("{" + segmento.subtexto(1, segmento.tamanho()) + "}")
        } senao {
            segmentos.adicionar(segmento)
        }
    }
    retorna "/" + segmentos.juntar("/")
}

// Converte os decoradores de uma rota ({ "documentacao": {..}, "respostas": [{..}] })
// na operação OpenAPI. Devolve { "operacao": {..}, "erros": [..] }.
funcao montarOperacao(caminho: texto, decoradores: dicionário): dicionário {
    var operacao: dicionário = {}
    var erros: texto[] = []
    var respostas: dicionário = {}
    var atributosDocumentacao: dicionário = obterAtributosDocumentacao()
    var atributosResposta: dicionário = obterAtributosResposta()

    se (decoradores != nulo e decoradores.contem("documentacao")) {
        var documentacaoRota: dicionário = decoradores["documentacao"]
        para cada nome em documentacaoRota.chaves() {
            se (atributosDocumentacao.contem(nome)) {
                var valorDocumentacao = documentacaoRota[nome]
                var chaveOpenApi: texto = atributosDocumentacao[nome]
                operacao[chaveOpenApi] = valorDocumentacao
            } senao {
                erros.adicionar("Atributo '" + nome + "' não é válido em @rest.documentacao.")
            }
        }
    }

    se (decoradores != nulo e decoradores.contem("respostas")) {
        var listaRespostas: vetor = decoradores["respostas"]
        para (var i: inteiro = 0; i < listaRespostas.tamanho(); i = i + 1) {
            var atributos: dicionário = listaRespostas[i]
            var codigo = nulo
            se (atributos.contem("codigo")) { codigo = atributos["codigo"] }
            se (atributos.contem("código")) { codigo = atributos["código"] }
            se (codigo == nulo) {
                erros.adicionar("Decorador @rest.resposta não possui atributo obrigatório 'código' ou 'codigo'.")
                continua
            }
            var respostaOpenApi: dicionário = { "description": "" }
            para cada nomeResposta em atributos.chaves() {
                se (nomeResposta == "codigo" ou nomeResposta == "código") { continua }
                se (nao atributosResposta.contem(nomeResposta)) {
                    erros.adicionar("Atributo '" + nomeResposta + "' não é válido em @rest.resposta.")
                    continua
                }
                var nomeOpenApi: texto = atributosResposta[nomeResposta]
                var valorResposta = atributos[nomeResposta]
                se (nomeOpenApi == "content") {
                    var conteudo: dicionário = {}
                    var formatosLista: texto[] = valorResposta
                    para (var indiceFormato: inteiro = 0; indiceFormato < formatosLista.tamanho(); indiceFormato = indiceFormato + 1) {
                        var formato: texto = formatosLista[indiceFormato]
                        var vazio: dicionário = {}
                        conteudo[formato] = vazio
                    }
                    respostaOpenApi["content"] = conteudo
                } senao {
                    respostaOpenApi[nomeOpenApi] = valorResposta
                }
            }
            respostas[texto(codigo)] = respostaOpenApi
        }
    }

    // Parâmetros de caminho, obrigatórios no OpenAPI.
    var parametros: vetor = []
    para cada segmento em ("" + caminho).dividir("/") {
        se (segmento != "" e segmento[0] == ":") {
            var esquema: dicionário = { "type": "string" }
            var parametro: dicionário = { "name": segmento.subtexto(1, segmento.tamanho()), "in": "path", "required": verdadeiro, "schema": esquema }
            parametros.adicionar(parametro)
        }
    }
    se (parametros.tamanho() > 0) { operacao["parameters"] = parametros }

    se (respostas.chaves().tamanho() == 0) {
        var respostaPadrao: dicionário = { "description": "Sucesso" }
        respostas["200"] = respostaPadrao
    }
    operacao["responses"] = respostas
    retorna { "operacao": operacao, "erros": erros }
}

funcao textoOuPadrao(valorConfiguracao: texto, padraoValor: texto): texto {
    se (valorConfiguracao == nulo ou valorConfiguracao == "") { retorna padraoValor }
    retorna valorConfiguracao
}

// Monta o documento OpenAPI da aplicação.
funcao documentar(aplicacao: qualquer): dicionário {
    var liquidoCfg: dicionário = aplicacao.configuracao["liquido"]
    var configuracaoAplicacao: dicionário = liquidoCfg["aplicacao"]
    var licencaCfg: dicionário = configuracaoAplicacao["licenca"]
    var licenca: dicionário = {
        "name": textoOuPadrao(licencaCfg["nome"], "MIT"),
        "url": textoOuPadrao(licencaCfg["url"], "https://github.com/DesignLiquido/liquido/LICENSE")
    }
    var informacoes: dicionário = {
        "description": textoOuPadrao(configuracaoAplicacao["descricao"], "Aplicação em Líquido"),
        "version": textoOuPadrao(configuracaoAplicacao["versao"], "0.0.1"),
        "title": textoOuPadrao(configuracaoAplicacao["nome"], "Aplicação Líquido"),
        "license": licenca
    }
    var caminhos: dicionário = {}
    var rotas: vetor = aplicacao.roteador.rotas
    para (var i: inteiro = 0; i < rotas.tamanho(); i = i + 1) {
        var rota: dicionário = rotas[i]
        var caminhoRota: texto = rota["caminho"]
        var metodoRota: texto = rota["metodo"]
        var chaveCaminho: texto = caminhoOpenApi(caminhoRota)
        se (nao caminhos.contem(chaveCaminho)) {
            var novoCaminho: dicionário = {}
            caminhos[chaveCaminho] = novoCaminho
        }
        var chaveDocumentacao: texto = metodoRota + " " + caminhoRota
        var decoradores: dicionário = nulo
        se (aplicacao.documentacaoRotas.contem(chaveDocumentacao)) {
            decoradores = aplicacao.documentacaoRotas[chaveDocumentacao]
        }
        var montada: dicionário = montarOperacao(caminhoRota, decoradores)
        var operacoesCaminho: dicionário = caminhos[chaveCaminho]
        operacoesCaminho[metodoRota.minusculo()] = montada["operacao"]
    }
    var servidores: vetor = []
    retorna { "openapi": "3.0.0", "servers": servidores, "info": informacoes, "paths": caminhos }
}

funcao paginaRedoc(enderecoEspecificacao: texto): texto {
    var opcoes: texto = "{\"theme\":{\"colors\":{\"primary\":{\"main\":\"#6EC5AB\"}},\"typography\":{\"fontFamily\":\"\\\"museo-sans\\\", 'Helvetica Neue', Helvetica, Arial, sans-serif\",\"fontSize\":\"15px\",\"lineHeight\":\"1.5\",\"code\":{\"code\":\"#87E8C7\",\"backgroundColor\":\"#4D4D4E\"}},\"menu\":{\"backgroundColor\":\"#ffffff\"}}}"
    retorna "<!DOCTYPE html>\n<html lang=\"pt\">\n<head>\n" +
        "    <meta charset=\"utf-8\">\n" +
        "    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n" +
        "    <title>API Docs</title>\n" +
        "    <style>body { margin: 0; padding: 0; }</style>\n" +
        "</head>\n<body>\n" +
        "    <div id=\"redoc-container\"></div>\n" +
        "    <script src=\"https://cdn.jsdelivr.net/npm/redoc@2.1.5/bundles/redoc.standalone.js\"></script>\n" +
        "    <script>Redoc.init(" + escaparTextoJson(enderecoEspecificacao) + ", " + opcoes + ", document.getElementById('redoc-container'));</script>\n" +
        "</body>\n</html>"
}
