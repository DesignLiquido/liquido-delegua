// Mapeamento de erros de execução para códigos do Líquido.
// `palavraChave` é comparada (em minúsculas) com a mensagem original do erro.
// `mensagem`, quando não vazia, é a explicação amigável em português; a mensagem original
// é preservada como detalhe técnico. LIQ99999 é o código de contingência.

funcao listaDeErros() {
    var lista = [
        { "codigo": "LIQ00001", "palavraChave": "não encontrado", "mensagem": "" },
        { "codigo": "LIQ00002", "palavraChave": "não foi definida", "mensagem": "" },
        { "codigo": "LIQ00003", "palavraChave": "inesperado", "mensagem": "" },
        { "codigo": "LIQ20001", "palavraChave": "cannot read propert", "mensagem": "Tentativa de acessar uma propriedade de um valor nulo ou indefinido." },
        { "codigo": "LIQ20001", "palavraChave": "propriedade 'mensagem' de um valor nulo", "mensagem": "Tentativa de acessar uma propriedade de um valor nulo ou indefinido." },
        { "codigo": "LIQ20002", "palavraChave": "is not a function", "mensagem": "Tentativa de chamar como função algo que não é uma função." },
        { "codigo": "LIQ20003", "palavraChave": "is not defined", "mensagem": "Uso de um nome que não foi definido." },
        { "codigo": "LIQ20003", "palavraChave": "variável não definida", "mensagem": "Uso de um nome que não foi definido." },
        { "codigo": "LIQ20004", "palavraChave": "só pode chamar função ou classe", "mensagem": "" },
        { "codigo": "LIQ10000", "palavraChave": "sqlite_", "mensagem": "O banco de dados rejeitou o comando executado." },
        { "codigo": "LIQ10000", "palavraChave": "constraint failed", "mensagem": "O banco de dados rejeitou o comando por violação de restrição." }
    ]
    retorna lista
}

// Devolve { "codigo", "mensagemAmigavel" } para a mensagem de erro.
funcao classificar(mensagemErro) {
    var textoErro = ("" + mensagemErro).minusculo()
    para cada item em listaDeErros() {
        se (textoErro.inclui(item["palavraChave"])) {
            retorna { "codigo": item["codigo"], "mensagemAmigavel": item["mensagem"] }
        }
    }
    retorna { "codigo": "LIQ99999", "mensagemAmigavel": "" }
}

// Texto da linha de erro mostrada no console e na resposta.
funcao descrever(mensagemErro, arquivoFonte) {
    var classificacao: dicionário = classificar(mensagemErro)
    var localizacao = ""
    se (arquivoFonte != nulo e arquivoFonte != "") { localizacao = " [Arquivo: " + arquivoFonte + "]" }
    var principal = mensagemErro
    var detalhe = ""
    se (classificacao["mensagemAmigavel"] != "") {
        principal = classificacao["mensagemAmigavel"]
        detalhe = " (detalhe técnico: " + mensagemErro + ")"
    }
    retorna classificacao["codigo"] + localizacao + ": " + principal + detalhe
}
