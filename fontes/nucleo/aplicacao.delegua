// Aplicação Líquido: registro de rotas, processamento de requisições e servidor HTTP.
//
// O processamento é feito por `processarRequisicao`, que recebe os dados já lidos da conexão
// e devolve a resposta HTTP como dicionário, sem depender de soquetes. O servidor (`servir`)
// apenas lê requisições pelo módulo `rede`, chama o processamento e escreve as respostas.
importar tudo como arquivos de "arquivos"
importar tudo como rede de "rede"
importar tudo como tempo de "tempo"
importar tudo como roteamento de "../roteador/roteador.delegua"
importar tudo como url de "../http/url.delegua"
importar tudo como mensagens de "../http/mensagens_http.delegua"
importar tudo como cookiesHttp de "../http/cookies.delegua"
importar tudo como mime de "../http/tipos_mime.delegua"
importar tudo como jsonLiquido de "../utilidades/json.delegua"
importar tudo como textos de "../utilidades/texto.delegua"
importar tudo como centro de "../configuracao/centro_configuracoes.delegua"
importar tudo como formatador de "../visoes/formatador_lmht.delegua"
importar tudo como paginas de "./paginas.delegua"
importar tudo como erros de "./erros.delegua"
importar tudo como requisicoes de "./requisicao.delegua"
importar tudo como respostas de "./resposta.delegua"
importar tudo como jwt de "../autenticacao/jwt.delegua"
importar tudo como documentacao de "../documentacao/open_api.delegua"

var tamanhoMaximoCabecalho = 65536
var tamanhoMaximoCorpo = 10485760

// ── Montagem de respostas HTTP (dicionários) ──

funcao novaRespostaHttp(codigoStatus) {
    var cabecalhos = []
    retorna { "status": codigoStatus, "cabecalhos": cabecalhos, "corpo": "", "arquivo": nulo }
}

funcao adicionarCabecalho(respostaHttp, nome, valorCabecalho) {
    var par = [nome, "" + valorCabecalho]
    respostaHttp["cabecalhos"].adicionar(par)
}

funcao obterCabecalho(respostaHttp, nome) {
    var nomeMinusculo = nome.minusculo()
    para cada par em respostaHttp["cabecalhos"] {
        se (par[0].minusculo() == nomeMinusculo) { retorna par[1] }
    }
    retorna nulo
}

funcao respostaJson(codigoStatus, dados) {
    var respostaHttp: dicionário = novaRespostaHttp(codigoStatus)
    adicionarCabecalho(respostaHttp, "Content-Type", "application/json; charset=utf-8")
    respostaHttp["corpo"] = jsonLiquido.serializar(dados)
    retorna respostaHttp
}

funcao respostaTexto(codigoStatus, conteudo, tipoConteudo) {
    var respostaHttp: dicionário = novaRespostaHttp(codigoStatus)
    adicionarCabecalho(respostaHttp, "Content-Type", tipoConteudo)
    respostaHttp["corpo"] = "" + conteudo
    retorna respostaHttp
}

funcao prefereJson(requisicao) {
    var aceite = requisicao.cabecalho("accept")
    se (aceite == nulo) { retorna falso }
    retorna aceite.inclui("application/json") ou aceite.inclui("application/*") ou aceite.inclui("*/*")
}

// ── Cabeçalhos de segurança (equivalentes aos padrões do Helmet) ──

funcao aplicarCabecalhosSeguranca(respostaHttp, caminho) {
    // A página de documentação carrega o ReDoc de uma CDN, então não recebe a política de conteúdo.
    se (nao textos.comecaCom(caminho, "/docs")) {
        adicionarCabecalho(respostaHttp, "Content-Security-Policy", "default-src 'self';base-uri 'self';font-src 'self' https: data:;form-action 'self';frame-ancestors 'self';img-src 'self' data:;object-src 'none';script-src 'self';script-src-attr 'none';style-src 'self' https: 'unsafe-inline';upgrade-insecure-requests")
    }
    adicionarCabecalho(respostaHttp, "Cross-Origin-Opener-Policy", "same-origin")
    adicionarCabecalho(respostaHttp, "Cross-Origin-Resource-Policy", "same-origin")
    adicionarCabecalho(respostaHttp, "Origin-Agent-Cluster", "?1")
    adicionarCabecalho(respostaHttp, "Referrer-Policy", "no-referrer")
    adicionarCabecalho(respostaHttp, "Strict-Transport-Security", "max-age=31536000; includeSubDomains")
    adicionarCabecalho(respostaHttp, "X-Content-Type-Options", "nosniff")
    adicionarCabecalho(respostaHttp, "X-DNS-Prefetch-Control", "off")
    adicionarCabecalho(respostaHttp, "X-Download-Options", "noopen")
    adicionarCabecalho(respostaHttp, "X-Frame-Options", "SAMEORIGIN")
    adicionarCabecalho(respostaHttp, "X-Permitted-Cross-Domain-Policies", "none")
    adicionarCabecalho(respostaHttp, "X-XSS-Protection", "0")
}

// ── CORS ──

funcao origensCors(configuracaoRoteador) {
    var origens = configuracaoRoteador["origensCors"]
    var lista = []
    se (origens == nulo) {
        lista.adicionar("*")
        retorna lista
    }
    var tipoOrigens = tipo de origens
    se (tipoOrigens == "texto") {
        para cada origem em origens.dividir(",") {
            var aparada = origem.aparar()
            se (aparada != "") { lista.adicionar(aparada) }
        }
    } senao {
        para cada origemVetor em origens { lista.adicionar(("" + origemVetor).aparar()) }
    }
    se (lista.tamanho() == 0) { lista.adicionar("*") }
    retorna lista
}

// Cabeçalhos CORS (como o pacote `cors`). Devolve verdadeiro se a requisição é uma pré-verificação.
funcao aplicarCors(respostaHttp, requisicao, configuracaoRoteador) {
    var origens: vetor = origensCors(configuracaoRoteador)
    var origem = requisicao.cabecalho("origin")
    se (origens.tamanho() == 1 e origens[0] == "*") {
        adicionarCabecalho(respostaHttp, "Access-Control-Allow-Origin", "*")
    } senao {
        se (origem != nulo e origens.inclui(origem)) {
            adicionarCabecalho(respostaHttp, "Access-Control-Allow-Origin", origem)
        }
        adicionarCabecalho(respostaHttp, "Vary", "Origin")
    }
    se (requisicao.metodo == "OPTIONS" e requisicao.cabecalho("access-control-request-method") != nulo) {
        adicionarCabecalho(respostaHttp, "Access-Control-Allow-Methods", "GET,HEAD,PUT,PATCH,POST,DELETE")
        var cabecalhosPedidos = requisicao.cabecalho("access-control-request-headers")
        se (cabecalhosPedidos != nulo) {
            adicionarCabecalho(respostaHttp, "Access-Control-Allow-Headers", cabecalhosPedidos)
            adicionarCabecalho(respostaHttp, "Vary", "Access-Control-Request-Headers")
        }
        retorna verdadeiro
    }
    retorna falso
}

// ── Corpo da requisição ──

// Interpreta o corpo segundo o Content-Type. Devolve { "erro": texto, "corpo": .. }.
funcao interpretarCorpo(requisicao, configuracaoRoteador) {
    var vazio = {}
    var textoCorpo = requisicao.corpoTexto
    se (nao configuracaoRoteador["bodyParser"] e nao configuracaoRoteador["json"]) {
        retorna { "erro": "", "corpo": vazio }
    }
    se (textoCorpo == "") { retorna { "erro": "", "corpo": vazio } }
    var tipoConteudo = requisicao.cabecalho("content-type")
    se (tipoConteudo == nulo) { tipoConteudo = "" }
    tipoConteudo = tipoConteudo.minusculo()
    se (tipoConteudo.inclui("application/json") ou tipoConteudo.inclui("+json")) {
        var analisado = jsonLiquido.analisarJson(textoCorpo)
        se (analisado["erro"] != "") {
            retorna { "erro": "JSON inválido no corpo da requisição: " + analisado["erro"], "corpo": vazio }
        }
        retorna { "erro": "", "corpo": analisado["resultado"] }
    }
    se (tipoConteudo.inclui("application/x-www-form-urlencoded")) {
        retorna { "erro": "", "corpo": url.analisarConsulta(textoCorpo) }
    }
    retorna { "erro": "", "corpo": textoCorpo }
}

// ── Autenticação por JWT ──

funcao autenticacaoAtiva(aplicacao) {
    var liquido = aplicacao.configuracao["liquido"]
    retorna liquido["roteador"]["passport"] == verdadeiro ou liquido["autenticacao"]["tecnologia"] == "jwt"
}

funcao autenticarRequisicao(aplicacao, requisicao) {
    se (nao autenticacaoAtiva(aplicacao) ou aplicacao.chaveSecreta == nulo) { retorna }
    var autorizacao = requisicao.cabecalho("authorization")
    se (autorizacao == nulo) { retorna }
    var token = autorizacao.aparar()
    se (textos.comecaCom(token.minusculo(), "bearer ")) { token = token.subtexto(7, token.tamanho()).aparar() }
    var resultado = jwt.decodificarToken(token, aplicacao.chaveSecreta)
    se (resultado["valido"]) {
        requisicao.usuario = resultado["conteudo"]
        requisicao.autenticado = verdadeiro
    }
}

// POST /token: troca e-mail e senha (de `usuarios.json`) por um token JWT.
funcao emitirToken(aplicacao, requisicao) {
    var corpo = requisicao.corpo
    var naoAutorizado = { "erro": "Não autorizado" }
    se (aplicacao.chaveSecreta == nulo ou nao jsonLiquido.ehDicionario(corpo)) { retorna respostaJson(401, naoAutorizado) }
    se (nao corpo.contem("email") ou nao corpo.contem("senha")) { retorna respostaJson(401, naoAutorizado) }
    para cada usuario em aplicacao.usuarios {
        se (jsonLiquido.ehDicionario(usuario) e usuario.contem("email") e usuario.contem("senha") e usuario["email"] == corpo["email"] e usuario["senha"] == corpo["senha"]) {
            var conteudoToken = { "id": usuario["id"], "iat": jwt.agoraEmSegundos() }
            var token = jwt.codificarToken(conteudoToken, aplicacao.chaveSecreta)
            var dadosToken = { "token": token }
            retorna respostaJson(200, dadosToken)
        }
    }
    retorna respostaJson(401, naoAutorizado)
}

// ── Arquivos estáticos ──

// Procura um arquivo estático para o caminho. Devolve o caminho no disco ou nulo.
funcao procurarArquivoEstatico(aplicacao, caminho) {
    var segmentos = url.segmentosCaminho(caminho)
    se (segmentos == nulo) { retorna nulo }
    para cada diretorio em aplicacao.diretoriosEstaticos {
        var candidato = diretorio
        para cada segmento em segmentos { candidato = arquivos.juntarCaminhos(candidato, segmento) }
        se (arquivos.eArquivo(candidato)) { retorna candidato }
        se (arquivos.eDiretorio(candidato)) {
            var indice = arquivos.juntarCaminhos(candidato, "index.html")
            se (arquivos.eArquivo(indice)) { retorna indice }
        }
    }
    retorna nulo
}

funcao respostaArquivoEstatico(caminhoArquivo) {
    var tipoConteudo = mime.tipoPorCaminho(caminhoArquivo)
    var respostaHttp: dicionário = novaRespostaHttp(200)
    adicionarCabecalho(respostaHttp, "Content-Type", tipoConteudo)
    adicionarCabecalho(respostaHttp, "Cache-Control", "public, max-age=0")
    se (mime.ehTexto(caminhoArquivo)) {
        var conteudo = arquivos.lerTexto(caminhoArquivo)
        se (conteudo == nulo) { retorna respostaTexto(500, "Não foi possível ler o arquivo.", "text/plain; charset=utf-8") }
        respostaHttp["corpo"] = conteudo
    } senao {
        // Arquivos binários são enviados diretamente do disco pelo servidor.
        respostaHttp["arquivo"] = caminhoArquivo
    }
    retorna respostaHttp
}

// ── Erros ──

funcao respostaErroInterno(aplicacao, mensagemErro, arquivoFonte) {
    var linhaErro = erros.descrever(mensagemErro, arquivoFonte)
    escreva("[Liquido] " + linhaErro)
    se (aplicacao.configuracao["liquido"]["arquetipo"] == "mvc") {
        var linhas = [linhaErro]
        retorna respostaTexto(500, paginas.paginaErro(linhas), "text/html; charset=utf-8")
    }
    var detalhes = [linhaErro]
    var corpoErro = { "mensagem": "Ocorreu um erro interno na aplicação.", "detalhes": detalhes }
    retorna respostaJson(500, corpoErro)
}

// ── Conversão da Resposta da rota em resposta HTTP ──

funcao caminhoDaVisao(caminhoRota, nomeVisao) {
    se (nomeVisao == nulo) { retorna caminhoRota }
    var partes = ("" + caminhoRota).dividir("/")
    var mantidas = []
    para (var i = 0; i < partes.tamanho() - 1; i = i + 1) { mantidas.adicionar(partes[i]) }
    retorna mantidas.juntar("/") + "/" + nomeVisao
}

funcao converterResposta(aplicacao, requisicao, resposta, arquivoFonte) {
    var codigoStatus = 200
    se (resposta.statusHttp != nulo) { codigoStatus = resposta.statusHttp }
    var respostaHttp: dicionário = novaRespostaHttp(codigoStatus)

    se (resposta.destino != nulo) {
        se (codigoStatus < 300 ou codigoStatus > 399) { codigoStatus = 302 }
        respostaHttp = respostaTexto(codigoStatus, "Found. Redirecting to " + resposta.destino, "text/plain; charset=utf-8")
        adicionarCabecalho(respostaHttp, "Location", resposta.destino)
    } senao se (resposta.usarLmht) {
        var visao = caminhoDaVisao(requisicao.rota, resposta.visao)
        var valores = resposta.valores
        se (valores == nulo) { valores = {} }
        var formatado = formatador.formatar(aplicacao.diretorioBase, visao, valores)
        se (formatado["erro"] != "") {
            escreva("[Liquido] Erro ao processar LMHT: " + formatado["erro"])
            respostaHttp = respostaTexto(500, "Erro ao processar visualizacao LMHT.", "text/plain; charset=utf-8")
        } senao {
            respostaHttp = respostaTexto(codigoStatus, formatado["resultado"], "text/html; charset=utf-8")
        }
    } senao se (resposta.temJson) {
        respostaHttp = respostaJson(codigoStatus, resposta.respostaJson)
    } senao se (resposta.mensagem != nulo) {
        var mensagem = "" + resposta.mensagem
        var tipoMensagem = "text/plain; charset=utf-8"
        se (textos.comecaCom(mensagem.aparar(), "<?xml")) { tipoMensagem = "application/xml; charset=utf-8" }
        respostaHttp = respostaTexto(codigoStatus, mensagem, tipoMensagem)
    } senao {
        respostaHttp = respostaTexto(codigoStatus, "", "text/plain; charset=utf-8")
    }

    se (resposta.tipoDefinido != nulo) {
        var semTipo = []
        para cada par em respostaHttp["cabecalhos"] {
            se (par[0].minusculo() != "content-type") { semTipo.adicionar(par) }
        }
        respostaHttp["cabecalhos"] = semTipo
        adicionarCabecalho(respostaHttp, "Content-Type", resposta.tipoDefinido)
    }
    para cada parAdicional em resposta.cabecalhosAdicionais {
        adicionarCabecalho(respostaHttp, parAdicional[0], parAdicional[1])
    }
    para cada definicao em resposta.cookiesDefinidos {
        adicionarCabecalho(respostaHttp, "Set-Cookie", cookiesHttp.montarSetCookie(definicao[0], definicao[1], definicao[2]))
    }
    retorna respostaHttp
}

// ── Execução da rota ──

funcao executarRota(aplicacao, rota, requisicao) {
    var resposta = respostas.criarResposta()
    var funcoes = rota["funcoes"]
    var arquivoFonte = rota["arquivo"]
    para (var i = 0; i < funcoes.tamanho(); i = i + 1) {
        var funcaoRota = funcoes[i]
        var falhou = falso
        var mensagemErro = ""
        tente {
            funcaoRota(requisicao, resposta)
        } pegue (erro) {
            falhou = verdadeiro
            se (erro == nulo) { mensagemErro = "Erro desconhecido." } senao { mensagemErro = "" + erro.mensagem }
        }
        se (falhou) { retorna respostaErroInterno(aplicacao, mensagemErro, arquivoFonte) }
        // Middlewares que já definiram uma resposta interrompem a cadeia.
        se (i < funcoes.tamanho() - 1 e resposta.definida()) { sustar }
    }
    retorna converterResposta(aplicacao, requisicao, resposta, arquivoFonte)
}

// ── Processamento de uma requisição ──

funcao montarRequisicao(aplicacao, dados) {
    var requisicao = requisicoes.criarRequisicao()
    var partes = url.separarAlvo(dados["alvo"])
    requisicao.metodo = dados["metodo"]
    requisicao.url = dados["alvo"]
    requisicao.versao = dados["versao"]
    requisicao.cabecalhos = dados["cabecalhos"]
    requisicao.caminho = url.normalizarCaminho(partes["caminho"])
    requisicao.parametrosCaminho = requisicao.caminho
    requisicao.parametrosPesquisa = url.analisarConsulta(partes["consulta"])
    requisicao.corpoTexto = dados["corpo"]
    var configuracaoRoteador = aplicacao.configuracao["liquido"]["roteador"]
    se (configuracaoRoteador["cookieParser"]) {
        requisicao.cookies = cookiesHttp.analisarCookies(requisicao.cabecalho("cookie"))
    }
    retorna requisicao
}

// Resolve a rota da requisição e a executa; trata /token, 405, 400 e 404.
funcao resolverEExecutar(aplicacao, requisicao) {
    var metodo = requisicao.metodo
    var caminho = requisicao.caminho
    var resolucao = aplicacao.roteador.resolver(metodo, caminho)
    var situacao = resolucao["situacao"]
    se (situacao == "encontrada") {
        var rota = resolucao["rota"]
        requisicao.parametros = resolucao["parametros"]
        requisicao.rota = rota["caminho"]
        retorna executarRota(aplicacao, rota, requisicao)
    }
    se (metodo == "POST" e caminho == "/token" e autenticacaoAtiva(aplicacao)) {
        retorna emitirToken(aplicacao, requisicao)
    }
    se (situacao == "metodoNaoPermitido") {
        var permitidos = resolucao["metodos"].juntar(", ")
        var resposta405: dicionário = respostaTexto(200, permitidos, "text/plain; charset=utf-8")
        se (metodo != "OPTIONS") {
            var corpo405 = { "erro": "Método não permitido", "metodosAceitos": permitidos }
            resposta405 = respostaJson(405, corpo405)
        }
        adicionarCabecalho(resposta405, "Allow", permitidos)
        retorna resposta405
    }
    se (situacao == "caminhoInvalido") {
        var corpo400 = { "erro": "Caminho inválido", "caminho": caminho }
        retorna respostaJson(400, corpo400)
    }
    se (prefereJson(requisicao)) {
        var corpo404 = { "erro": "Rota não encontrada", "caminho": caminho, "metodo": metodo }
        retorna respostaJson(404, corpo404)
    }
    retorna respostaTexto(404, paginas.paginaNaoEncontrada(metodo, caminho), "text/html; charset=utf-8")
}

// `dados`: { "metodo", "alvo", "versao", "cabecalhos", "corpo" }.
// Devolve { "status", "cabecalhos": [[nome, valor]], "corpo", "arquivo" }.
funcao processarRequisicao(aplicacao, dados) {
    var configuracaoLiquido = aplicacao.configuracao["liquido"]
    var configuracaoRoteador = configuracaoLiquido["roteador"]
    var requisicao = montarRequisicao(aplicacao, dados)
    var caminho = requisicao.caminho
    var metodo = requisicao.metodo

    var cabecalhosComuns: dicionário = novaRespostaHttp(200)
    se (configuracaoRoteador["helmet"]) { aplicarCabecalhosSeguranca(cabecalhosComuns, caminho) }
    // `respondida` indica se uma etapa já montou a resposta.
    var respondida = falso
    var respostaHttp: dicionário = novaRespostaHttp(200)

    se (configuracaoRoteador["cors"]) {
        se (aplicarCors(cabecalhosComuns, requisicao, configuracaoRoteador)) {
            respostaHttp = novaRespostaHttp(204)
            respondida = verdadeiro
        }
    }

    se (nao respondida e (metodo == "GET" ou metodo == "HEAD")) {
        se (caminho == "/docs/openapi.json") {
            respostaHttp = respostaJson(200, documentacao.documentar(aplicacao))
            respondida = verdadeiro
        } senao se (caminho == "/docs") {
            respostaHttp = respostaTexto(200, documentacao.paginaRedoc("/docs/openapi.json"), "text/html; charset=utf-8")
            respondida = verdadeiro
        } senao {
            var arquivoEstatico = procurarArquivoEstatico(aplicacao, caminho)
            se (arquivoEstatico != nulo) {
                respostaHttp = respostaArquivoEstatico(arquivoEstatico)
                respondida = verdadeiro
            }
        }
    }

    se (nao respondida) {
        var corpoInterpretado: dicionário = interpretarCorpo(requisicao, configuracaoRoteador)
        se (corpoInterpretado["erro"] != "") {
            var erroCorpo = { "erro": corpoInterpretado["erro"] }
            respostaHttp = respostaJson(400, erroCorpo)
            respondida = verdadeiro
        } senao {
            requisicao.corpo = corpoInterpretado["corpo"]
        }
    }

    se (nao respondida) {
        autenticarRequisicao(aplicacao, requisicao)
        respostaHttp = resolverEExecutar(aplicacao, requisicao)
    }

    // Cabeçalhos comuns (segurança e CORS) vão antes dos definidos pela rota.
    var cabecalhosFinais = cabecalhosComuns["cabecalhos"]
    para cada par em respostaHttp["cabecalhos"] { cabecalhosFinais.adicionar(par) }
    respostaHttp["cabecalhos"] = cabecalhosFinais
    respostaHttp["incluirCorpo"] = metodo != "HEAD"
    retorna respostaHttp
}

// ── Servidor HTTP ──

funcao registrarAcesso(aplicacao, metodo, alvo, respostaHttp, inicioMs) {
    var configuracaoLiquido = aplicacao.configuracao["liquido"]
    var duracao = tempo.monotonicoMilissegundos() - inicioMs
    var codigo = respostaHttp["status"]
    se (configuracaoLiquido["roteador"]["morgan"]) {
        escreva(metodo + " " + alvo + " " + texto(codigo) + " " + texto(duracao) + " ms - " + texto(mensagens.tamanhoEmBytes(respostaHttp["corpo"])))
    } senao se (configuracaoLiquido["verboso"] ou codigo >= 500) {
        var situacao = "aceito"
        se (codigo >= 500) { situacao = "rejeitado" }
        escreva("[Liquido] " + metodo + " " + alvo + " → " + situacao + " (" + texto(codigo) + ") (" + texto(duracao) + " ms)")
    }
}

// Lê um corpo com `Transfer-Encoding: chunked`. Devolve o texto, ou nulo em caso de erro.
funcao lerCorpoEmPartes(conexao, limiteMs) {
    var corpo = ""
    var limitePartes = 100000
    enquanto (limitePartes > 0) {
        limitePartes = limitePartes - 1
        var linhaTamanho = rede.lerAte(conexao, "\r\n", 1024, limiteMs)
        se (linhaTamanho == nulo) { retorna nulo }
        var tamanhoHex = linhaTamanho.aparar().dividir(";")[0].minusculo()
        var tamanhoParte = 0
        para cada digito em tamanhoHex {
            var valorDigito = "0123456789abcdef".encontrar(digito)
            se (valorDigito < 0) { retorna nulo }
            tamanhoParte = tamanhoParte * 16 + valorDigito
        }
        se (tamanhoParte == 0) {
            rede.lerAte(conexao, "\r\n", 1024, limiteMs)
            retorna corpo
        }
        se (corpo.tamanho() + tamanhoParte > tamanhoMaximoCorpo) { retorna nulo }
        var parte = rede.lerAte(conexao, "", tamanhoParte, limiteMs)
        se (parte == nulo) { retorna nulo }
        corpo = corpo + parte
        rede.lerAte(conexao, "\r\n", 2, limiteMs)
    }
    retorna nulo
}

funcao responder(conexao, respostaHttp) {
    var incluirCorpo = verdadeiro
    se (respostaHttp.contem("incluirCorpo")) { incluirCorpo = respostaHttp["incluirCorpo"] }
    se (respostaHttp["arquivo"] != nulo) {
        rede.escrever(conexao, mensagens.montarInicioResposta(respostaHttp["status"], respostaHttp["cabecalhos"]))
        se (incluirCorpo) { rede.escreverArquivo(conexao, respostaHttp["arquivo"]) }
        retorna
    }
    rede.escrever(conexao, mensagens.montarResposta(respostaHttp["status"], respostaHttp["cabecalhos"], respostaHttp["corpo"], incluirCorpo))
}

funcao responderErroConexao(conexao, codigoStatus, mensagem) {
    var cabecalhos = [["Content-Type", "text/plain; charset=utf-8"]]
    rede.escrever(conexao, mensagens.montarResposta(codigoStatus, cabecalhos, mensagem, verdadeiro))
}

// Atende uma conexão já aceita: lê a requisição, processa e responde.
funcao atenderConexao(aplicacao, conexao) {
    var limiteMs = aplicacao.configuracao["liquido"]["roteador"]["tempoLimite"]
    var inicioMs = tempo.monotonicoMilissegundos()
    tente {
        var cabecalho = rede.lerAte(conexao, "\r\n\r\n", tamanhoMaximoCabecalho, limiteMs)
        se (cabecalho == nulo ou cabecalho == "") {
            rede.fechar(conexao)
            retorna
        }
        se (nao textos.terminaCom(cabecalho, "\r\n\r\n") e nao textos.terminaCom(cabecalho, "\n\n")) {
            responderErroConexao(conexao, 431, "Cabeçalhos da requisição muito grandes ou incompletos.")
            rede.fechar(conexao)
            retorna
        }
        var dados = mensagens.analisarCabecalhoRequisicao(cabecalho)
        se (dados["erro"] != "") {
            responderErroConexao(conexao, 400, dados["erro"])
            rede.fechar(conexao)
            retorna
        }
        var cabecalhos = dados["cabecalhos"]
        var corpo = ""
        se (cabecalhos.contem("expect") e cabecalhos["expect"].minusculo() == "100-continue") {
            rede.escrever(conexao, "HTTP/1.1 100 Continue\r\n\r\n")
        }
        se (cabecalhos.contem("transfer-encoding") e cabecalhos["transfer-encoding"].minusculo().inclui("chunked")) {
            corpo = lerCorpoEmPartes(conexao, limiteMs)
            se (corpo == nulo) {
                responderErroConexao(conexao, 400, "Corpo da requisição inválido.")
                rede.fechar(conexao)
                retorna
            }
        } senao se (cabecalhos.contem("content-length")) {
            var tamanhoCorpo = inteiro(cabecalhos["content-length"])
            se (tamanhoCorpo > tamanhoMaximoCorpo) {
                responderErroConexao(conexao, 413, "Corpo da requisição muito grande.")
                rede.fechar(conexao)
                retorna
            }
            se (tamanhoCorpo > 0) {
                corpo = rede.lerAte(conexao, "", tamanhoCorpo, limiteMs)
                se (corpo == nulo) { corpo = "" }
            }
        }
        dados["corpo"] = corpo
        var respostaHttp: dicionário = processarRequisicao(aplicacao, dados)
        responder(conexao, respostaHttp)
        registrarAcesso(aplicacao, dados["metodo"], dados["alvo"], respostaHttp, inicioMs)
    } pegue (erro) {
        var mensagem = "Erro desconhecido."
        se (erro != nulo) { mensagem = "" + erro.mensagem }
        escreva("[Liquido] Erro ao atender conexão: " + mensagem)
        tente {
            responderErroConexao(conexao, 500, "Erro interno do servidor.")
        } pegue (erroResposta) {
        }
    }
    rede.fechar(conexao)
}

// ── Registro de rotas ──

// Objeto `liquido` disponível nos arquivos de rota. Cada instância está ligada a um arquivo
// e ao caminho de rota derivado dele.
classe RegistradorRotas {
    aplicacao: qualquer
    caminho: texto
    arquivo: texto

    construtor(aplicacao, caminho, arquivo) {
        isto.aplicacao = aplicacao
        isto.caminho = caminho
        isto.arquivo = arquivo
    }

    rotaGet(...funcoes) { retorna isto.aplicacao.adicionarRota("rotaGet", isto.caminho, funcoes, isto.arquivo) }
    rotaPost(...funcoes) { retorna isto.aplicacao.adicionarRota("rotaPost", isto.caminho, funcoes, isto.arquivo) }
    rotaPut(...funcoes) { retorna isto.aplicacao.adicionarRota("rotaPut", isto.caminho, funcoes, isto.arquivo) }
    rotaDelete(...funcoes) { retorna isto.aplicacao.adicionarRota("rotaDelete", isto.caminho, funcoes, isto.arquivo) }
    rotaPatch(...funcoes) { retorna isto.aplicacao.adicionarRota("rotaPatch", isto.caminho, funcoes, isto.arquivo) }
    rotaCopy(...funcoes) { retorna isto.aplicacao.adicionarRota("rotaCopy", isto.caminho, funcoes, isto.arquivo) }
    rotaHead(...funcoes) { retorna isto.aplicacao.adicionarRota("rotaHead", isto.caminho, funcoes, isto.arquivo) }
    rotaOptions(...funcoes) { retorna isto.aplicacao.adicionarRota("rotaOptions", isto.caminho, funcoes, isto.arquivo) }
    rotaPurge(...funcoes) { retorna isto.aplicacao.adicionarRota("rotaPurge", isto.caminho, funcoes, isto.arquivo) }
    rotaLock(...funcoes) { retorna isto.aplicacao.adicionarRota("rotaLock", isto.caminho, funcoes, isto.arquivo) }
    rotaUnlock(...funcoes) { retorna isto.aplicacao.adicionarRota("rotaUnlock", isto.caminho, funcoes, isto.arquivo) }
    rotaPropfind(...funcoes) { retorna isto.aplicacao.adicionarRota("rotaPropfind", isto.caminho, funcoes, isto.arquivo) }
    rotaLink(...funcoes) { retorna isto.aplicacao.adicionarRota("rotaLink", isto.caminho, funcoes, isto.arquivo) }
    rotaUnlink(...funcoes) { retorna isto.aplicacao.adicionarRota("rotaUnlink", isto.caminho, funcoes, isto.arquivo) }
    rotaView(...funcoes) { retorna isto.aplicacao.adicionarRota("rotaView", isto.caminho, funcoes, isto.arquivo) }

    // Middleware que responde 401 quando a requisição não traz um token JWT válido.
    exigirAutenticacao() {
        retorna funcao(requisicao, resposta) {
            se (nao requisicao.autenticado) {
                resposta.status(401).json({ "erro": "Não autorizado" })
            }
        }
    }
}

classe Aplicacao {
    diretorioBase: texto
    configuracao: dicionário
    errosConfiguracao: vetor
    configuracaoEncontrada: lógico
    roteador: qualquer
    diretoriosEstaticos: vetor
    chaveSecreta: qualquer
    usuarios: vetor
    // Decoradores de documentação por "MÉTODO /caminho" (preenchidos pelo gerador).
    documentacaoRotas: dicionário
    parar: lógico

    construtor(diretorioBase) {
        isto.diretorioBase = diretorioBase
        var carregada = centro.carregar(diretorioBase)
        isto.configuracao = carregada["configuracao"]
        isto.errosConfiguracao = carregada["erros"]
        isto.configuracaoEncontrada = carregada["encontrado"]
        isto.roteador = roteamento.criarRoteador()
        isto.parar = falso
        isto.chaveSecreta = nulo
        isto.usuarios = []
        isto.documentacaoRotas = {}

        var liquido = isto.configuracao["liquido"]
        isto.diretoriosEstaticos = []
        var diretorioEstatico = arquivos.juntarCaminhos(diretorioBase, liquido["roteador"]["diretorioEstatico"])
        isto.diretoriosEstaticos.adicionar(diretorioEstatico)
        var diretorioEstilos = arquivos.juntarCaminhos(diretorioBase, liquido["estilos"]["diretorioBase"])
        se (arquivos.caminhoAbsoluto(diretorioEstilos) != arquivos.caminhoAbsoluto(diretorioEstatico)) {
            isto.diretoriosEstaticos.adicionar(diretorioEstilos)
        }

        para cada erroConfiguracao em isto.errosConfiguracao {
            escreva("[Liquido] Erro de configuração: " + erroConfiguracao)
        }

        se (autenticacaoAtiva(isto)) {
            isto.chaveSecreta = centro.variavelAmbiente(diretorioBase, "chaveSecreta")
            se (isto.chaveSecreta == nulo) {
                escreva("[Liquido] Autenticação JWT ativa, mas a variável 'chaveSecreta' não foi definida (ambiente ou arquivo .ambiente). Autenticação não será ativada.")
            }
            var textoUsuarios = arquivos.lerTexto(arquivos.juntarCaminhos(diretorioBase, "usuarios.json"))
            se (textoUsuarios != nulo) {
                var usuariosLidos = jsonLiquido.analisarJson(textoUsuarios)
                se (usuariosLidos["erro"] == "" e jsonLiquido.ehVetor(usuariosLidos["resultado"])) {
                    isto.usuarios = usuariosLidos["resultado"]
                } senao {
                    escreva("[Liquido] Arquivo usuarios.json inválido: esperado um vetor de { \"id\", \"email\", \"senha\" }.")
                }
            }
        }
    }

    // Objeto `liquido` para um arquivo de rota.
    registrador(caminho, arquivo) {
        retorna RegistradorRotas(isto, caminho, arquivo)
    }

    adicionarRota(nomeMetodoRota, caminho, funcoes, arquivo) {
        var metodo: texto = roteamento.metodoDeRegistro(nomeMetodoRota)
        se (metodo == "") {
            escreva("[Liquido] Método de rota '" + nomeMetodoRota + "' não suportado.")
            retorna falso
        }
        se (funcoes.tamanho() == 0) {
            escreva("[Liquido] Rota " + caminho + " não possui nenhuma função definida.")
            retorna falso
        }
        se (nao isto.roteador.registrar(metodo, caminho, funcoes, arquivo)) {
            escreva("[Liquido] Rota " + metodo + " " + caminho + " já foi registrada; a chamada em " + arquivo + " foi ignorada.")
            retorna falso
        }
        se (isto.configuracao["liquido"]["verboso"]) {
            escreva("[Liquido] Rota registrada: " + metodo + " " + caminho)
        }
        retorna verdadeiro
    }

    // Registra a documentação OpenAPI de uma rota. `textoJson` tem a forma
    // { "documentacao": {..}, "respostas": [{..}] }, montada pelo gerador a partir dos decoradores.
    documentarRota(nomeMetodoRota, caminho, textoJson) {
        var metodo: texto = roteamento.metodoDeRegistro(nomeMetodoRota)
        se (metodo == "") { retorna falso }
        var analisado = jsonLiquido.analisarJson(textoJson)
        se (analisado["erro"] != "") {
            escreva("[Liquido] Documentação inválida para " + metodo + " " + caminho + ": " + analisado["erro"])
            retorna falso
        }
        var decoradores = analisado["resultado"]
        isto.documentacaoRotas[metodo + " " + url.normalizarCaminho(caminho)] = decoradores
        retorna verdadeiro
    }

    processar(dados) {
        retorna processarRequisicao(isto, dados)
    }

    // Aceita e atende uma única conexão do servidor (útil em testes).
    atenderUma(servidor, limiteMs) {
        var conexao = rede.aceitar(servidor, limiteMs)
        se (conexao == nulo) { retorna falso }
        atenderConexao(isto, conexao)
        retorna verdadeiro
    }

    // Inicia o servidor HTTP e atende requisições até `parar` ser verdadeiro.
    iniciar() {
        var roteadorConfiguracao = isto.configuracao["liquido"]["roteador"]
        var porta = roteadorConfiguracao["porta"]
        var endereco = roteadorConfiguracao["endereco"]
        var servidor = rede.escutar(endereco, porta)
        se (servidor == nulo) {
            escreva("[Liquido] Não foi possível iniciar o servidor na porta " + texto(porta) + ": " + rede.ultimoErro())
            retorna falso
        }
        se (roteadorConfiguracao["cors"]) {
            var origens: vetor = origensCors(roteadorConfiguracao)
            se (origens.tamanho() == 1 e origens[0] == "*") {
                escreva("[Liquido] CORS habilitado para qualquer origem ('*'). Adequado apenas para desenvolvimento; em produção, restrinja com liquido.roteador.origensCors = 'https://seudominio.com.br' em configuracao.delprops.")
            }
        }
        escreva("Aplicação iniciada na porta " + texto(porta))
        enquanto (nao isto.parar) {
            var conexao = rede.aceitar(servidor, 1000)
            se (conexao != nulo) { atenderConexao(isto, conexao) }
        }
        rede.fechar(servidor)
        retorna verdadeiro
    }
}

funcao criarAplicacao(diretorioBase) {
    retorna Aplicacao(diretorioBase)
}
