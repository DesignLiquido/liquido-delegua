// Interface por linha de comando do Líquido.
//
// Uso (realização node), a partir do diretório do projeto:
//     delegua pacotes/node/liquido/fontes/ilc.delegua -- <comando> [opções]
//
// Comandos:
//     servir                      Gera `.liquido/aplicacao.delegua` e executa a aplicação (padrão).
//     gerar-aplicacao             Apenas gera `.liquido/aplicacao.delegua`.
//     simular <arquivo.json>      Gera a aplicação e atende as requisições do arquivo, sem abrir porta.
//     documentar [--saida x]      Grava o documento OpenAPI das rotas (padrão: openapi.json).
//     estilos                     Converte `estilos/*.foles` para CSS.
//     novo <nome> [--arquetipo mvc|rest]
//                                 Cria um projeto novo.
//     gerar rota <caminho> [--metodos get,post]
//     gerar visao <caminho>       Cria arquivos de rota ou de visão.
//     banco iniciar               (ainda não suportado em Delégua)
//
// Opções gerais:
//     --diretorio <caminho>       Diretório do projeto (padrão: diretório atual).
//     --pacote <caminho>          Caminho de importação do Líquido no programa gerado
//                                 (padrão: "liquido", o pacote instalado pela Pacoteca).
//
// Para executar o programa gerado, o Líquido usa o comando da variável de ambiente
// LIQUIDO_INTERPRETADOR; sem ela, o `deldel` (interpretador de Delégua escrito em Delégua,
// do delegua-delegua) se estiver no PATH, e senão o `delegua`. Se a variável apontar para
// um arquivo `.js`, ele é executado com `node`.
importar tudo como argumentos de "argumentos"
importar tudo como arquivos de "arquivos"
importar tudo como processo de "processo"
importar tudo como liquidoPacote de "./liquido.delegua"
importar tudo como centro de "./configuracao/centro_configuracoes.delegua"
importar tudo como modelosProjeto de "./ilc/modelos_projeto.delegua"
importar tudo como textos de "./utilidades/texto.delegua"

funcao opcao(nome, padraoOpcao) {
    se (argumentos.temArgumento(nome)) { retorna argumentos.obterArgumento(nome, padraoOpcao) }
    retorna padraoOpcao
}

// Argumentos posicionais (sem as opções `--nome valor`).
funcao posicionais() {
    var lista = []
    var todos: vetor = argumentos.argumentos
    var i = 0
    enquanto (i < todos.tamanho()) {
        var atual = "" + todos[i]
        se (textos.comecaCom(atual, "--")) {
            se (nao atual.inclui("=") e i + 1 < todos.tamanho() e nao textos.comecaCom("" + todos[i + 1], "-")) { i = i + 1 }
        } senao {
            lista.adicionar(atual)
        }
        i = i + 1
    }
    retorna lista
}

funcao diretorioProjeto() {
    retorna opcao("diretorio", arquivos.diretorioAtual())
}

funcao linguagemDoProjeto(diretorio) {
    var carregada = centro.carregar(diretorio)
    retorna carregada["configuracao"]["liquido"]["linguagem"]
}

funcao gerar(diretorio) {
    var caminho = liquidoPacote.gerarAplicacao(diretorio, linguagemDoProjeto(diretorio), opcao("pacote", "liquido"))
    se (caminho != "") { escreva("Programa gerado: " + caminho) }
    retorna caminho
}

// Executa o programa gerado com o interpretador configurado. Devolve o código de saída.
// Caminho de um executável no PATH (também com `.exe`), ou "".
funcao encontrarNoPath(nome) {
    var caminhos = processo.variavelAmbiente("PATH")
    se (caminhos == nulo ou caminhos == "") { retorna "" }
    var separador = ":"
    se (caminhos.inclui(";")) { separador = ";" }
    para cada diretorio em caminhos.dividir(separador) {
        se (diretorio != "") {
            var candidato = arquivos.juntarCaminhos(diretorio, nome)
            se (arquivos.eArquivo(candidato)) { retorna candidato }
            se (arquivos.eArquivo(candidato + ".exe")) { retorna candidato + ".exe" }
        }
    }
    retorna ""
}

funcao interpretadorPadrao() {
    var configurado = processo.variavelAmbiente("LIQUIDO_INTERPRETADOR")
    se (configurado != nulo e configurado != "") { retorna configurado }
    var deldel = encontrarNoPath("deldel")
    se (deldel != "") { retorna deldel }
    retorna "delegua"
}

funcao executarPrograma(caminhoRelativo, diretorio) {
    var caminhoPrograma = arquivos.caminhoAbsoluto(caminhoRelativo)
    var interpretador = interpretadorPadrao()
    se (textos.terminaCom(interpretador, ".js")) {
        var argumentosNode = [interpretador, caminhoPrograma]
        retorna processo.executar("node", argumentosNode, diretorio)
    }
    var argumentosInterpretador = [caminhoPrograma]
    retorna processo.executar(interpretador, argumentosInterpretador, diretorio)
}

funcao comandoServir() {
    var diretorio = diretorioProjeto()
    var caminho = gerar(diretorio)
    se (caminho == "") { retorna 1 }
    retorna executarPrograma(caminho, diretorio)
}

funcao comandoSimular(arquivoRequisicoes) {
    se (arquivoRequisicoes == nulo) {
        escreva("Uso: liquido simular <arquivo.json>")
        retorna 1
    }
    var diretorio = diretorioProjeto()
    var caminho = gerar(diretorio)
    se (caminho == "") { retorna 1 }
    processo.definirVariavelAmbiente("LIQUIDO_SIMULAR", arquivos.caminhoAbsoluto(arquivoRequisicoes))
    retorna executarPrograma(caminho, diretorio)
}

funcao comandoDocumentar() {
    var diretorio = diretorioProjeto()
    var caminho = gerar(diretorio)
    se (caminho == "") { retorna 1 }
    var saida = opcao("saida", arquivos.juntarCaminhos(diretorio, "openapi.json"))
    processo.definirVariavelAmbiente("LIQUIDO_DOCUMENTAR", arquivos.caminhoAbsoluto(saida))
    retorna executarPrograma(caminho, diretorio)
}

funcao comandoEstilos() {
    var diretorio = diretorioProjeto()
    var carregada = centro.carregar(diretorio)
    var quantidade = liquidoPacote.escreverEstilos(diretorio, carregada["configuracao"]["liquido"]["estilos"]["diretorioBase"])
    escreva(texto(quantidade) + " arquivo(s) de estilo convertido(s).")
    retorna 0
}

funcao escreverArquivoProjeto(diretorio, relativo, conteudo) {
    var caminho = diretorio
    var partes = relativo.dividir("/")
    para (var i = 0; i < partes.tamanho(); i = i + 1) { caminho = arquivos.juntarCaminhos(caminho, partes[i]) }
    se (arquivos.existe(caminho)) {
        escreva("Já existe, mantido: " + caminho)
        retorna falso
    }
    arquivos.criarDiretorio(arquivos.diretorioPai(caminho))
    se (arquivos.escreverTexto(caminho, conteudo)) {
        escreva("Criado: " + caminho)
        retorna verdadeiro
    }
    escreva("Não foi possível criar " + caminho)
    retorna falso
}

funcao comandoNovo(nome) {
    se (nome == nulo ou nome == "") {
        escreva("Uso: liquido novo <nome-do-projeto> [--arquetipo mvc|rest]")
        retorna 1
    }
    var arquetipo = opcao("arquetipo", "mvc")
    se (arquetipo != "mvc" e arquetipo != "rest") {
        escreva("Arquétipo inválido: " + arquetipo + ". Use 'mvc' ou 'rest'.")
        retorna 1
    }
    var diretorio = arquivos.juntarCaminhos(opcao("diretorio", arquivos.diretorioAtual()), nome)
    se (arquivos.existe(diretorio)) {
        escreva("O diretório " + diretorio + " já existe.")
        retorna 1
    }
    escreverArquivoProjeto(diretorio, "configuracao.delprops", modelosProjeto.configuracao(arquetipo))
    escreverArquivoProjeto(diretorio, "LEIAME.md", modelosProjeto.leiame(nome, arquetipo))
    escreverArquivoProjeto(diretorio, ".gitignore", ".liquido/\npacotes/\n")
    se (arquetipo == "mvc") {
        escreverArquivoProjeto(diretorio, "rotas/inicial.delegua", modelosProjeto.rotaMvc())
        escreverArquivoProjeto(diretorio, "visoes/inicial.lmht", modelosProjeto.visaoInicial())
        escreverArquivoProjeto(diretorio, "estilos/principal.foles", modelosProjeto.estiloPrincipal())
        arquivos.criarDiretorio(arquivos.juntarCaminhos(arquivos.juntarCaminhos(diretorio, "publico"), "css"))
    } senao {
        escreverArquivoProjeto(diretorio, "rotas/inicial.delegua", modelosProjeto.rotaRest())
        arquivos.criarDiretorio(arquivos.juntarCaminhos(diretorio, "publico"))
    }
    escreva("")
    escreva("Projeto " + nome + " criado. Instale o pacote `liquido` com a Pacoteca e execute `liquido servir` no diretório do projeto.")
    retorna 0
}

// "clientes/[id]" ou "/clientes/:id" -> "clientes/[id]".
funcao caminhoEmArquivo(caminho) {
    var segmentos = []
    para cada segmento em ("" + caminho).dividir("/") {
        se (segmento == "") { continua }
        se (segmento[0] == ":") { segmento = "[" + segmento.subtexto(1, segmento.tamanho()) + "]" }
        segmentos.adicionar(segmento)
    }
    retorna segmentos.juntar("/")
}

funcao comandoGerar(tipoGerado, caminho) {
    se (tipoGerado == nulo ou caminho == nulo) {
        escreva("Uso: liquido gerar rota <caminho> [--metodos get,post] | liquido gerar visao <caminho>")
        retorna 1
    }
    var diretorio = diretorioProjeto()
    var relativo = caminhoEmArquivo(caminho)
    var carregada = centro.carregar(diretorio)
    var arquetipo = carregada["configuracao"]["liquido"]["arquetipo"]
    se (tipoGerado == "rota") {
        var metodos = []
        para cada metodo em ("" + opcao("metodos", "get")).dividir(",") {
            se (metodo.aparar() != "") { metodos.adicionar(metodo.aparar()) }
        }
        se (escreverArquivoProjeto(diretorio, "rotas/" + relativo + ".delegua", modelosProjeto.rotaGerada(metodos, arquetipo))) { retorna 0 }
        retorna 1
    }
    se (tipoGerado == "visao" ou tipoGerado == "visão") {
        var nomeArquivo = relativo + ".lmht"
        se (relativo.terminaCom("]")) {
            var partes = relativo.dividir("/")
            nomeArquivo = partes.fatiar(0, partes.tamanho() - 1).juntar("/") + "/detalhes.lmht"
        }
        se (escreverArquivoProjeto(diretorio, "visoes/" + nomeArquivo, modelosProjeto.visaoGerada(relativo))) { retorna 0 }
        retorna 1
    }
    escreva("Tipo desconhecido para gerar: " + tipoGerado + ". Use 'rota' ou 'visao'.")
    retorna 1
}

funcao principal() {
    var lista: vetor = posicionais()
    var comando = "servir"
    se (lista.tamanho() > 0) { comando = lista[0] }
    var primeiro = nulo
    var segundo = nulo
    se (lista.tamanho() > 1) { primeiro = lista[1] }
    se (lista.tamanho() > 2) { segundo = lista[2] }

    se (comando == "servir" ou comando == "iniciar") { retorna comandoServir() }
    se (comando == "gerar-aplicacao") {
        se (gerar(diretorioProjeto()) == "") { retorna 1 }
        retorna 0
    }
    se (comando == "simular") { retorna comandoSimular(primeiro) }
    se (comando == "documentar") { retorna comandoDocumentar() }
    se (comando == "estilos") { retorna comandoEstilos() }
    se (comando == "novo") { retorna comandoNovo(primeiro) }
    se (comando == "gerar") { retorna comandoGerar(primeiro, segundo) }
    se (comando == "banco") {
        escreva("O comando 'banco' ainda não é suportado pelo Líquido em Delégua: falta um pacote LinConEs para Delégua.")
        retorna 1
    }
    escreva("Comando desconhecido: " + comando)
    escreva("Comandos: servir, gerar-aplicacao, simular, documentar, estilos, novo, gerar, banco.")
    retorna 1
}

var codigoSaida = principal()
se (codigoSaida != 0) { processo.sair(codigoSaida) }
