// Interface por linha de comando do Líquido.
//
// Uso (realização node), a partir do diretório do projeto:
//     delegua pacotes/node/liquido/fontes/ilc.delegua -- <comando> [opções]
//
// Comandos:
//     servir                      Gera `.liquido/aplicacao.delegua` e executa a aplicação (padrão).
//     gerar-aplicacao             Apenas gera `.liquido/aplicacao.delegua`.
//     simular <arquivo.json>      Gera a aplicação e atende as requisições do arquivo, sem abrir porta.
//     documentar [--saida x]      Grava o documento OpenAPI das rotas (padrão: openapi.json).
//     estilos                     Converte `estilos/*.foles` para CSS.
//     novo <nome> [--arquetipo mvc|rest]
//                                 Cria um projeto novo.
//     gerar rota <caminho> [--metodos get,post]
//     gerar visao <caminho>       Cria arquivos de rota ou de visão.
//     banco iniciar               (ainda não suportado em Delégua)
//
// Opções gerais:
//     --diretorio <caminho>       Diretório do projeto (padrão: diretório atual).
//     --pacote <caminho>          Caminho de importação do Líquido no programa gerado
//                                 (padrão: "liquido", o pacote instalado pela Pacoteca).
//
// Para executar o programa gerado, o Líquido usa o comando da variável de ambiente
// LIQUIDO_INTERPRETADOR (padrão: `delegua`). Se ela apontar para um arquivo `.js`,
// ele é executado com `node`.
importar tudo como argumentos de "argumentos"
importar tudo como arquivos de "arquivos"
importar tudo como processo de "processo"
importar tudo como liquido_pacote de "./liquido.delegua"
importar tudo como centro de "./configuracao/centro_configuracoes.delegua"
importar tudo como modelos_projeto de "./ilc/modelos_projeto.delegua"
importar tudo como textos de "./utilidades/texto.delegua"

funcao opcao(nome, padrao_opcao) {
    se (argumentos.temArgumento(nome)) { retorna argumentos.obterArgumento(nome, padrao_opcao) }
    retorna padrao_opcao
}

// Argumentos posicionais (sem as opções `--nome valor`).
funcao posicionais() {
    var lista = []
    var todos: vetor = argumentos.argumentos
    var i = 0
    enquanto (i < todos.tamanho()) {
        var atual = "" + todos[i]
        se (textos.comeca_com(atual, "--")) {
            se (nao atual.inclui("=") e i + 1 < todos.tamanho() e nao textos.comeca_com("" + todos[i + 1], "-")) { i = i + 1 }
        } senao {
            lista.adicionar(atual)
        }
        i = i + 1
    }
    retorna lista
}

funcao diretorio_projeto() {
    retorna opcao("diretorio", arquivos.diretorioAtual())
}

funcao linguagem_do_projeto(diretorio) {
    var carregada = centro.carregar(diretorio)
    retorna carregada["configuracao"]["liquido"]["linguagem"]
}

funcao gerar(diretorio) {
    var caminho = liquido_pacote.gerar_aplicacao(diretorio, linguagem_do_projeto(diretorio), opcao("pacote", "liquido"))
    se (caminho != "") { escreva("Programa gerado: " + caminho) }
    retorna caminho
}

// Executa o programa gerado com o interpretador configurado. Devolve o código de saída.
funcao executar_programa(caminho_relativo, diretorio) {
    var caminho_programa = arquivos.caminhoAbsoluto(caminho_relativo)
    var interpretador = processo.variavelAmbiente("LIQUIDO_INTERPRETADOR")
    se (interpretador == nulo ou interpretador == "") { interpretador = "delegua" }
    se (textos.termina_com(interpretador, ".js")) {
        var argumentos_node = [interpretador, caminho_programa]
        retorna processo.executar("node", argumentos_node, diretorio)
    }
    var argumentos_interpretador = [caminho_programa]
    retorna processo.executar(interpretador, argumentos_interpretador, diretorio)
}

funcao comando_servir() {
    var diretorio = diretorio_projeto()
    var caminho = gerar(diretorio)
    se (caminho == "") { retorna 1 }
    retorna executar_programa(caminho, diretorio)
}

funcao comando_simular(arquivo_requisicoes) {
    se (arquivo_requisicoes == nulo) {
        escreva("Uso: liquido simular <arquivo.json>")
        retorna 1
    }
    var diretorio = diretorio_projeto()
    var caminho = gerar(diretorio)
    se (caminho == "") { retorna 1 }
    processo.definirVariavelAmbiente("LIQUIDO_SIMULAR", arquivos.caminhoAbsoluto(arquivo_requisicoes))
    retorna executar_programa(caminho, diretorio)
}

funcao comando_documentar() {
    var diretorio = diretorio_projeto()
    var caminho = gerar(diretorio)
    se (caminho == "") { retorna 1 }
    var saida = opcao("saida", arquivos.juntarCaminhos(diretorio, "openapi.json"))
    processo.definirVariavelAmbiente("LIQUIDO_DOCUMENTAR", arquivos.caminhoAbsoluto(saida))
    retorna executar_programa(caminho, diretorio)
}

funcao comando_estilos() {
    var diretorio = diretorio_projeto()
    var carregada = centro.carregar(diretorio)
    var quantidade = liquido_pacote.escrever_estilos(diretorio, carregada["configuracao"]["liquido"]["estilos"]["diretorioBase"])
    escreva(texto(quantidade) + " arquivo(s) de estilo convertido(s).")
    retorna 0
}

funcao escrever_arquivo_projeto(diretorio, relativo, conteudo) {
    var caminho = diretorio
    var partes = relativo.dividir("/")
    para (var i = 0; i < partes.tamanho(); i = i + 1) { caminho = arquivos.juntarCaminhos(caminho, partes[i]) }
    se (arquivos.existe(caminho)) {
        escreva("Já existe, mantido: " + caminho)
        retorna falso
    }
    arquivos.criarDiretorio(arquivos.diretorioPai(caminho))
    se (arquivos.escreverTexto(caminho, conteudo)) {
        escreva("Criado: " + caminho)
        retorna verdadeiro
    }
    escreva("Não foi possível criar " + caminho)
    retorna falso
}

funcao comando_novo(nome) {
    se (nome == nulo ou nome == "") {
        escreva("Uso: liquido novo <nome-do-projeto> [--arquetipo mvc|rest]")
        retorna 1
    }
    var arquetipo = opcao("arquetipo", "mvc")
    se (arquetipo != "mvc" e arquetipo != "rest") {
        escreva("Arquétipo inválido: " + arquetipo + ". Use 'mvc' ou 'rest'.")
        retorna 1
    }
    var diretorio = arquivos.juntarCaminhos(opcao("diretorio", arquivos.diretorioAtual()), nome)
    se (arquivos.existe(diretorio)) {
        escreva("O diretório " + diretorio + " já existe.")
        retorna 1
    }
    escrever_arquivo_projeto(diretorio, "configuracao.delprops", modelos_projeto.configuracao(arquetipo))
    escrever_arquivo_projeto(diretorio, "LEIAME.md", modelos_projeto.leiame(nome, arquetipo))
    escrever_arquivo_projeto(diretorio, ".gitignore", ".liquido/\npacotes/\n")
    se (arquetipo == "mvc") {
        escrever_arquivo_projeto(diretorio, "rotas/inicial.delegua", modelos_projeto.rota_mvc())
        escrever_arquivo_projeto(diretorio, "visoes/inicial.lmht", modelos_projeto.visao_inicial())
        escrever_arquivo_projeto(diretorio, "estilos/principal.foles", modelos_projeto.estilo_principal())
        arquivos.criarDiretorio(arquivos.juntarCaminhos(arquivos.juntarCaminhos(diretorio, "publico"), "css"))
    } senao {
        escrever_arquivo_projeto(diretorio, "rotas/inicial.delegua", modelos_projeto.rota_rest())
        arquivos.criarDiretorio(arquivos.juntarCaminhos(diretorio, "publico"))
    }
    escreva("")
    escreva("Projeto " + nome + " criado. Instale o pacote `liquido` com a Pacoteca e execute `liquido servir` no diretório do projeto.")
    retorna 0
}

// "clientes/[id]" ou "/clientes/:id" -> "clientes/[id]".
funcao caminho_em_arquivo(caminho) {
    var segmentos = []
    para cada segmento em ("" + caminho).dividir("/") {
        se (segmento == "") { continua }
        se (segmento[0] == ":") { segmento = "[" + segmento.subtexto(1, segmento.tamanho()) + "]" }
        segmentos.adicionar(segmento)
    }
    retorna segmentos.juntar("/")
}

funcao comando_gerar(tipo_gerado, caminho) {
    se (tipo_gerado == nulo ou caminho == nulo) {
        escreva("Uso: liquido gerar rota <caminho> [--metodos get,post] | liquido gerar visao <caminho>")
        retorna 1
    }
    var diretorio = diretorio_projeto()
    var relativo = caminho_em_arquivo(caminho)
    var carregada = centro.carregar(diretorio)
    var arquetipo = carregada["configuracao"]["liquido"]["arquetipo"]
    se (tipo_gerado == "rota") {
        var metodos = []
        para cada metodo em ("" + opcao("metodos", "get")).dividir(",") {
            se (metodo.aparar() != "") { metodos.adicionar(metodo.aparar()) }
        }
        se (escrever_arquivo_projeto(diretorio, "rotas/" + relativo + ".delegua", modelos_projeto.rota_gerada(metodos, arquetipo))) { retorna 0 }
        retorna 1
    }
    se (tipo_gerado == "visao" ou tipo_gerado == "visão") {
        var nome_arquivo = relativo + ".lmht"
        se (relativo.terminaCom("]")) {
            var partes = relativo.dividir("/")
            nome_arquivo = partes.fatiar(0, partes.tamanho() - 1).juntar("/") + "/detalhes.lmht"
        }
        se (escrever_arquivo_projeto(diretorio, "visoes/" + nome_arquivo, modelos_projeto.visao_gerada(relativo))) { retorna 0 }
        retorna 1
    }
    escreva("Tipo desconhecido para gerar: " + tipo_gerado + ". Use 'rota' ou 'visao'.")
    retorna 1
}

funcao principal() {
    var lista: vetor = posicionais()
    var comando = "servir"
    se (lista.tamanho() > 0) { comando = lista[0] }
    var primeiro = nulo
    var segundo = nulo
    se (lista.tamanho() > 1) { primeiro = lista[1] }
    se (lista.tamanho() > 2) { segundo = lista[2] }

    se (comando == "servir" ou comando == "iniciar") { retorna comando_servir() }
    se (comando == "gerar-aplicacao") {
        se (gerar(diretorio_projeto()) == "") { retorna 1 }
        retorna 0
    }
    se (comando == "simular") { retorna comando_simular(primeiro) }
    se (comando == "documentar") { retorna comando_documentar() }
    se (comando == "estilos") { retorna comando_estilos() }
    se (comando == "novo") { retorna comando_novo(primeiro) }
    se (comando == "gerar") { retorna comando_gerar(primeiro, segundo) }
    se (comando == "banco") {
        escreva("O comando 'banco' ainda não é suportado pelo Líquido em Delégua: falta um pacote LinConEs para Delégua.")
        retorna 1
    }
    escreva("Comando desconhecido: " + comando)
    escreva("Comandos: servir, gerar-aplicacao, simular, documentar, estilos, novo, gerar, banco.")
    retorna 1
}

var codigo_saida = principal()
se (codigo_saida != 0) { processo.sair(codigo_saida) }
