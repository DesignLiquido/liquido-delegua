// Serialização e análise de JSON escritas em Delégua.
// O módulo `json` tem interfaces diferentes nas realizações node e llvm, então o Líquido
// usa esta implementação própria, que funciona igual em todas.

funcao ehVetor(valor: qualquer): lógico {
    var tipoValor: texto = tipo de valor
    retorna tipoValor == "vetor" ou ("" + tipoValor).terminaCom("[]")
}

funcao ehDicionario(valor: qualquer): lógico {
    var tipoValor: texto = tipo de valor
    retorna tipoValor == "dicionário" ou tipoValor == "dicionario"
}

funcao escaparTextoJson(valor: qualquer): texto {
    var resultado: texto = "\""
    para cada caractere em "" + valor {
        se (caractere == "\"") { resultado = resultado + "\\\"" }
        senao se (caractere == "\\") { resultado = resultado + "\\\\" }
        senao se (caractere == "\n") { resultado = resultado + "\\n" }
        senao se (caractere == "\r") { resultado = resultado + "\\r" }
        senao se (caractere == "\t") { resultado = resultado + "\\t" }
        senao { resultado = resultado + caractere }
    }
    retorna resultado + "\""
}

funcao serializar(valor: qualquer): texto {
    se (valor == nulo) { retorna "null" }
    var tipoValor: texto = tipo de valor
    se (tipoValor == "lógico" ou tipoValor == "logico") {
        se (valor) { retorna "true" }
        retorna "false"
    }
    se (tipoValor == "número" ou tipoValor == "numero" ou tipoValor == "inteiro" ou tipoValor == "real") {
        retorna texto(valor)
    }
    se (tipoValor == "texto") { retorna escaparTextoJson(valor) }
    se (ehVetor(valor)) {
        // Laços `para cada` terminam cedo quando o corpo faz uma chamada recursiva;
        // por isso os laços recursivos deste módulo usam índices.
        var lista: vetor = valor
        var partes: texto[] = []
        para (var i: inteiro = 0; i < lista.tamanho(); i = i + 1) {
            var item = lista[i]
            partes.adicionar(serializar(item))
        }
        retorna "[" + partes.juntar(",") + "]"
    }
    se (ehDicionario(valor)) {
        var mapa: dicionário = valor
        var partesObjeto: texto[] = []
        var chaves: texto[] = mapa.chaves()
        para (var j: inteiro = 0; j < chaves.tamanho(); j = j + 1) {
            var chave: texto = chaves[j]
            var valorChave = mapa[chave]
            partesObjeto.adicionar(escaparTextoJson(chave) + ":" + serializar(valorChave))
        }
        retorna "{" + partesObjeto.juntar(",") + "}"
    }
    retorna escaparTextoJson(texto(valor))
}

// ── Análise ──
// O analisador percorre um estado { "texto", "posicao", "erro", "resultado" }.
// Cada função de análise grava o valor lido em estado["resultado"] em vez de devolvê-lo:
// em Delégua, devolver um dicionário com a chave "valor" faz o interpretador desembrulhá-lo,
// e dados de usuário podem ter essa chave.

funcao pularEspacos(estado: dicionário) {
    var codigo: texto = estado["texto"]
    var pos: inteiro = estado["posicao"]
    enquanto (pos < codigo.tamanho()) {
        var c: texto = codigo[pos]
        se (c == " " ou c == "\n" ou c == "\r" ou c == "\t") {
            pos = pos + 1
        } senao {
            sustar
        }
    }
    estado["posicao"] = pos
}

funcao falharAnalise(estado: dicionário, mensagem: texto) {
    var erroAtual: texto = estado["erro"]
    se (erroAtual == "") {
        var pos: inteiro = estado["posicao"]
        estado["erro"] = mensagem + " (posição " + texto(pos) + ")"
    }
    estado["resultado"] = nulo
}

funcao analisarTextoJson(estado: dicionário) {
    var codigo: texto = estado["texto"]
    var pos: inteiro = estado["posicao"] + 1
    var resultado: texto = ""
    enquanto (pos < codigo.tamanho()) {
        var c: texto = codigo[pos]
        se (c == "\"") {
            estado["posicao"] = pos + 1
            estado["resultado"] = resultado
            retorna
        }
        se (c == "\\") {
            pos = pos + 1
            var escape: texto = codigo[pos]
            se (escape == "n") { resultado = resultado + "\n" }
            senao se (escape == "r") { resultado = resultado + "\r" }
            senao se (escape == "t") { resultado = resultado + "\t" }
            senao se (escape == "b" ou escape == "f") { resultado = resultado + "" }
            senao se (escape == "u") {
                // Sem conversão de código para caractere em Delégua: mantém a sequência.
                resultado = resultado + "\u" + codigo.subtexto(pos + 1, pos + 5)
                pos = pos + 4
            }
            senao { resultado = resultado + escape }
            pos = pos + 1
            continua
        }
        resultado = resultado + c
        pos = pos + 1
    }
    estado["posicao"] = pos
    falharAnalise(estado, "Texto JSON não terminado")
}

funcao analisarNumeroJson(estado: dicionário) {
    var codigo: texto = estado["texto"]
    var inicio: inteiro = estado["posicao"]
    var pos: inteiro = inicio
    enquanto (pos < codigo.tamanho() e "-+0123456789.eE".inclui(codigo[pos])) {
        pos = pos + 1
    }
    estado["posicao"] = pos
    var trecho: texto = codigo.subtexto(inicio, pos)
    se (trecho == "" ou trecho == "-") {
        falharAnalise(estado, "Número JSON inválido")
        retorna
    }
    estado["resultado"] = numero(trecho)
}

funcao consumirPalavra(estado: dicionário, palavra: texto): lógico {
    var codigo: texto = estado["texto"]
    var pos: inteiro = estado["posicao"]
    se (codigo.subtexto(pos, pos + palavra.tamanho()) == palavra) {
        estado["posicao"] = pos + palavra.tamanho()
        retorna verdadeiro
    }
    retorna falso
}

funcao analisarObjetoJson(estado: dicionário) {
    var codigo: texto = estado["texto"]
    estado["posicao"] = estado["posicao"] + 1
    var objeto: dicionário = {}
    pularEspacos(estado)
    var posInicio: inteiro = estado["posicao"]
    se (posInicio < codigo.tamanho() e codigo[posInicio] == "}") {
        estado["posicao"] = posInicio + 1
        estado["resultado"] = objeto
        retorna
    }
    enquanto (estado["erro"] == "") {
        pularEspacos(estado)
        var posChave: inteiro = estado["posicao"]
        se (posChave >= codigo.tamanho() ou codigo[posChave] != "\"") {
            falharAnalise(estado, "Esperada chave de objeto JSON")
            retorna
        }
        analisarTextoJson(estado)
        var chave: texto = estado["resultado"]
        pularEspacos(estado)
        var posDoisPontos: inteiro = estado["posicao"]
        se (posDoisPontos >= codigo.tamanho() ou codigo[posDoisPontos] != ":") {
            falharAnalise(estado, "Esperado ':' em objeto JSON")
            retorna
        }
        estado["posicao"] = posDoisPontos + 1
        analisarValor(estado)
        se (estado["erro"] != "") { retorna }
        // Copiar por uma variável local evita guardar o invólucro interno da variável.
        var valorLido = estado["resultado"]
        objeto[chave] = valorLido
        pularEspacos(estado)
        var posSep: inteiro = estado["posicao"]
        se (posSep >= codigo.tamanho()) {
            falharAnalise(estado, "Objeto JSON não terminado")
            retorna
        }
        var separador: texto = codigo[posSep]
        estado["posicao"] = posSep + 1
        se (separador == "}") {
            estado["resultado"] = objeto
            retorna
        }
        se (separador != ",") {
            falharAnalise(estado, "Esperado ',' ou '}' em objeto JSON")
            retorna
        }
    }
}

funcao analisarVetorJson(estado: dicionário) {
    var codigo: texto = estado["texto"]
    estado["posicao"] = estado["posicao"] + 1
    var itens: vetor = []
    pularEspacos(estado)
    var posInicio: inteiro = estado["posicao"]
    se (posInicio < codigo.tamanho() e codigo[posInicio] == "]") {
        estado["posicao"] = posInicio + 1
        estado["resultado"] = itens
        retorna
    }
    enquanto (estado["erro"] == "") {
        analisarValor(estado)
        se (estado["erro"] != "") { retorna }
        var itemLido = estado["resultado"]
        itens.adicionar(itemLido)
        pularEspacos(estado)
        var posSep: inteiro = estado["posicao"]
        se (posSep >= codigo.tamanho()) {
            falharAnalise(estado, "Vetor JSON não terminado")
            retorna
        }
        var separador: texto = codigo[posSep]
        estado["posicao"] = posSep + 1
        se (separador == "]") {
            estado["resultado"] = itens
            retorna
        }
        se (separador != ",") {
            falharAnalise(estado, "Esperado ',' ou ']' em vetor JSON")
            retorna
        }
    }
}

funcao analisarValor(estado: dicionário) {
    pularEspacos(estado)
    var codigo: texto = estado["texto"]
    var pos: inteiro = estado["posicao"]
    se (pos >= codigo.tamanho()) {
        falharAnalise(estado, "Fim inesperado do JSON")
        retorna
    }
    var c: texto = codigo[pos]
    se (c == "{") { analisarObjetoJson(estado) }
    senao se (c == "[") { analisarVetorJson(estado) }
    senao se (c == "\"") { analisarTextoJson(estado) }
    senao se (consumirPalavra(estado, "true")) { estado["resultado"] = verdadeiro }
    senao se (consumirPalavra(estado, "false")) { estado["resultado"] = falso }
    senao se (consumirPalavra(estado, "null")) { estado["resultado"] = nulo }
    senao se ("-0123456789".inclui(c)) { analisarNumeroJson(estado) }
    senao { falharAnalise(estado, "Caractere inesperado no JSON: '" + c + "'") }
}

// Analisa um texto JSON. Devolve { "resultado": ..., "erro": "" }; `erro` não vazio indica falha.
funcao analisarJson(textoJson: texto): dicionário {
    var estado: dicionário = { "texto": "" + textoJson, "posicao": 0, "erro": "", "resultado": nulo }
    analisarValor(estado)
    pularEspacos(estado)
    var posFinal: inteiro = estado["posicao"]
    var textoEstado: texto = estado["texto"]
    se (estado["erro"] == "" e posFinal < textoEstado.tamanho()) {
        falharAnalise(estado, "Conteúdo após o fim do JSON")
    }
    retorna { "resultado": estado["resultado"], "erro": estado["erro"] }
}
