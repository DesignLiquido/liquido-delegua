// Leitura de arquivos DelProps (`configuracao.delprops`).
// Cada linha útil tem a forma `caminho.da.propriedade = valor`, onde o valor é um texto
// ('...' ou "..."), um número, `verdadeiro`, `falso`, `nulo` ou um vetor de textos ['a', 'b'].
// Comentários começam com `//`.
importar tudo como textos de "../utilidades/texto.delegua"

// Remove um comentário `//` que esteja fora de textos.
funcao removerComentario(linha) {
    var aspas = ""
    para (var i = 0; i < linha.tamanho(); i = i + 1) {
        var c = linha[i]
        se (aspas != "") {
            se (c == aspas) { aspas = "" }
            continua
        }
        se (c == "'" ou c == "\"") {
            aspas = c
            continua
        }
        se (c == "/" e i + 1 < linha.tamanho() e linha[i + 1] == "/") {
            retorna linha.subtexto(0, i)
        }
    }
    retorna linha
}

// Interpreta o valor de uma propriedade. Devolve { "ok": lógico, "dado": ... }.
funcao interpretarValor(textoValor) {
    var bruto = textoValor.aparar()
    se (bruto == "verdadeiro") { retorna { "ok": verdadeiro, "dado": verdadeiro } }
    se (bruto == "falso") { retorna { "ok": verdadeiro, "dado": falso } }
    se (bruto == "nulo") { retorna { "ok": verdadeiro, "dado": nulo } }
    se (bruto.tamanho() >= 2) {
        var primeiro = bruto[0]
        var ultimo = bruto[bruto.tamanho() - 1]
        se ((primeiro == "'" ou primeiro == "\"") e ultimo == primeiro) {
            retorna { "ok": verdadeiro, "dado": bruto.subtexto(1, bruto.tamanho() - 1) }
        }
        se (primeiro == "[" e ultimo == "]") {
            var itens = []
            var interno = bruto.subtexto(1, bruto.tamanho() - 1).aparar()
            se (interno != "") {
                // Laço por índice: `para cada` termina cedo com chamadas recursivas.
                var partesVetor = interno.dividir(",")
                para (var i = 0; i < partesVetor.tamanho(); i = i + 1) {
                    var item: dicionário = interpretarValor(partesVetor[i])
                    se (nao item["ok"]) { retorna { "ok": falso, "dado": nulo } }
                    var dadoItem = item["dado"]
                    itens.adicionar(dadoItem)
                }
            }
            retorna { "ok": verdadeiro, "dado": itens }
        }
    }
    var ehNumero = bruto != ""
    para cada c em bruto {
        se (nao "-0123456789.".inclui(c)) { ehNumero = falso }
    }
    se (ehNumero e bruto != "-" e bruto != ".") { retorna { "ok": verdadeiro, "dado": numero(bruto) } }
    retorna { "ok": falso, "dado": nulo }
}

// Analisa o texto DelProps. Devolve { "entradas": [ { "caminho": [..], "dado": .., "linha": n } ], "erros": [..] }.
funcao analisar(textoDelprops) {
    var entradas = []
    var erros = []
    var linhas = textos.substituirTodos("" + textoDelprops, "\r\n", "\n").dividir("\n")
    para (var numeroLinha = 0; numeroLinha < linhas.tamanho(); numeroLinha = numeroLinha + 1) {
        var linha = removerComentario(linhas[numeroLinha]).aparar()
        se (linha == "") { continua }
        var igual = linha.encontrar("=")
        se (igual <= 0) {
            erros.adicionar("[Linha " + texto(numeroLinha + 1) + "] Esperado 'propriedade = valor'.")
            continua
        }
        var nome = linha.subtexto(0, igual).aparar()
        var resultadoValor: dicionário = interpretarValor(linha.subtexto(igual + 1, linha.tamanho()))
        se (nao resultadoValor["ok"]) {
            erros.adicionar("[Linha " + texto(numeroLinha + 1) + "] Valor inválido para '" + nome + "'.")
            continua
        }
        var caminho = []
        para cada parte em nome.dividir(".") {
            caminho.adicionar(parte.aparar())
        }
        var dado = resultadoValor["dado"]
        var entrada = { "caminho": caminho, "dado": dado, "linha": numeroLinha + 1 }
        entradas.adicionar(entrada)
    }
    retorna { "entradas": entradas, "erros": erros }
}
