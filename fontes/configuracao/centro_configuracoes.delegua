// Centro de configurações: valores padrão do Líquido e aplicação das entradas de `configuracao.delprops`.
importar tudo como arquivos de "arquivos"
importar tudo como processo de "processo"
importar tudo como delprops de "./delprops.delegua"
importar tudo como textos de "../utilidades/texto.delegua"

funcao configuracao_padrao() {
    var licenca = { "nome": nulo, "url": nulo }
    var aplicacao = { "nome": "", "versao": "", "descricao": "", "licenca": licenca }
    var autenticacao = { "tecnologia": nulo }
    var lincones = {
        "tecnologia": nulo,
        "caminho": nulo,
        "autoInicializar": falso,
        "arquivoInicializacao": "inicializacao.lincones"
    }
    var dados = { "motor": "lincones", "lincones": lincones }
    var roteador = {
        "diretorioEstatico": "publico",
        "cors": falso,
        "origensCors": "*",
        "bodyParser": verdadeiro,
        "morgan": falso,
        "cookieParser": verdadeiro,
        "passport": falso,
        "json": verdadeiro,
        "helmet": verdadeiro,
        "porta": 3000,
        "endereco": "0.0.0.0",
        "tempoLimite": 10000
    }
    var estilos = { "diretorioBase": "publico/css" }
    var liquido = {
        "arquetipo": "rest",
        "linguagem": "delegua",
        "verboso": falso,
        "aplicacao": aplicacao,
        "autenticacao": autenticacao,
        "dados": dados,
        "roteador": roteador,
        "estilos": estilos
    }
    retorna { "liquido": liquido }
}

funcao eh_dicionario(valor) {
    var tipo_valor = tipo de valor
    retorna tipo_valor == "dicionário"
}

// Aplica uma entrada { "caminho": [..], "dado": .. } na configuração. Devolve uma mensagem de erro ou "".
funcao aplicar_entrada(configuracao, entrada) {
    var caminho = entrada["caminho"]
    var atual = configuracao
    para (var i = 0; i < caminho.tamanho() - 1; i = i + 1) {
        var parte = caminho[i]
        se (nao atual.contem(parte) ou nao eh_dicionario(atual[parte])) {
            retorna "Propriedade " + caminho.fatiar(0, i + 1).juntar(".") + " não existe."
        }
        atual = atual[parte]
    }
    var ultima = caminho[caminho.tamanho() - 1]
    se (nao atual.contem(ultima)) {
        retorna "Propriedade " + caminho.juntar(".") + " não existe."
    }
    se (eh_dicionario(atual[ultima])) {
        retorna "Propriedade " + caminho.juntar(".") + " é um grupo de configurações e não recebe valor."
    }
    var dado = entrada["dado"]
    se (ultima == "linguagem" e dado != nulo) {
        dado = textos.remover_acentos(dado).minusculo()
    }
    atual[ultima] = dado
    retorna ""
}

// Monta a configuração a partir do texto DelProps. Devolve { "configuracao": .., "erros": [..] }.
funcao configurar_por_texto(texto_delprops) {
    var configuracao: dicionário = configuracao_padrao()
    var resultado = delprops.analisar(texto_delprops)
    var erros = resultado["erros"]
    para cada entrada em resultado["entradas"] {
        var erro = aplicar_entrada(configuracao, entrada)
        se (erro != "") { erros.adicionar("[Linha " + texto(entrada["linha"]) + "] " + erro) }
    }
    var lincones = configuracao["liquido"]["dados"]["lincones"]
    var tecnologia_ausente = lincones["tecnologia"] == nulo ou lincones["tecnologia"] == ""
    var caminho_ausente = lincones["caminho"] == nulo ou lincones["caminho"] == ""
    se (tecnologia_ausente != caminho_ausente) {
        var chave_ausente = "liquido.dados.lincones.caminho"
        se (tecnologia_ausente) { chave_ausente = "liquido.dados.lincones.tecnologia" }
        erros.adicionar("Configuração incompleta: " + chave_ausente + " não informado. Defina ambas as propriedades \"liquido.dados.lincones.tecnologia\" e \"liquido.dados.lincones.caminho\", ou remova ambas se não for usar banco de dados.")
    }
    retorna { "configuracao": configuracao, "erros": erros }
}

// Lê `configuracao.delprops` do diretório base. Sem arquivo, usa os valores padrão.
funcao carregar(diretorio_base) {
    var caminho = arquivos.juntarCaminhos(diretorio_base, "configuracao.delprops")
    var conteudo = arquivos.lerTexto(caminho)
    se (conteudo == nulo) {
        var padrao_configuracao = configuracao_padrao()
        var sem_erros = []
        retorna { "configuracao": padrao_configuracao, "erros": sem_erros, "encontrado": falso }
    }
    var resultado = configurar_por_texto(conteudo)
    retorna { "configuracao": resultado["configuracao"], "erros": resultado["erros"], "encontrado": verdadeiro }
}

// Variável de ambiente, ou entrada `NOME=valor` do arquivo `.ambiente` do diretório base.
// 'verdadeiro'/'falso' viram lógicos. Devolve nulo se não houver.
funcao variavel_ambiente(diretorio_base, nome) {
    var valor_ambiente = processo.variavelAmbiente(nome)
    se (valor_ambiente == nulo ou valor_ambiente == "") {
        valor_ambiente = nulo
        var conteudo = arquivos.lerTexto(arquivos.juntarCaminhos(diretorio_base, ".ambiente"))
        se (conteudo != nulo) {
            para cada linha em textos.substituir_todos(conteudo, "\r\n", "\n").dividir("\n") {
                se (textos.comeca_com(linha, nome + "=")) {
                    valor_ambiente = linha.subtexto(nome.tamanho() + 1, linha.tamanho()).aparar()
                    sustar
                }
            }
        }
    }
    se (valor_ambiente == "verdadeiro" ou valor_ambiente == "Verdadeiro") { retorna verdadeiro }
    se (valor_ambiente == "falso" ou valor_ambiente == "Falso") { retorna falso }
    retorna valor_ambiente
}
