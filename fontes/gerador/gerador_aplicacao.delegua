// Gerador do programa da aplicação.
//
// Em Delégua, `importar` resolve caminhos literais na análise sintática, então os arquivos de
// `rotas/` não podem ser descobertos e carregados em tempo de execução. O gerador percorre
// `rotas/`, e escreve `.liquido/aplicacao.delegua`: um programa que cria a aplicação, coloca o
// conteúdo de cada arquivo de rota dentro de `funcao rota_N(liquido) { ... }` e chama essa função
// com o registrador ligado ao caminho da rota. Assim, os arquivos de rota continuam escritos como
// no Líquido original:
//
//     liquido.rotaGet(funcao(requisicao, resposta) {
//         resposta.enviar("Olá mundo").status(200)
//     })
//
// O gerador também:
// - move as declarações `importar` dos arquivos de rota para o topo do programa, ajustando
//   caminhos relativos;
// - lê os decoradores `@rest.documentacao(...)` e `@rest.resposta(...)` e os registra na
//   documentação OpenAPI;
// - preserva a numeração de linhas dentro de cada rota (linhas removidas viram linhas vazias).
importar tudo como arquivos de "arquivos"
importar tudo como jsonLiquido de "../utilidades/json.delegua"
importar tudo como textos de "../utilidades/texto.delegua"

var adiante = {}

var nomeDiretorioGerado = ".liquido"
var nomeProgramaGerado = "aplicacao.delegua"

funcao extensaoDaLinguagem(linguagem) {
    se (textos.removerAcentos("" + linguagem).minusculo() == "pitugues") { retorna ".pitu" }
    retorna ".delegua"
}

// Lista os arquivos de rota (caminhos relativos ao diretório base, com "/"), em ordem.
// Devolve { "arquivos": [..], "avisos": [..] }.
funcao descobrirArquivosRotas(diretorioBase, linguagem) {
    var extensaoRota = extensaoDaLinguagem(linguagem)
    var outraExtensao = ".pitu"
    se (extensaoRota == ".pitu") { outraExtensao = ".delegua" }
    var encontrados = []
    var avisos = []
    var pendentes = ["rotas"]
    var limite = 10000
    enquanto (pendentes.tamanho() > 0 e limite > 0) {
        limite = limite - 1
        var relativo = pendentes[0]
        pendentes = pendentes.fatiar(1)
        var absoluto = arquivos.juntarCaminhos(diretorioBase, relativo)
        var subdiretorios = []
        para cada nomeListado em arquivos.listarDiretorio(absoluto) {
            var nome = "" + nomeListado
            var relativoItem = relativo + "/" + nome
            var absolutoItem = arquivos.juntarCaminhos(absoluto, nome)
            se (arquivos.eDiretorio(absolutoItem)) {
                subdiretorios.adicionar(relativoItem)
            } senao se (textos.terminaCom(nome, extensaoRota)) {
                encontrados.adicionar(relativoItem)
            } senao se (textos.terminaCom(nome, outraExtensao)) {
                avisos.adicionar("Arquivo de rota '" + relativoItem + "' ignorado: projeto configurado para a extensão " + extensaoRota + ".")
            }
        }
        para cada subdiretorio em subdiretorios { pendentes.adicionar(subdiretorio) }
    }
    retorna { "arquivos": encontrados, "avisos": avisos }
}

// "rotas/api/clientes/[id].delegua" -> "/api/clientes/:id"; "rotas/inicial.delegua" -> "/".
funcao caminhoDaRota(arquivoRelativo, linguagem) {
    var extensaoRota = extensaoDaLinguagem(linguagem)
    var segmentos = arquivoRelativo.dividir("/")
    var resultado = []
    para (var i = 1; i < segmentos.tamanho(); i = i + 1) {
        var segmento = segmentos[i]
        se (i == segmentos.tamanho() - 1) {
            segmento = segmento.subtexto(0, segmento.tamanho() - extensaoRota.tamanho())
            se (segmento == "inicial") { continua }
        }
        se (textos.comecaCom(segmento, "[") e textos.terminaCom(segmento, "]") e segmento.tamanho() > 2) {
            segmento = ":" + segmento.subtexto(1, segmento.tamanho() - 1)
        }
        resultado.adicionar(segmento)
    }
    retorna "/" + resultado.juntar("/")
}

// ── Leitura de decoradores ──

// Interpreta o valor de um atributo de decorador: texto, número, lógico ou vetor.
// Grava em estado["resultado"]; estado["erro"] não vazio indica falha.
funcao interpretarValorDecorador(textoValor, estado) {
    var bruto = textoValor.aparar()
    estado["resultado"] = nulo
    se (bruto == "verdadeiro") {
        estado["resultado"] = verdadeiro
        retorna
    }
    se (bruto == "falso") {
        estado["resultado"] = falso
        retorna
    }
    se (bruto.tamanho() >= 2 e (bruto[0] == "\"" ou bruto[0] == "'") e bruto[bruto.tamanho() - 1] == bruto[0]) {
        estado["resultado"] = bruto.subtexto(1, bruto.tamanho() - 1)
        retorna
    }
    se (bruto.tamanho() >= 2 e bruto[0] == "[" e bruto[bruto.tamanho() - 1] == "]") {
        var itens = []
        var partes: vetor = adiante["dividirNivelSuperior"](bruto.subtexto(1, bruto.tamanho() - 1), ",")
        para (var i = 0; i < partes.tamanho(); i = i + 1) {
            se (partes[i].aparar() == "") { continua }
            interpretarValorDecorador(partes[i], estado)
            var item = estado["resultado"]
            itens.adicionar(item)
        }
        estado["resultado"] = itens
        retorna
    }
    var ehNumero = bruto != ""
    para cada c em bruto {
        se (nao "-0123456789.".inclui(c)) { ehNumero = falso }
    }
    se (ehNumero) {
        estado["resultado"] = numero(bruto)
        retorna
    }
    estado["erro"] = "Valor de atributo de decorador não suportado: " + bruto
}

// Divide `conteudo` por `separador` fora de textos e colchetes.
funcao dividirNivelSuperior(conteudo, separador) {
    var partes = []
    var atual = ""
    var aspas = ""
    var profundidade = 0
    para cada c em conteudo {
        se (aspas != "") {
            atual = atual + c
            se (c == aspas) { aspas = "" }
            continua
        }
        se (c == "\"" ou c == "'") {
            aspas = c
            atual = atual + c
            continua
        }
        se (c == "[" ou c == "(" ou c == "{") { profundidade = profundidade + 1 }
        se (c == "]" ou c == ")" ou c == "}") { profundidade = profundidade - 1 }
        se (c == separador e profundidade == 0) {
            partes.adicionar(atual)
            atual = ""
            continua
        }
        atual = atual + c
    }
    se (atual.aparar() != "") { partes.adicionar(atual) }
    retorna partes
}
adiante["dividirNivelSuperior"] = dividirNivelSuperior

// "@rest.resposta(codigo = 200, descricao = "Ok")" -> { "nome": "@rest.resposta", "atributos": {..}, "erro": "" }.
funcao analisarDecorador(textoDecorador) {
    var bruto = textoDecorador.aparar()
    var abertura = bruto.encontrar("(")
    var atributos = {}
    se (abertura < 0) { retorna { "nome": bruto, "atributos": atributos, "erro": "" } }
    var nome = bruto.subtexto(0, abertura).aparar()
    var fechamento = -1
    para (var i = bruto.tamanho() - 1; i > abertura; i = i - 1) {
        se (bruto[i] == ")") {
            fechamento = i
            sustar
        }
    }
    se (fechamento < 0) { retorna { "nome": nome, "atributos": atributos, "erro": "Decorador " + nome + " sem ')'." } }
    var estado = { "resultado": nulo, "erro": "" }
    var partes: vetor = dividirNivelSuperior(bruto.subtexto(abertura + 1, fechamento), ",")
    para cada parte em partes {
        se (parte.aparar() == "") { continua }
        var igual = parte.encontrar("=")
        se (igual < 0) { igual = parte.encontrar(":") }
        se (igual < 0) {
            retorna { "nome": nome, "atributos": atributos, "erro": "Atributo sem valor em " + nome + ": " + parte.aparar() }
        }
        var chave = parte.subtexto(0, igual).aparar()
        interpretarValorDecorador(parte.subtexto(igual + 1, parte.tamanho()), estado)
        se (estado["erro"] != "") { retorna { "nome": nome, "atributos": atributos, "erro": estado["erro"] } }
        var valorAtributo = estado["resultado"]
        atributos[chave] = valorAtributo
    }
    retorna { "nome": nome, "atributos": atributos, "erro": "" }
}

// Diferença entre parênteses abertos e fechados em uma linha, fora de textos.
funcao saldoParenteses(linha) {
    var saldo = 0
    var aspas = ""
    para cada c em linha {
        se (aspas != "") {
            se (c == aspas) { aspas = "" }
            continua
        }
        se (c == "\"" ou c == "'") { aspas = c }
        senao se (c == "(") { saldo = saldo + 1 }
        senao se (c == ")") { saldo = saldo - 1 }
    }
    retorna saldo
}

// Nome do método em uma linha `liquido.rotaX(`, ou "".
funcao metodoRegistroNaLinha(linha) {
    var aparada = linha.aparar()
    se (nao textos.comecaCom(aparada, "liquido.rota")) { retorna "" }
    var abertura = aparada.encontrar("(")
    se (abertura < 0) { retorna "" }
    retorna aparada.subtexto(8, abertura).aparar()
}

// Transforma o texto de um arquivo de rota. Devolve
// { "corpo": texto, "importacoes": [linhas], "documentacoes": [{ "metodo", "json" }], "erros": [..] }.
funcao transformarRota(conteudo, arquivoRelativo) {
    var linhas = textos.substituirTodos("" + conteudo, "\r\n", "\n").dividir("\n")
    var saida = []
    var importacoes = []
    var documentacoes = []
    var erros = []
    var pendentes = []
    var i = 0
    enquanto (i < linhas.tamanho()) {
        var linha = linhas[i]
        var aparada = linha.aparar()
        se (textos.comecaCom(aparada, "importar ") ou textos.comecaCom(aparada, "importe ")) {
            importacoes.adicionar(aparada)
            saida.adicionar("")
            i = i + 1
            continua
        }
        se (textos.comecaCom(aparada, "@")) {
            var textoDecorador = aparada
            var saldo = saldoParenteses(aparada)
            saida.adicionar("")
            i = i + 1
            enquanto (saldo > 0 e i < linhas.tamanho()) {
                textoDecorador = textoDecorador + " " + linhas[i].aparar()
                saldo = saldo + saldoParenteses(linhas[i])
                saida.adicionar("")
                i = i + 1
            }
            var decorador: dicionário = analisarDecorador(textoDecorador)
            se (decorador["erro"] != "") {
                erros.adicionar(arquivoRelativo + ": " + decorador["erro"])
            } senao {
                pendentes.adicionar(decorador)
            }
            continua
        }
        var metodo = metodoRegistroNaLinha(linha)
        se (metodo != "" e pendentes.tamanho() > 0) {
            var documentacao = {}
            var respostas = []
            para cada pendente em pendentes {
                var nomeDecorador = pendente["nome"]
                se (nomeDecorador == "@rest.documentacao" ou nomeDecorador == "@rest.documentação") {
                    documentacao = pendente["atributos"]
                } senao se (nomeDecorador == "@rest.resposta") {
                    var atributosResposta = pendente["atributos"]
                    respostas.adicionar(atributosResposta)
                } senao {
                    erros.adicionar(arquivoRelativo + ": Decorador " + nomeDecorador + " não é válido para um método de um controlador.")
                }
            }
            var dadosDocumentacao = { "documentacao": documentacao, "respostas": respostas }
            var entradaDocumentacao = { "metodo": metodo, "json": jsonLiquido.serializar(dadosDocumentacao) }
            documentacoes.adicionar(entradaDocumentacao)
            pendentes = []
        }
        saida.adicionar(linha)
        i = i + 1
    }
    retorna { "corpo": saida.juntar("\n"), "importacoes": importacoes, "documentacoes": documentacoes, "erros": erros }
}

// Ajusta caminhos relativos de uma linha `importar` escrita em `arquivoRelativo` para que
// funcionem a partir de `.liquido/`.
funcao ajustarImportacao(linhaImportacao, arquivoRelativo) {
    var aspas = "\""
    var inicio = linhaImportacao.encontrar("\"")
    se (inicio < 0) {
        aspas = "'"
        inicio = linhaImportacao.encontrar("'")
    }
    se (inicio < 0) { retorna linhaImportacao }
    var fim = textos.encontrarAPartir(linhaImportacao, aspas, inicio + 1)
    se (fim < 0) { retorna linhaImportacao }
    var caminho = linhaImportacao.subtexto(inicio + 1, fim)
    se (nao textos.comecaCom(caminho, "./") e nao textos.comecaCom(caminho, "../")) { retorna linhaImportacao }

    // Diretório do arquivo de rota, relativo ao diretório base.
    var segmentos = arquivoRelativo.dividir("/")
    var diretorio = []
    para (var i = 0; i < segmentos.tamanho() - 1; i = i + 1) { diretorio.adicionar(segmentos[i]) }
    para cada parte em caminho.dividir("/") {
        se (parte == "." ou parte == "") { continua }
        se (parte == "..") {
            se (diretorio.tamanho() > 0) { diretorio = diretorio.fatiar(0, diretorio.tamanho() - 1) }
            continua
        }
        diretorio.adicionar(parte)
    }
    var novoCaminho = "../" + diretorio.juntar("/")
    retorna linhaImportacao.subtexto(0, inicio + 1) + novoCaminho + linhaImportacao.subtexto(fim, linhaImportacao.tamanho())
}

funcao literalTexto(valor) {
    retorna jsonLiquido.escaparTextoJson(valor)
}

// Gera o texto do programa. `importacaoLiquido` é o caminho usado em `importar ... de`
// para o pacote (normalmente "liquido"). Devolve { "programa": texto, "rotas": [..], "avisos": [..], "erros": [..] }.
funcao gerarPrograma(diretorioBase, linguagem, importacaoLiquido) {
    var descoberta = descobrirArquivosRotas(diretorioBase, linguagem)
    var avisos = descoberta["avisos"]
    var erros = []
    var rotas = []
    var importacoes = []
    var blocos = []
    var registros = []
    var indice = 0
    para cada arquivoRelativo em descoberta["arquivos"] {
        var conteudo = arquivos.lerTexto(arquivos.juntarCaminhos(diretorioBase, arquivoRelativo))
        se (conteudo == nulo) {
            erros.adicionar("Não foi possível ler " + arquivoRelativo + ".")
            continua
        }
        var caminhoRota = caminhoDaRota(arquivoRelativo, linguagem)
        var transformada: dicionário = transformarRota(conteudo, arquivoRelativo)
        para cada erroRota em transformada["erros"] { erros.adicionar(erroRota) }
        para cada importacao em transformada["importacoes"] {
            var ajustada = ajustarImportacao(importacao, arquivoRelativo)
            se (nao importacoes.inclui(ajustada)) { importacoes.adicionar(ajustada) }
        }
        var nomeFuncao = "rota_liquido_" + texto(indice)
        blocos.adicionar("// ── " + arquivoRelativo + " → " + caminhoRota + " ──\nfuncao " + nomeFuncao + "(liquido) {\n" + transformada["corpo"] + "\n}\n")
        registros.adicionar(nomeFuncao + "(aplicacaoLiquido.registrador(" + literalTexto(caminhoRota) + ", " + literalTexto(arquivoRelativo) + "))")
        para cada documentacao em transformada["documentacoes"] {
            registros.adicionar("aplicacaoLiquido.documentarRota(" + literalTexto(documentacao["metodo"]) + ", " + literalTexto(caminhoRota) + ", " + literalTexto(documentacao["json"]) + ")")
        }
        var descricaoRota = { "arquivo": arquivoRelativo, "caminho": caminhoRota }
        rotas.adicionar(descricaoRota)
        indice = indice + 1
    }

    var baseAbsoluta = textos.substituirTodos(arquivos.caminhoAbsoluto(diretorioBase), "\\", "/")
    var programa = "// Programa gerado pelo Líquido a partir de rotas/. Não edite: ele é recriado a cada execução.\n" +
        "importar tudo como liquidoNucleo de " + literalTexto(importacaoLiquido) + "\n"
    para cada linhaImportacao em importacoes { programa = programa + linhaImportacao + "\n" }
    programa = programa + "\nvar aplicacaoLiquido = liquidoNucleo.criarAplicacao(" + literalTexto(baseAbsoluta) + ")\n\n"
    para cada bloco em blocos { programa = programa + bloco + "\n" }
    para cada registro em registros { programa = programa + registro + "\n" }
    programa = programa + "\nliquidoNucleo.iniciarAplicacao(aplicacaoLiquido)\n"
    retorna { "programa": programa, "rotas": rotas, "avisos": avisos, "erros": erros }
}

// Gera e grava `.liquido/aplicacao.delegua`. Devolve o resultado de `gerarPrograma` com
// "caminho" do arquivo escrito (ou "" em caso de falha).
funcao gerarArquivo(diretorioBase, linguagem, importacaoLiquido) {
    var resultado: dicionário = gerarPrograma(diretorioBase, linguagem, importacaoLiquido)
    var diretorioGerado = arquivos.juntarCaminhos(diretorioBase, nomeDiretorioGerado)
    var caminho = arquivos.juntarCaminhos(diretorioGerado, nomeProgramaGerado)
    se (nao arquivos.criarDiretorio(diretorioGerado) ou nao arquivos.escreverTexto(caminho, resultado["programa"])) {
        resultado["erros"].adicionar("Não foi possível escrever " + caminho + ".")
        resultado["caminho"] = ""
        retorna resultado
    }
    resultado["caminho"] = caminho
    retorna resultado
}
