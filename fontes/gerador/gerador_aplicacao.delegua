// Gerador do programa da aplicação.
//
// Em Delégua, `importar` resolve caminhos literais na análise sintática, então os arquivos de
// `rotas/` não podem ser descobertos e carregados em tempo de execução. O gerador percorre
// `rotas/`, e escreve `.liquido/aplicacao.delegua`: um programa que cria a aplicação, coloca o
// conteúdo de cada arquivo de rota dentro de `funcao rota_N(liquido) { ... }` e chama essa função
// com o registrador ligado ao caminho da rota. Assim, os arquivos de rota continuam escritos como
// no Líquido original:
//
//     liquido.rotaGet(funcao(requisicao, resposta) {
//         resposta.enviar("Olá mundo").status(200)
//     })
//
// O gerador também:
// - move as declarações `importar` dos arquivos de rota para o topo do programa, ajustando
//   caminhos relativos;
// - lê os decoradores `@rest.documentacao(...)` e `@rest.resposta(...)` e os registra na
//   documentação OpenAPI;
// - preserva a numeração de linhas dentro de cada rota (linhas removidas viram linhas vazias).
importar tudo como arquivos de "arquivos"
importar tudo como json_liquido de "../utilidades/json.delegua"
importar tudo como textos de "../utilidades/texto.delegua"

var adiante = {}

var nome_diretorio_gerado = ".liquido"
var nome_programa_gerado = "aplicacao.delegua"

funcao extensao_da_linguagem(linguagem) {
    se (textos.remover_acentos("" + linguagem).minusculo() == "pitugues") { retorna ".pitu" }
    retorna ".delegua"
}

// Lista os arquivos de rota (caminhos relativos ao diretório base, com "/"), em ordem.
// Devolve { "arquivos": [..], "avisos": [..] }.
funcao descobrir_arquivos_rotas(diretorio_base, linguagem) {
    var extensao_rota = extensao_da_linguagem(linguagem)
    var outra_extensao = ".pitu"
    se (extensao_rota == ".pitu") { outra_extensao = ".delegua" }
    var encontrados = []
    var avisos = []
    var pendentes = ["rotas"]
    var limite = 10000
    enquanto (pendentes.tamanho() > 0 e limite > 0) {
        limite = limite - 1
        var relativo = pendentes[0]
        pendentes = pendentes.fatiar(1)
        var absoluto = arquivos.juntarCaminhos(diretorio_base, relativo)
        var subdiretorios = []
        para cada nome_listado em arquivos.listarDiretorio(absoluto) {
            var nome = "" + nome_listado
            var relativo_item = relativo + "/" + nome
            var absoluto_item = arquivos.juntarCaminhos(absoluto, nome)
            se (arquivos.eDiretorio(absoluto_item)) {
                subdiretorios.adicionar(relativo_item)
            } senao se (textos.termina_com(nome, extensao_rota)) {
                encontrados.adicionar(relativo_item)
            } senao se (textos.termina_com(nome, outra_extensao)) {
                avisos.adicionar("Arquivo de rota '" + relativo_item + "' ignorado: projeto configurado para a extensão " + extensao_rota + ".")
            }
        }
        para cada subdiretorio em subdiretorios { pendentes.adicionar(subdiretorio) }
    }
    retorna { "arquivos": encontrados, "avisos": avisos }
}

// "rotas/api/clientes/[id].delegua" -> "/api/clientes/:id"; "rotas/inicial.delegua" -> "/".
funcao caminho_da_rota(arquivo_relativo, linguagem) {
    var extensao_rota = extensao_da_linguagem(linguagem)
    var segmentos = arquivo_relativo.dividir("/")
    var resultado = []
    para (var i = 1; i < segmentos.tamanho(); i = i + 1) {
        var segmento = segmentos[i]
        se (i == segmentos.tamanho() - 1) {
            segmento = segmento.subtexto(0, segmento.tamanho() - extensao_rota.tamanho())
            se (segmento == "inicial") { continua }
        }
        se (textos.comeca_com(segmento, "[") e textos.termina_com(segmento, "]") e segmento.tamanho() > 2) {
            segmento = ":" + segmento.subtexto(1, segmento.tamanho() - 1)
        }
        resultado.adicionar(segmento)
    }
    retorna "/" + resultado.juntar("/")
}

// ── Leitura de decoradores ──

// Interpreta o valor de um atributo de decorador: texto, número, lógico ou vetor.
// Grava em estado["resultado"]; estado["erro"] não vazio indica falha.
funcao interpretar_valor_decorador(texto_valor, estado) {
    var bruto = texto_valor.aparar()
    estado["resultado"] = nulo
    se (bruto == "verdadeiro") {
        estado["resultado"] = verdadeiro
        retorna
    }
    se (bruto == "falso") {
        estado["resultado"] = falso
        retorna
    }
    se (bruto.tamanho() >= 2 e (bruto[0] == "\"" ou bruto[0] == "'") e bruto[bruto.tamanho() - 1] == bruto[0]) {
        estado["resultado"] = bruto.subtexto(1, bruto.tamanho() - 1)
        retorna
    }
    se (bruto.tamanho() >= 2 e bruto[0] == "[" e bruto[bruto.tamanho() - 1] == "]") {
        var itens = []
        var partes: vetor = adiante["dividir_nivel_superior"](bruto.subtexto(1, bruto.tamanho() - 1), ",")
        para (var i = 0; i < partes.tamanho(); i = i + 1) {
            se (partes[i].aparar() == "") { continua }
            interpretar_valor_decorador(partes[i], estado)
            var item = estado["resultado"]
            itens.adicionar(item)
        }
        estado["resultado"] = itens
        retorna
    }
    var eh_numero = bruto != ""
    para cada c em bruto {
        se (nao "-0123456789.".inclui(c)) { eh_numero = falso }
    }
    se (eh_numero) {
        estado["resultado"] = numero(bruto)
        retorna
    }
    estado["erro"] = "Valor de atributo de decorador não suportado: " + bruto
}

// Divide `conteudo` por `separador` fora de textos e colchetes.
funcao dividir_nivel_superior(conteudo, separador) {
    var partes = []
    var atual = ""
    var aspas = ""
    var profundidade = 0
    para cada c em conteudo {
        se (aspas != "") {
            atual = atual + c
            se (c == aspas) { aspas = "" }
            continua
        }
        se (c == "\"" ou c == "'") {
            aspas = c
            atual = atual + c
            continua
        }
        se (c == "[" ou c == "(" ou c == "{") { profundidade = profundidade + 1 }
        se (c == "]" ou c == ")" ou c == "}") { profundidade = profundidade - 1 }
        se (c == separador e profundidade == 0) {
            partes.adicionar(atual)
            atual = ""
            continua
        }
        atual = atual + c
    }
    se (atual.aparar() != "") { partes.adicionar(atual) }
    retorna partes
}
adiante["dividir_nivel_superior"] = dividir_nivel_superior

// "@rest.resposta(codigo = 200, descricao = "Ok")" -> { "nome": "@rest.resposta", "atributos": {..}, "erro": "" }.
funcao analisar_decorador(texto_decorador) {
    var bruto = texto_decorador.aparar()
    var abertura = bruto.encontrar("(")
    var atributos = {}
    se (abertura < 0) { retorna { "nome": bruto, "atributos": atributos, "erro": "" } }
    var nome = bruto.subtexto(0, abertura).aparar()
    var fechamento = -1
    para (var i = bruto.tamanho() - 1; i > abertura; i = i - 1) {
        se (bruto[i] == ")") {
            fechamento = i
            sustar
        }
    }
    se (fechamento < 0) { retorna { "nome": nome, "atributos": atributos, "erro": "Decorador " + nome + " sem ')'." } }
    var estado = { "resultado": nulo, "erro": "" }
    var partes: vetor = dividir_nivel_superior(bruto.subtexto(abertura + 1, fechamento), ",")
    para cada parte em partes {
        se (parte.aparar() == "") { continua }
        var igual = parte.encontrar("=")
        se (igual < 0) { igual = parte.encontrar(":") }
        se (igual < 0) {
            retorna { "nome": nome, "atributos": atributos, "erro": "Atributo sem valor em " + nome + ": " + parte.aparar() }
        }
        var chave = parte.subtexto(0, igual).aparar()
        interpretar_valor_decorador(parte.subtexto(igual + 1, parte.tamanho()), estado)
        se (estado["erro"] != "") { retorna { "nome": nome, "atributos": atributos, "erro": estado["erro"] } }
        var valor_atributo = estado["resultado"]
        atributos[chave] = valor_atributo
    }
    retorna { "nome": nome, "atributos": atributos, "erro": "" }
}

// Diferença entre parênteses abertos e fechados em uma linha, fora de textos.
funcao saldo_parenteses(linha) {
    var saldo = 0
    var aspas = ""
    para cada c em linha {
        se (aspas != "") {
            se (c == aspas) { aspas = "" }
            continua
        }
        se (c == "\"" ou c == "'") { aspas = c }
        senao se (c == "(") { saldo = saldo + 1 }
        senao se (c == ")") { saldo = saldo - 1 }
    }
    retorna saldo
}

// Nome do método em uma linha `liquido.rotaX(`, ou "".
funcao metodo_registro_na_linha(linha) {
    var aparada = linha.aparar()
    se (nao textos.comeca_com(aparada, "liquido.rota")) { retorna "" }
    var abertura = aparada.encontrar("(")
    se (abertura < 0) { retorna "" }
    retorna aparada.subtexto(8, abertura).aparar()
}

// Transforma o texto de um arquivo de rota. Devolve
// { "corpo": texto, "importacoes": [linhas], "documentacoes": [{ "metodo", "json" }], "erros": [..] }.
funcao transformar_rota(conteudo, arquivo_relativo) {
    var linhas = textos.substituir_todos("" + conteudo, "\r\n", "\n").dividir("\n")
    var saida = []
    var importacoes = []
    var documentacoes = []
    var erros = []
    var pendentes = []
    var i = 0
    enquanto (i < linhas.tamanho()) {
        var linha = linhas[i]
        var aparada = linha.aparar()
        se (textos.comeca_com(aparada, "importar ") ou textos.comeca_com(aparada, "importe ")) {
            importacoes.adicionar(aparada)
            saida.adicionar("")
            i = i + 1
            continua
        }
        se (textos.comeca_com(aparada, "@")) {
            var texto_decorador = aparada
            var saldo = saldo_parenteses(aparada)
            saida.adicionar("")
            i = i + 1
            enquanto (saldo > 0 e i < linhas.tamanho()) {
                texto_decorador = texto_decorador + " " + linhas[i].aparar()
                saldo = saldo + saldo_parenteses(linhas[i])
                saida.adicionar("")
                i = i + 1
            }
            var decorador: dicionário = analisar_decorador(texto_decorador)
            se (decorador["erro"] != "") {
                erros.adicionar(arquivo_relativo + ": " + decorador["erro"])
            } senao {
                pendentes.adicionar(decorador)
            }
            continua
        }
        var metodo = metodo_registro_na_linha(linha)
        se (metodo != "" e pendentes.tamanho() > 0) {
            var documentacao = {}
            var respostas = []
            para cada pendente em pendentes {
                var nome_decorador = pendente["nome"]
                se (nome_decorador == "@rest.documentacao" ou nome_decorador == "@rest.documentação") {
                    documentacao = pendente["atributos"]
                } senao se (nome_decorador == "@rest.resposta") {
                    var atributos_resposta = pendente["atributos"]
                    respostas.adicionar(atributos_resposta)
                } senao {
                    erros.adicionar(arquivo_relativo + ": Decorador " + nome_decorador + " não é válido para um método de um controlador.")
                }
            }
            var dados_documentacao = { "documentacao": documentacao, "respostas": respostas }
            var entrada_documentacao = { "metodo": metodo, "json": json_liquido.serializar(dados_documentacao) }
            documentacoes.adicionar(entrada_documentacao)
            pendentes = []
        }
        saida.adicionar(linha)
        i = i + 1
    }
    retorna { "corpo": saida.juntar("\n"), "importacoes": importacoes, "documentacoes": documentacoes, "erros": erros }
}

// Ajusta caminhos relativos de uma linha `importar` escrita em `arquivo_relativo` para que
// funcionem a partir de `.liquido/`.
funcao ajustar_importacao(linha_importacao, arquivo_relativo) {
    var aspas = "\""
    var inicio = linha_importacao.encontrar("\"")
    se (inicio < 0) {
        aspas = "'"
        inicio = linha_importacao.encontrar("'")
    }
    se (inicio < 0) { retorna linha_importacao }
    var fim = textos.encontrar_a_partir(linha_importacao, aspas, inicio + 1)
    se (fim < 0) { retorna linha_importacao }
    var caminho = linha_importacao.subtexto(inicio + 1, fim)
    se (nao textos.comeca_com(caminho, "./") e nao textos.comeca_com(caminho, "../")) { retorna linha_importacao }

    // Diretório do arquivo de rota, relativo ao diretório base.
    var segmentos = arquivo_relativo.dividir("/")
    var diretorio = []
    para (var i = 0; i < segmentos.tamanho() - 1; i = i + 1) { diretorio.adicionar(segmentos[i]) }
    para cada parte em caminho.dividir("/") {
        se (parte == "." ou parte == "") { continua }
        se (parte == "..") {
            se (diretorio.tamanho() > 0) { diretorio = diretorio.fatiar(0, diretorio.tamanho() - 1) }
            continua
        }
        diretorio.adicionar(parte)
    }
    var novo_caminho = "../" + diretorio.juntar("/")
    retorna linha_importacao.subtexto(0, inicio + 1) + novo_caminho + linha_importacao.subtexto(fim, linha_importacao.tamanho())
}

funcao literal_texto(valor) {
    retorna json_liquido.escapar_texto_json(valor)
}

// Gera o texto do programa. `importacao_liquido` é o caminho usado em `importar ... de`
// para o pacote (normalmente "liquido"). Devolve { "programa": texto, "rotas": [..], "avisos": [..], "erros": [..] }.
funcao gerar_programa(diretorio_base, linguagem, importacao_liquido) {
    var descoberta = descobrir_arquivos_rotas(diretorio_base, linguagem)
    var avisos = descoberta["avisos"]
    var erros = []
    var rotas = []
    var importacoes = []
    var blocos = []
    var registros = []
    var indice = 0
    para cada arquivo_relativo em descoberta["arquivos"] {
        var conteudo = arquivos.lerTexto(arquivos.juntarCaminhos(diretorio_base, arquivo_relativo))
        se (conteudo == nulo) {
            erros.adicionar("Não foi possível ler " + arquivo_relativo + ".")
            continua
        }
        var caminho_rota = caminho_da_rota(arquivo_relativo, linguagem)
        var transformada: dicionário = transformar_rota(conteudo, arquivo_relativo)
        para cada erro_rota em transformada["erros"] { erros.adicionar(erro_rota) }
        para cada importacao em transformada["importacoes"] {
            var ajustada = ajustar_importacao(importacao, arquivo_relativo)
            se (nao importacoes.inclui(ajustada)) { importacoes.adicionar(ajustada) }
        }
        var nome_funcao = "rota_liquido_" + texto(indice)
        blocos.adicionar("// ── " + arquivo_relativo + " → " + caminho_rota + " ──\nfuncao " + nome_funcao + "(liquido) {\n" + transformada["corpo"] + "\n}\n")
        registros.adicionar(nome_funcao + "(aplicacao_liquido.registrador(" + literal_texto(caminho_rota) + ", " + literal_texto(arquivo_relativo) + "))")
        para cada documentacao em transformada["documentacoes"] {
            registros.adicionar("aplicacao_liquido.documentarRota(" + literal_texto(documentacao["metodo"]) + ", " + literal_texto(caminho_rota) + ", " + literal_texto(documentacao["json"]) + ")")
        }
        var descricao_rota = { "arquivo": arquivo_relativo, "caminho": caminho_rota }
        rotas.adicionar(descricao_rota)
        indice = indice + 1
    }

    var base_absoluta = textos.substituir_todos(arquivos.caminhoAbsoluto(diretorio_base), "\\", "/")
    var programa = "// Programa gerado pelo Líquido a partir de rotas/. Não edite: ele é recriado a cada execução.\n" +
        "importar tudo como liquido_nucleo de " + literal_texto(importacao_liquido) + "\n"
    para cada linha_importacao em importacoes { programa = programa + linha_importacao + "\n" }
    programa = programa + "\nvar aplicacao_liquido = liquido_nucleo.criar_aplicacao(" + literal_texto(base_absoluta) + ")\n\n"
    para cada bloco em blocos { programa = programa + bloco + "\n" }
    para cada registro em registros { programa = programa + registro + "\n" }
    programa = programa + "\nliquido_nucleo.iniciar_aplicacao(aplicacao_liquido)\n"
    retorna { "programa": programa, "rotas": rotas, "avisos": avisos, "erros": erros }
}

// Gera e grava `.liquido/aplicacao.delegua`. Devolve o resultado de `gerar_programa` com
// "caminho" do arquivo escrito (ou "" em caso de falha).
funcao gerar_arquivo(diretorio_base, linguagem, importacao_liquido) {
    var resultado: dicionário = gerar_programa(diretorio_base, linguagem, importacao_liquido)
    var diretorio_gerado = arquivos.juntarCaminhos(diretorio_base, nome_diretorio_gerado)
    var caminho = arquivos.juntarCaminhos(diretorio_gerado, nome_programa_gerado)
    se (nao arquivos.criarDiretorio(diretorio_gerado) ou nao arquivos.escreverTexto(caminho, resultado["programa"])) {
        resultado["erros"].adicionar("Não foi possível escrever " + caminho + ".")
        resultado["caminho"] = ""
        retorna resultado
    }
    resultado["caminho"] = caminho
    retorna resultado
}
