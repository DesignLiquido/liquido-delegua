// Conversão automática dos arquivos FolEs de `estilos/` para CSS no diretório de estilos
// configurado (`liquido.estilos.diretorioBase`, padrão `publico/css`).
importar tudo como arquivos de "arquivos"
importar tudo como foles de "foles"
importar tudo como textos de "../utilidades/texto.delegua"

// Converte cada `estilos/*.foles`. Devolve { "escritos": [caminhos], "erros": [..] }.
funcao escrever_estilos(diretorio_base, diretorio_destino_relativo) {
    var escritos = []
    var erros = []
    var diretorio_estilos = arquivos.juntarCaminhos(diretorio_base, "estilos")
    se (nao arquivos.eDiretorio(diretorio_estilos)) {
        retorna { "escritos": escritos, "erros": erros }
    }
    var diretorio_destino = arquivos.juntarCaminhos(diretorio_base, diretorio_destino_relativo)
    se (nao arquivos.criarDiretorio(diretorio_destino)) {
        erros.adicionar("Não foi possível criar o diretório " + diretorio_destino + ".")
        retorna { "escritos": escritos, "erros": erros }
    }
    para cada nome_listado em arquivos.listarDiretorio(diretorio_estilos) {
        var nome = "" + nome_listado
        se (nao textos.termina_com(nome, ".foles")) { continua }
        var origem = arquivos.juntarCaminhos(diretorio_estilos, nome)
        var conteudo = arquivos.lerTexto(origem)
        se (conteudo == nulo) {
            erros.adicionar("Não foi possível ler " + origem + ".")
            continua
        }
        var css = ""
        var falhou = falso
        tente {
            css = foles.converter_texto_para_css(conteudo)
        } pegue (erro) {
            falhou = verdadeiro
            erros.adicionar("Erro no arquivo de estilo: " + origem + " — " + erro.mensagem + ". Pulando este arquivo.")
        }
        se (falhou) { continua }
        var destino = arquivos.juntarCaminhos(diretorio_destino, nome.subtexto(0, nome.tamanho() - 6) + ".css")
        se (arquivos.escreverTexto(destino, css)) {
            escritos.adicionar(destino)
        } senao {
            erros.adicionar("Não foi possível escrever " + destino + ".")
        }
    }
    retorna { "escritos": escritos, "erros": erros }
}
