importar { grupo, teste, afirmar } de "testes"

var textos = importar("../fontes/utilidades/texto.delegua")
var jsonLiquido = importar("../fontes/utilidades/json.delegua")

grupo("Utilidades de texto", funcao() {
    teste("substitui todas as ocorrências", funcao() {
        afirmar.igual("a-b-c", textos.substituirTodos("aXbXc", "X", "-"))
    })

    teste("prefixos e sufixos", funcao() {
        afirmar.verdadeiro(textos.comecaCom("/api/x", "/api"))
        afirmar.falso(textos.comecaCom("/a", "/api"))
        afirmar.verdadeiro(textos.terminaCom("x.delegua", ".delegua"))
        afirmar.falso(textos.terminaCom("x.pitu", ".delegua"))
    })

    teste("divide na primeira ocorrência", funcao() {
        var partes = textos.dividirPrimeira("chave=a=b", "=")
        afirmar.igual("chave", partes[0])
        afirmar.igual("a=b", partes[1])
        afirmar.igual(1, textos.dividirPrimeira("sem", "=").tamanho())
    })

    teste("remove acentos", funcao() {
        afirmar.igual("pitugues", textos.removerAcentos("pituguês"))
        afirmar.igual("Delegua", textos.removerAcentos("Delégua"))
    })

    teste("escapa HTML", funcao() {
        afirmar.igual("&lt;b&gt;&amp;&quot;", textos.escaparHtml("<b>&\""))
    })
})

grupo("JSON", funcao() {
    teste("serializa valores simples", funcao() {
        afirmar.igual("null", jsonLiquido.serializar(nulo))
        afirmar.igual("true", jsonLiquido.serializar(verdadeiro))
        afirmar.igual("1.5", jsonLiquido.serializar(1.5))
        var barra = "\\"
        var aspas = "\""
        afirmar.igual(aspas + "a" + barra + aspas + "b" + aspas, jsonLiquido.serializar("a" + aspas + "b"))
    })

    teste("serializa estruturas", funcao() {
        var valor = { "id": 1, "nomes": ["a", "b"], "vazio": {}, "nulo": nulo }
        afirmar.igual("{\"id\":1,\"nomes\":[\"a\",\"b\"],\"vazio\":{},\"nulo\":null}", jsonLiquido.serializar(valor))
        afirmar.igual("[]", jsonLiquido.serializar([]))
    })

    teste("analisa objetos e vetores", funcao() {
        var resultado = jsonLiquido.analisarJson(" { \"a\": [1, 2.5, -3], \"b\": { \"c\": \"ç\\n\" }, \"d\": true, \"e\": null } ")
        afirmar.igual("", resultado["erro"])
        var valor = resultado["resultado"]
        afirmar.igual(3, valor["a"].tamanho())
        afirmar.igual(2.5, valor["a"][1])
        afirmar.igual(-3, valor["a"][2])
        afirmar.igual("ç\n", valor["b"]["c"])
        afirmar.verdadeiro(valor["d"])
    })

    teste("ida e volta", funcao() {
        var original = "{\"x\":[{\"y\":\"z\"},false],\"n\":10}"
        afirmar.igual(original, jsonLiquido.serializar(jsonLiquido.analisarJson(original)["resultado"]))
    })

    teste("informa erros", funcao() {
        afirmar.diferente("", jsonLiquido.analisarJson("{\"a\": }")["erro"])
        afirmar.diferente("", jsonLiquido.analisarJson("[1, 2")["erro"])
        afirmar.diferente("", jsonLiquido.analisarJson("{} x")["erro"])
    })
})
