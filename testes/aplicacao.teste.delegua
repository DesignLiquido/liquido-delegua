importar { grupo, teste, afirmar } de "testes"
importar tudo como rede de "rede"

var nucleo = importar("../fontes/nucleo/aplicacao.delegua")
var jsonLiquido = importar("../fontes/utilidades/json.delegua")
var jwt = importar("../fontes/autenticacao/jwt.delegua")

var base = "testes/exemplos/aplicacao"

funcao requisicaoHttp(metodo, alvo, cabecalhos, corpo) {
    retorna { "metodo": metodo, "alvo": alvo, "versao": "HTTP/1.1", "cabecalhos": cabecalhos, "corpo": corpo }
}

funcao cabecalhoResposta(respostaHttp, nome) {
    para cada par em respostaHttp["cabecalhos"] {
        se (par[0].minusculo() == nome.minusculo()) { retorna par[1] }
    }
    retorna nulo
}

funcao criarAplicacaoTeste() {
    var aplicacao = nucleo.criarAplicacao(base)
    var raiz = aplicacao.registrador("/", "rotas/inicial.delegua")
    raiz.rotaGet(funcao(requisicao, resposta) {
        resposta.lmht({ "nome": "Mundo" })
    })
    raiz.rotaPost(funcao(requisicao, resposta) {
        resposta.json(requisicao.corpo).status(201)
    })

    var clientes = aplicacao.registrador("/api/clientes/:id", "rotas/api/clientes/[id].delegua")
    clientes.rotaGet(funcao(requisicao, resposta) {
        resposta.enviar("Teste com ID. ${requisicao.parametros.id}").status(200)
    })

    funcao autenticar(requisicao, resposta) {
        se (requisicao.parametrosPesquisa.contem("token") e requisicao.parametrosPesquisa["token"] == "invalido") {
            retorna resposta.enviar("Não autorizado").status(401)
        }
    }
    funcao adicionarCabecalho(requisicao, resposta) {
        resposta.cabecalho("X-Middleware", "sim").status(200)
    }
    var protegida = aplicacao.registrador("/protegida", "rotas/protegida.delegua")
    protegida.rotaGet(autenticar, adicionarCabecalho, funcao(requisicao, resposta) {
        resposta.enviar("Rota protegida")
    })
    protegida.rotaDelete(protegida.exigirAutenticacao(), funcao(requisicao, resposta) {
        resposta.json({ "usuario": requisicao.usuario["id"] })
    })

    var visoes = aplicacao.registrador("/clientes/:id", "rotas/clientes/[id].delegua")
    visoes.rotaGet(funcao(requisicao, resposta) {
        resposta.lmht({ "id": requisicao.parametros["id"] })
    })
    visoes.rotaPut(funcao(requisicao, resposta) {
        resposta.lmht("outra", {})
    })

    var diversos = aplicacao.registrador("/diversos", "rotas/diversos.delegua")
    diversos.rotaGet(funcao(requisicao, resposta) {
        resposta.redirecionar("/destino")
    })
    diversos.rotaPost(funcao(requisicao, resposta) {
        resposta.enviar("<?xml version=\"1.0\"?><raiz/>").cookie("sessao", "abc", { "somenteHttp": verdadeiro })
    })
    diversos.rotaPatch(funcao(requisicao, resposta) {
        var vetor = [1]
        resposta.enviar(vetor[5].algo)
    })
    diversos.rotaPut(funcao(requisicao, resposta) {
        resposta.status(204)
    })
    retorna aplicacao
}

var aplicacao = criarAplicacaoTeste()

grupo("Aplicação: rotas", funcao() {
    teste("carrega a configuração do projeto", funcao() {
        afirmar.verdadeiro(aplicacao.configuracaoEncontrada)
        afirmar.igual(0, aplicacao.errosConfiguracao.tamanho())
        afirmar.igual("mvc", aplicacao.configuracao["liquido"]["arquetipo"])
        afirmar.igual("segredo-de-teste", aplicacao.chaveSecreta)
    })

    teste("visão LMHT com valores", funcao() {
        var respostaHttp = aplicacao.processar(requisicaoHttp("GET", "/", {}, ""))
        afirmar.igual(200, respostaHttp["status"])
        afirmar.igual("text/html; charset=utf-8", cabecalhoResposta(respostaHttp, "content-type"))
        afirmar.verdadeiro(respostaHttp["corpo"].inclui("<h1>Olá, Mundo!</h1>"))
        afirmar.igual("nosniff", cabecalhoResposta(respostaHttp, "X-Content-Type-Options"))
    })

    teste("corpo JSON e status", funcao() {
        var cabecalhos = { "content-type": "application/json" }
        var respostaHttp = aplicacao.processar(requisicaoHttp("POST", "/", cabecalhos, "{\"a\": [1, 2]}"))
        afirmar.igual(201, respostaHttp["status"])
        afirmar.igual("{\"a\":[1,2]}", respostaHttp["corpo"])
        afirmar.igual("application/json; charset=utf-8", cabecalhoResposta(respostaHttp, "content-type"))
    })

    teste("JSON inválido é 400", funcao() {
        var cabecalhos = { "content-type": "application/json" }
        var respostaHttp = aplicacao.processar(requisicaoHttp("POST", "/", cabecalhos, "{x"))
        afirmar.igual(400, respostaHttp["status"])
    })

    teste("parâmetros de rota e interpolação", funcao() {
        var respostaHttp = aplicacao.processar(requisicaoHttp("GET", "/api/clientes/42", {}, ""))
        afirmar.igual(200, respostaHttp["status"])
        afirmar.igual("Teste com ID. 42", respostaHttp["corpo"])
        afirmar.igual("text/plain; charset=utf-8", cabecalhoResposta(respostaHttp, "content-type"))
    })

    teste("visões detalhes.lmht e com nome", funcao() {
        var detalhes = aplicacao.processar(requisicaoHttp("GET", "/clientes/7", {}, ""))
        afirmar.verdadeiro(detalhes["corpo"].inclui("<p>Cliente 7</p>"))
        var outra = aplicacao.processar(requisicaoHttp("PUT", "/clientes/7", {}, ""))
        afirmar.verdadeiro(outra["corpo"].inclui("<p>Outra visão</p>"))
    })

    teste("middlewares: continuam ou interrompem a cadeia", funcao() {
        var continuou = aplicacao.processar(requisicaoHttp("GET", "/protegida", {}, ""))
        afirmar.igual(200, continuou["status"])
        afirmar.igual("Rota protegida", continuou["corpo"])
        afirmar.igual("sim", cabecalhoResposta(continuou, "X-Middleware"))
        var interrompe = aplicacao.processar(requisicaoHttp("GET", "/protegida?token=invalido", {}, ""))
        afirmar.igual(401, interrompe["status"])
        afirmar.igual("Não autorizado", interrompe["corpo"])
    })

    teste("redirecionamento, XML, cookies, 204 e HEAD", funcao() {
        var redirecionado = aplicacao.processar(requisicaoHttp("GET", "/diversos", {}, ""))
        afirmar.igual(302, redirecionado["status"])
        afirmar.igual("/destino", cabecalhoResposta(redirecionado, "location"))
        var xml = aplicacao.processar(requisicaoHttp("POST", "/diversos", {}, ""))
        afirmar.igual("application/xml; charset=utf-8", cabecalhoResposta(xml, "content-type"))
        afirmar.igual("sessao=abc; Path=/; HttpOnly", cabecalhoResposta(xml, "set-cookie"))
        var vazio = aplicacao.processar(requisicaoHttp("PUT", "/diversos", {}, ""))
        afirmar.igual(204, vazio["status"])
        var cabeca = aplicacao.processar(requisicaoHttp("HEAD", "/api/clientes/1", {}, ""))
        afirmar.igual(200, cabeca["status"])
        afirmar.falso(cabeca["incluirCorpo"])
    })

    teste("erro na rota é 500 com página de erro (mvc)", funcao() {
        var respostaHttp = aplicacao.processar(requisicaoHttp("PATCH", "/diversos", {}, ""))
        afirmar.igual(500, respostaHttp["status"])
        afirmar.verdadeiro(respostaHttp["corpo"].inclui("Ocorreu um erro"))
        afirmar.verdadeiro(respostaHttp["corpo"].inclui("rotas/diversos.delegua"))
    })

    teste("404 e 405", funcao() {
        var cabecalhosJson = { "accept": "application/json" }
        var naoEncontrada = aplicacao.processar(requisicaoHttp("GET", "/nao/existe", cabecalhosJson, ""))
        afirmar.igual(404, naoEncontrada["status"])
        afirmar.verdadeiro(naoEncontrada["corpo"].inclui("Rota não encontrada"))
        var pagina = aplicacao.processar(requisicaoHttp("GET", "/nao/existe?<script>", { "accept": "text/html" }, ""))
        afirmar.verdadeiro(pagina["corpo"].inclui("Página não encontrada"))
        var naoPermitido = aplicacao.processar(requisicaoHttp("DELETE", "/api/clientes/1", {}, ""))
        afirmar.igual(405, naoPermitido["status"])
        afirmar.verdadeiro(cabecalhoResposta(naoPermitido, "allow").inclui("GET"))
    })
})

grupo("Aplicação: estáticos, CORS e documentação", funcao() {
    teste("arquivos estáticos de texto e binários", funcao() {
        var css = aplicacao.processar(requisicaoHttp("GET", "/css/estilo.css", {}, ""))
        afirmar.igual(200, css["status"])
        afirmar.igual("text/css; charset=utf-8", cabecalhoResposta(css, "content-type"))
        afirmar.verdadeiro(css["corpo"].inclui("color: red"))
        var pagina = aplicacao.processar(requisicaoHttp("GET", "/pagina", {}, ""))
        afirmar.verdadeiro(pagina["corpo"].inclui("<h1>Olá</h1>"))
        var imagem = aplicacao.processar(requisicaoHttp("GET", "/imagem.png", {}, ""))
        afirmar.igual("image/png", cabecalhoResposta(imagem, "content-type"))
        afirmar.verdadeiro(imagem["arquivo"] != nulo)
        var travessia = aplicacao.processar(requisicaoHttp("GET", "/../configuracao.delprops", {}, ""))
        afirmar.diferente(200, travessia["status"])
    })

    teste("CORS com origens configuradas e pré-verificação", funcao() {
        var permitida = aplicacao.processar(requisicaoHttp("GET", "/api/clientes/1", { "origin": "https://admin.exemplo.com.br" }, ""))
        afirmar.igual("https://admin.exemplo.com.br", cabecalhoResposta(permitida, "access-control-allow-origin"))
        var negada = aplicacao.processar(requisicaoHttp("GET", "/api/clientes/1", { "origin": "https://outro.com" }, ""))
        afirmar.igual(nulo, cabecalhoResposta(negada, "access-control-allow-origin"))
        var cabecalhosPre = { "origin": "https://exemplo.com.br", "access-control-request-method": "POST" }
        var preverificacao = aplicacao.processar(requisicaoHttp("OPTIONS", "/", cabecalhosPre, ""))
        afirmar.igual(204, preverificacao["status"])
        afirmar.verdadeiro(cabecalhoResposta(preverificacao, "access-control-allow-methods").inclui("POST"))
    })

    teste("documentação OpenAPI", funcao() {
        aplicacao.documentarRota("rotaGet", "/api/clientes/:id", "{\"documentacao\": {\"sumario\": \"Obtém cliente\", \"etiquetas\": [\"clientes\"]}, \"respostas\": [{\"codigo\": 200, \"descricao\": \"Encontrado\", \"formatos\": [\"text/plain\"]}]}")
        var respostaHttp = aplicacao.processar(requisicaoHttp("GET", "/docs/openapi.json", {}, ""))
        afirmar.igual(200, respostaHttp["status"])
        var documento = jsonLiquido.analisarJson(respostaHttp["corpo"])["resultado"]
        afirmar.igual("3.0.0", documento["openapi"])
        afirmar.igual("Aplicação de teste", documento["info"]["title"])
        var operacao = documento["paths"]["/api/clientes/{id}"]["get"]
        afirmar.igual("Obtém cliente", operacao["summary"])
        afirmar.igual("Encontrado", operacao["responses"]["200"]["description"])
        afirmar.igual("id", operacao["parameters"][0]["name"])
        var pagina = aplicacao.processar(requisicaoHttp("GET", "/docs", {}, ""))
        afirmar.verdadeiro(pagina["corpo"].inclui("Redoc.init"))
    })
})

grupo("Aplicação: autenticação JWT", funcao() {
    teste("JWT compatível com o exemplo da RFC/jwt.io", funcao() {
        var conteudo = { "sub": "1234567890", "name": "John Doe", "iat": 1516239022 }
        var token = jwt.codificarToken(conteudo, "your-256-bit-secret")
        afirmar.igual("eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyfQ.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c", token)
        afirmar.verdadeiro(jwt.decodificarToken(token, "your-256-bit-secret")["valido"])
        afirmar.falso(jwt.decodificarToken(token, "outra-chave")["valido"])
        var expirado = { "exp": 1 }
        afirmar.falso(jwt.decodificarToken(jwt.codificarToken(expirado, "k"), "k")["valido"])
    })

    teste("/token emite token e rotas reconhecem o usuário", funcao() {
        var cabecalhos = { "content-type": "application/json" }
        var recusado = aplicacao.processar(requisicaoHttp("POST", "/token", cabecalhos, "{\"email\": \"ana@exemplo.com\", \"senha\": \"errada\"}"))
        afirmar.igual(401, recusado["status"])
        var emitido = aplicacao.processar(requisicaoHttp("POST", "/token", cabecalhos, "{\"email\": \"ana@exemplo.com\", \"senha\": \"senha-ana\"}"))
        afirmar.igual(200, emitido["status"])
        var token = jsonLiquido.analisarJson(emitido["corpo"])["resultado"]["token"]

        var semToken = aplicacao.processar(requisicaoHttp("DELETE", "/protegida", {}, ""))
        afirmar.igual(401, semToken["status"])
        var comToken = aplicacao.processar(requisicaoHttp("DELETE", "/protegida", { "authorization": "Bearer " + token }, ""))
        afirmar.igual(200, comToken["status"])
        afirmar.igual("{\"usuario\":1}", comToken["corpo"])
    })
})

grupo("Aplicação: servidor HTTP", funcao() {
    teste("atende uma requisição real pelo módulo rede", funcao() {
        var servidor = rede.escutar("127.0.0.1", 0)
        var porta = rede.portaLocal(servidor)
        var cliente = rede.conectar("127.0.0.1", porta, 2000)
        rede.escrever(cliente, "POST / HTTP/1.1\r\nHost: localhost\r\nContent-Type: application/json\r\nContent-Length: 15\r\n\r\n{\"nome\":\"çã\"}")
        afirmar.verdadeiro(aplicacao.atenderUma(servidor, 2000))
        var respostaTexto = rede.lerAte(cliente, "", 1000000, 2000)
        afirmar.verdadeiro(respostaTexto.inclui("HTTP/1.1 201 Created\r\n"))
        afirmar.verdadeiro(respostaTexto.inclui("Content-Length: 15\r\n"))
        afirmar.verdadeiro(respostaTexto.terminaCom("{\"nome\":\"çã\"}"))
        rede.fechar(cliente)
        rede.fechar(servidor)
    })

    teste("requisição malformada recebe 400", funcao() {
        var servidor = rede.escutar("127.0.0.1", 0)
        var porta = rede.portaLocal(servidor)
        var cliente = rede.conectar("127.0.0.1", porta, 2000)
        rede.escrever(cliente, "LIXO\r\n\r\n")
        aplicacao.atenderUma(servidor, 2000)
        var respostaTexto = rede.lerAte(cliente, "", 1000000, 2000)
        afirmar.verdadeiro(respostaTexto.inclui("HTTP/1.1 400 Bad Request"))
        rede.fechar(cliente)
        rede.fechar(servidor)
    })
})
