importar { grupo, teste, afirmar } de "testes"

var url = importar("../fontes/http/url.delegua")
var mensagens = importar("../fontes/http/mensagens_http.delegua")
var cookies = importar("../fontes/http/cookies.delegua")
var mime = importar("../fontes/http/tipos_mime.delegua")
var roteamento = importar("../fontes/roteador/roteador.delegua")

funcao textosTerminam(conteudo, sufixo) {
    retorna conteudo.terminaCom(sufixo)
}

grupo("URL", funcao() {
    teste("separa caminho e consulta", funcao() {
        var partes = url.separarAlvo("/api/x?a=1&b=2#frag")
        afirmar.igual("/api/x", partes["caminho"])
        afirmar.igual("a=1&b=2", partes["consulta"])
    })

    teste("analisa parâmetros de pesquisa", funcao() {
        var consulta = url.analisarConsulta("nome=Jo%C3%A3o+Silva&vazio=&lista=1&lista=2")
        afirmar.igual("João Silva", consulta["nome"])
        afirmar.igual("", consulta["vazio"])
        afirmar.igual(2, consulta["lista"].tamanho())
    })

    teste("normaliza caminhos", funcao() {
        afirmar.igual("/", url.normalizarCaminho(""))
        afirmar.igual("/a/b", url.normalizarCaminho("//a/b/"))
    })

    teste("recusa travessia de diretórios", funcao() {
        afirmar.igual(nulo, url.segmentosCaminho("/a/../b"))
        afirmar.igual(nulo, url.segmentosCaminho("/a/%2e%2e/b"))
        afirmar.igual(2, url.segmentosCaminho("/a/b").tamanho())
    })
})

grupo("Mensagens HTTP", funcao() {
    teste("analisa cabeçalho de requisição", funcao() {
        var dados = mensagens.analisarCabecalhoRequisicao("POST /api?x=1 HTTP/1.1\r\nHost: localhost\r\nContent-Type: application/json\r\nX-A: 1\r\nX-A: 2\r\n\r\n")
        afirmar.igual("", dados["erro"])
        afirmar.igual("POST", dados["metodo"])
        afirmar.igual("/api?x=1", dados["alvo"])
        afirmar.igual("application/json", dados["cabecalhos"]["content-type"])
        afirmar.igual("1, 2", dados["cabecalhos"]["x-a"])
    })

    teste("recusa linha inválida", funcao() {
        afirmar.diferente("", mensagens.analisarCabecalhoRequisicao("lixo\r\n\r\n")["erro"])
        afirmar.diferente("", mensagens.analisarCabecalhoRequisicao("")["erro"])
    })

    teste("calcula tamanho em bytes UTF-8", funcao() {
        afirmar.igual(0, mensagens.tamanhoEmBytes(""))
        afirmar.igual(3, mensagens.tamanhoEmBytes("abc"))
        afirmar.igual(4, mensagens.tamanhoEmBytes("olá"))
        afirmar.igual(6, mensagens.tamanhoEmBytes("ação"))
    })

    teste("monta resposta", funcao() {
        var cabecalhos = [["Content-Type", "text/plain; charset=utf-8"]]
        var resposta = mensagens.montarResposta(200, cabecalhos, "olá", verdadeiro)
        afirmar.verdadeiro(resposta.inclui("HTTP/1.1 200 OK\r\n"))
        afirmar.verdadeiro(resposta.inclui("Content-Length: 4\r\n"))
        afirmar.verdadeiro(textosTerminam(resposta, "\r\n\r\nolá"))
    })

    teste("respostas 204 e HEAD não têm corpo", funcao() {
        var semCabecalhos = []
        var resposta = mensagens.montarResposta(204, semCabecalhos, "x", verdadeiro)
        afirmar.falso(resposta.inclui("Content-Length"))
        afirmar.verdadeiro(textosTerminam(resposta, "\r\n\r\n"))
        var cabeca = mensagens.montarResposta(200, semCabecalhos, "abc", falso)
        afirmar.verdadeiro(cabeca.inclui("Content-Length: 3"))
        afirmar.verdadeiro(textosTerminam(cabeca, "\r\n\r\n"))
    })
})

grupo("Cookies e tipos", funcao() {
    teste("analisa cookies", funcao() {
        var lidos = cookies.analisarCookies("sessao=abc; tema=\"escuro\"; nome=Jo%C3%A3o")
        afirmar.igual("abc", lidos["sessao"])
        afirmar.igual("escuro", lidos["tema"])
        afirmar.igual("João", lidos["nome"])
    })

    teste("monta Set-Cookie", funcao() {
        var opcoes = { "somenteHttp": verdadeiro, "idadeMaxima": 60, "mesmoSitio": "Lax" }
        afirmar.igual("a=b%20c; Path=/; Max-Age=60; HttpOnly; SameSite=Lax", cookies.montarSetCookie("a", "b c", opcoes))
    })

    teste("tipos MIME", funcao() {
        afirmar.igual("text/css; charset=utf-8", mime.tipoPorCaminho("publico/css/a.css"))
        afirmar.igual("image/png", mime.tipoPorCaminho("x/Y.PNG"))
        afirmar.igual("application/octet-stream", mime.tipoPorCaminho("x/sem-extensao"))
        afirmar.verdadeiro(mime.ehTexto("a.html"))
        afirmar.falso(mime.ehTexto("a.png"))
    })
})

grupo("Roteador", funcao() {
    teste("resolve rotas estáticas e com parâmetros", funcao() {
        var roteador = roteamento.criarRoteador()
        var funcoes = ["f"]
        roteador.registrar("GET", "/", funcoes, "rotas/inicial.delegua")
        roteador.registrar("GET", "/api/clientes/:id", funcoes, "rotas/api/clientes/[id].delegua")
        roteador.registrar("GET", "/api/clientes/novo", funcoes, "rotas/api/clientes/novo.delegua")
        roteador.registrar("POST", "/api/clientes/:id", funcoes, "rotas/api/clientes/[id].delegua")

        var raiz = roteador.resolver("GET", "/")
        afirmar.igual("encontrada", raiz["situacao"])

        var cliente = roteador.resolver("GET", "/api/clientes/42/")
        afirmar.igual("encontrada", cliente["situacao"])
        afirmar.igual("42", cliente["parametros"]["id"])

        var novo = roteador.resolver("GET", "/api/clientes/novo")
        afirmar.igual("/api/clientes/novo", novo["rota"]["caminho"])
    })

    teste("método não permitido e não encontrada", funcao() {
        var roteador = roteamento.criarRoteador()
        var funcoes = ["f"]
        roteador.registrar("GET", "/x", funcoes, "")
        roteador.registrar("POST", "/x", funcoes, "")
        var resultado = roteador.resolver("DELETE", "/x")
        afirmar.igual("metodoNaoPermitido", resultado["situacao"])
        afirmar.verdadeiro(resultado["metodos"].inclui("GET"))
        afirmar.verdadeiro(resultado["metodos"].inclui("POST"))
        afirmar.igual("naoEncontrada", roteador.resolver("GET", "/y")["situacao"])
    })

    teste("HEAD usa GET e duplicatas são recusadas", funcao() {
        var roteador = roteamento.criarRoteador()
        var funcoes = ["f"]
        afirmar.verdadeiro(roteador.registrar("GET", "/x", funcoes, ""))
        afirmar.falso(roteador.registrar("get", "/x/", funcoes, ""))
        afirmar.igual("encontrada", roteador.resolver("HEAD", "/x")["situacao"])
    })

    teste("nomes de métodos de registro", funcao() {
        afirmar.igual("GET", roteamento.metodoDeRegistro("rotaGet"))
        afirmar.igual("PROPFIND", roteamento.metodoDeRegistro("rotaPropfind"))
        afirmar.igual("", roteamento.metodoDeRegistro("rotaInexistente"))
    })
})
